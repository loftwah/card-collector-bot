# Local Worker secrets. Generated by pnpm setup:local into .dev.vars (mode 600).
FOILBURY_LOCAL_MODE=true
# Explicit, loopback-only development convenience. Set false to revoke.
FOILBURY_DEV_LOGIN=true
FOILBURY_SESSION_SECRET=
FOILBURY_CSRF_SECRET=
FOILBURY_BOOTSTRAP_TOKEN=
FOILBURY_AGENT_TOKEN_PEPPER=
EMDASH_ENCRYPTION_KEY=
EMDASH_SITE_URL=http://127.0.0.1:4321
