{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "foilbury-local",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foilbury-local",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "foilbury-media-local"
    }
  ],
  "vars": {
    "FOILBURY_ENV": "local",
    "FOILBURY_PUBLIC_ORIGIN": "http://127.0.0.1:4321",
    "FOILBURY_TENANT_SLUG": "cabinet",
    "EMDASH_SITE_URL": "http://127.0.0.1:4321"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": false
  }
}
