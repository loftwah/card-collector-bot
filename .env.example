# Deployment credentials. Used only by explicit operator scripts, never loaded as Worker bindings.
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Optional S3-compatible access to R2 for external asset tooling only.
CF_ACCESS_KEY_ID=
CF_SECRET_ACCESS_KEY=
CF_S3_API_ENDPOINT=
# Optional providers. Left blank for core local use.
FAL_AI_API_KEY=
ELEVENLABS_API_KEY=
RESEND_API_KEY=
RESEND_FROM_ADDRESS=foilbury@loftwah.com
# Outgoing owner notification destination. Not a bot token or login method.
ADMIN_DISCORD_WEBHOOK_URL=
# Backwards-compatible migration alias, read only when ADMIN_DISCORD_WEBHOOK_URL is empty.
DISCORD_WEBHOOK_URL=
# Discord is disabled and unconnected in this build.
DISCORD_ENABLED=false
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_TEST_GUILD_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# Discord (application ID and public key are not secrets; bot token and OAuth secret are).
# The HTTP interactions endpoint does not need the bot token at runtime.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://foilbury.loftwah.com/api/v1/auth/discord/callback
DISCORD_TEST_GUILD_ID=
DISCORD_TEST_CHANNEL_ID=
