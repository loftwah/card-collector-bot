    "check": "pnpm check:types && pnpm test",
    "check:types": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.workers.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:agent": "node scripts/test-agent.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "doctor": "node scripts/doctor.mjs",
    "db:migrate:local": "node scripts/migrate-local.mjs",
    "db:seed:local": "node scripts/seed-local.mjs",
