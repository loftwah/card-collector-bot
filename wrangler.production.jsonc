{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "foilbury",
  "main": "dist/server/entry.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foilbury",
      "database_id": "b67bb3d4-ace6-43f1-821a-f5620936bd3c",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "foilbury-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "f787803f3672485cb5c0b1a286066a4f"
    }
  ],
  "vars": {
    "FOILBURY_ENV": "production",
    "FOILBURY_PUBLIC_ORIGIN": "https://foilbury.loftwah.com",
    "FOILBURY_TENANT_SLUG": "cabinet",
    "EMDASH_SITE_URL": "https://foilbury.loftwah.com"
  },
  "routes": [
    {
      "pattern": "foilbury.loftwah.com",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
