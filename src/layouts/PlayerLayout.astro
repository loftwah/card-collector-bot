---
import BaseLayout from "./BaseLayout.astro";
const session = Astro.locals.foilbury;
const user = session?.user;
interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: "/play", label: "Overview" },
  { href: "/play/collections", label: "Worlds" },
  { href: "/play/collection", label: "My cards" },
  { href: "/play/draw", label: "Draw room" },
  { href: "/play/rewards", label: "Rewards" },
  { href: "/play/achievements", label: "Achievements" },
  { href: "/play/profile", label: "Showcase" },
  { href: "/play/gifts", label: "Gifts" },
  { href: "/play/trades", label: "Trades & gifts" },
  { href: "/play/preferences", label: "Preferences" },
  { href: "/tour", label: "Tour" },
  { href: "/account/security", label: "Security" },
];
---
<BaseLayout title={title ?? `${user?.displayName ?? "Player"} · Foilbury`} description={description ?? "Your Foilbury album: collection, Foil balance, capsules, achievements and gifts."} noIndex>
  <section class="border-b border-[var(--line)] bg-[var(--paper-2)]/50">
    <div class="container py-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="display-sm text-3xl md:text-4xl">{user?.displayName ?? "Collector"}</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <a class="btn btn-secondary btn-sm" href="/cabinet">Public catalogue</a>
          <a class="btn btn-secondary btn-sm" href="/play/preferences">Preferences</a>
        </div>
      </div>
      <nav class="cabinet-tabs mt-5 flex gap-1 overflow-x-auto border-b border-[var(--line)] pb-1" aria-label="Cabinet sections">
        {links.map((link) => {
          const active = path === link.href || (link.href !== "/play" && path.startsWith(link.href + "/"));
          return (
            <a
              href={link.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "shrink-0 border-b-2 px-3 py-2.5 font-mono text-[0.65rem] uppercase tracking-[0.1em] no-underline transition-colors",
                active
                  ? "border-[var(--brass)] text-[var(--ink)]"
                  : "border-transparent text-[var(--muted)] hover:text-[var(--ink)]",
              ]}
            >
              {link.label}
            </a>
          );
        })}
      </nav>
    </div>
  </section>
  <section class="container py-8 md:py-10">
    <slot />
  </section>
</BaseLayout>
