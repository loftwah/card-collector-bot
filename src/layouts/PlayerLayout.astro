---
import BaseLayout from "./BaseLayout.astro";
import ThemeToggle from "../components/ThemeToggle";
import { playerPrimary, playerMore } from "../lib/player-navigation";
import CardViewer from "../components/cards/CardViewer";
import { accountAvatarViewFor } from "../server/modules/account-avatar";

const session = Astro.locals.foilbury;
const user = session?.user;
const path = Astro.url.pathname;

interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;

const more = [
  { href: "/find", label: "Find a page" },
  ...playerMore,
  { href: "/logout", label: "Sign out" },
];

const isActive = (href: string) =>
  href === "/play" ? path === href : path === href || path.startsWith(href + "/");

const collectionsActive =
  path.startsWith("/play/collections") ||
  path.startsWith("/play/collection") ||
  path.startsWith("/play/wishlist");
const tradesActive = path.startsWith("/play/trades") || path.startsWith("/play/rivals");
const profileActive =
  path.startsWith("/play/profile") ||
  path.startsWith("/play/preferences") ||
  path.startsWith("/account/security");

const primaryActive = (href: string) =>
  href === "/play/collections"
    ? collectionsActive
    : href === "/play/trades"
      ? tradesActive
      : href === "/play/profile"
        ? profileActive
        : isActive(href);

const moreActive = more.some((link) => isActive(link.href));
const avatar = user ? accountAvatarViewFor(user) : null;
---

<BaseLayout
  title={title ?? `${user?.displayName ?? "Player"} · Foilbury`}
  description={
    description ??
    "Your Foilbury library: collection, Foil balance, capsules, achievements and gifts."
  }
  noIndex
  shell="player"
>
  <Fragment slot="shell">
    <header class="player-shell">
      <div class="container player-top">
        <a class="player-brand" href="/play">
          <span class="player-wordmark">Foilbury</span>
          <span class="player-bot">
            {session?.tenantName ?? session?.tenantSlug ?? "Your library"}
          </span>
        </a>

        <div class="player-actions">
          <a class="player-balance" href="/play" title="Your Foil balance">
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <circle cx="10" cy="10" r="7.25" stroke="currentColor" stroke-width="1.5"></circle>
              <path
                d="M10 5.8v8.4M12.6 7.4c-.55-.8-1.45-1.2-2.55-1.2-1.35 0-2.3.7-2.3 1.8 0 1 .8 1.5 2.3 1.8 1.55.3 2.4.8 2.4 1.95 0 1.15-1 1.85-2.4 1.85-1.15 0-2.1-.45-2.65-1.25"
                stroke="currentColor"
                stroke-width="1.25"
                stroke-linecap="round"
              ></path>
            </svg>
            <span data-foil-balance>{session?.wallet ?? 0} Foil</span>
          </a>
          <a
            class="player-avatar"
            href="/play/profile"
            aria-label={`${user?.displayName ?? "Your"} profile`}
          >
            {avatar ? (
              <img
                src={avatar.src}
                srcset={avatar.srcSet ?? undefined}
                sizes="32px"
                alt=""
                width="32"
                height="32"
                data-avatar-img
                data-fallback-src="/avatars/default/keeper-256.png"
              />
            ) : null}
          </a>
          <ThemeToggle client:load />
        </div>
      </div>

      <div class="container">
        <nav class="player-nav" aria-label="Player">
          {playerPrimary.map((link) => (
            <a
              href={link.href}
              aria-current={primaryActive(link.href) ? "page" : undefined}
              class:list={["player-link", primaryActive(link.href) && "is-active"]}
            >
              {link.label}
            </a>
          ))}
          <details class="player-more">
            <summary
              class:list={["player-more__summary", moreActive && "is-active"]}
              aria-label="More player destinations"
            >
              More <span aria-hidden="true">▾</span>
            </summary>
            <div class="player-more__menu">
              {more.map((link) => (
                <a
                  href={link.href}
                  aria-current={isActive(link.href) ? "page" : undefined}
                  class:list={["player-more__link", isActive(link.href) && "is-active"]}
                >
                  {link.label}
                </a>
              ))}
            </div>
          </details>
        </nav>
      </div>
    </header>
  </Fragment>

  <section class="player-content container">
    <slot />
  </section>
  <CardViewer client:load />
</BaseLayout>

<script>
  import "../scripts/card-viewer";

  // A missing remote collection banner reveals the designed mark tile instead
  // of a broken-image glyph. The fallback is authored, not a blank box.
  document.addEventListener(
    "error",
    (event) => {
      const image = event.target;
      if (image instanceof HTMLImageElement && image.hasAttribute("data-hide-on-error")) {
        image.style.visibility = "hidden";
      }
    },
    true,
  );

  document.addEventListener("click", (event) => {
    document
      .querySelectorAll<HTMLDetailsElement>("details.player-more[open]")
      .forEach((details) => {
        if (event.target instanceof Node && !details.contains(event.target)) details.open = false;
      });
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    document
      .querySelectorAll<HTMLDetailsElement>("details.player-more[open]")
      .forEach((details) => {
        const returnFocus = details.contains(document.activeElement);
        details.open = false;
        if (returnFocus) details.querySelector<HTMLElement>("summary")?.focus();
      });
  });
</script>
