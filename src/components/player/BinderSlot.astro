---
import { CARD_STYLE_LABEL } from "../../lib/card-styles";
interface BinderCard {
  id: string;
  name: string;
  subtitle: string | null;
  owned: boolean;
  copies: number;
  finishes: string[];
  render_url: string | null;
  thumbnail_url: string | null;
  back_render_url?: string | null;
  style_key?: string | null;
  instance_id: string | null;
}

interface Props {
  card: BinderCard;
  finishLabels: Record<string, string>;
  theme?: string | null;
  collection?: string | null;
  audience?: string | null;
}

const { card, finishLabels, theme = null, collection = null, audience = null } = Astro.props;
const finishLabel = (key: string) => finishLabels[key] ?? key;
const imageUrl = card.render_url ?? card.thumbnail_url;
const styleLabel = card.style_key ? (CARD_STYLE_LABEL[card.style_key] ?? card.style_key) : null;
const facts = {
  id: card.instance_id ?? card.id,
  name: card.name,
  subtitle: card.subtitle,
  collection,
  styleKey: card.style_key ?? null,
  finish: card.finishes.map(finishLabel).join(", ") || null,
  method: null,
  status: card.owned ? "Owned" : "Missing",
  width: 750,
  height: 1050,
  audience,
  provenance: styleLabel ? `${styleLabel} direction` : null,
  front: imageUrl,
  back: card.back_render_url ?? null,
  href: card.instance_id ? `/play/card/${card.instance_id}` : null,
};
---

<article
  class:list={["binder-slot", theme && `binder-slot--${theme}`]}
  data-theme={theme ?? undefined}
  data-owned={card.owned ? "true" : "false"}
>
  <div class="binder-slot__object">
    {card.owned && imageUrl ? (
      <button
        type="button"
        class="card-trigger binder-slot__trigger"
        data-card-facts={JSON.stringify(facts)}
        aria-label={`Open ${card.name} full size`}
      >
        <img
          src={imageUrl}
          alt=""
          width="300"
          height="420"
          loading="lazy"
          class="binder-slot__render"
        />
      </button>
    ) : (
      <div class="binder-slot__missing">
        <span class="binder-slot__missing-mark" aria-hidden="true">
          +
        </span>
        <span>{card.owned ? "Render unavailable" : "Missing"}</span>
      </div>
    )}
  </div>
  <div class="binder-slot__body">
    <p class="binder-slot__name">{card.name}</p>
    <p class="binder-slot__meta">
      {card.owned
        ? `${card.copies} cop${card.copies === 1 ? "y" : "ies"}${
            card.finishes.length ? ` · ${card.finishes.map(finishLabel).join(", ")}` : ""
          }`
        : "Not yet collected"}
    </p>
  </div>
</article>
