---
import BrandMark from "./BrandMark.astro";
const year = new Date().getFullYear();
const local = Astro.locals.foilbury;
---

<footer class="site-footer">
  <div class="container grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <div class="flex items-center gap-2.5">
        <BrandMark size={24} class="text-[var(--ink)]" />
        <span class="display-sm text-lg">Foilbury</span>
      </div>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-[var(--muted)]">
        A collector's cabinet for characters worth keeping. Free to play, earned Foil only, and a
        copy that stays yours.
      </p>
      <p class="mt-4 font-mono text-[0.62rem] uppercase tracking-[0.14em] text-[var(--brass)]">
        {local ? "Local cabinet · private by default" : "A local-first collection game"}
      </p>
    </div>
    <div>
      <p class="mb-3 text-sm font-semibold text-[var(--ink)]">The cabinet</p>
      <ul class="grid gap-2 text-sm">
        <li>
          <a href="/cabinet">Public catalogue</a>
        </li>
        <li>
          <a href="/tour">Guided tour</a>
        </li>
        <li>
          <a href="/showcase">Social images &amp; videos</a>
        </li>
        <li>
          <a href="/brand-kit">Media kit</a>
        </li>
        <li>
          <a href="/find">Find a page</a>
        </li>
        <li>
          <a href="/journal">Journal</a>
        </li>
        <li>
          <a href="/play">Your collection</a>
        </li>
        <li>
          <a href="/play/draw">Draw room</a>
        </li>
      </ul>
    </div>
    <div>
      <p class="mb-3 text-sm font-semibold text-[var(--ink)]">For creators & agents</p>
      <ul class="grid gap-2 text-sm">
        <li>
          <a href="/docs/agent-guide">Agent guide</a>
        </li>
        <li>
          <a href="/openapi.json">OpenAPI</a>
        </li>
        <li>
          <a href="/create-bot">Create a Bot</a>
        </li>
        <li>
          <a href="/account/security">Account security</a>
        </li>
      </ul>
    </div>
  </div>
  <div class="container flex flex-wrap items-center justify-between gap-3 border-t border-[var(--line)] py-5">
    <p class="text-balance font-mono text-[0.6875rem] uppercase tracking-[0.14em] text-[var(--muted)]">
      © {year} Foilbury · Australian English · Melbourne time
    </p>
    <p class="text-balance font-mono text-[0.6875rem] uppercase tracking-[0.14em] text-[var(--muted)]">
      Earned currency only · no purchase · no cash-out
    </p>
  </div>
</footer>
