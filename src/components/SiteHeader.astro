---
import ThemeToggle from "./ThemeToggle";
import LogoutButton from "./LogoutButton";
const session = Astro.locals.foilbury;
const user = session?.user ?? null;
const path = Astro.url.pathname;
const links = [
  { href: "/cabinet", label: "The Cabinet" },
  { href: "/tour", label: "Tour" },
  { href: "/journal", label: "Journal" },
  { href: "/play/draw", label: "Draw" },
];
if (user) links.push({ href: "/play", label: "My Collection" });
const canStudio = Boolean(
  user &&
  (user.platformAdmin ||
    user.globalCollectionScope ||
    ["owner", "editor", "economy_admin"].includes(user.role)),
);
if (canStudio) links.push({ href: "/studio", label: "Studio" });
if (user?.platformAdmin) links.push({ href: "/platform-admin", label: "Platform" });
---

<header class="site-header">
  <div class="container flex min-h-[68px] items-center justify-between gap-4 py-3">
    <a href="/" class="flex items-center gap-2.5 no-underline" aria-label="Foilbury home">
      <img src="/brand/mark.png" alt="" width="30" height="30" class="h-[30px] w-[30px]" />
      <span class="font-display text-[1.35rem] tracking-[-0.03em]">Foilbury</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            "border-b-2 px-3 py-2 font-mono text-[0.66rem] uppercase tracking-[0.1em] no-underline transition-colors",
            (
              link.href === "/play/draw"
                ? path.startsWith("/play/draw")
                : link.href === "/play"
                  ? path.startsWith("/play") && !path.startsWith("/play/draw")
                  : path === link.href || path.startsWith(link.href + "/")
            )
              ? "border-[var(--signal)] text-[var(--ink)]"
              : "border-transparent text-[var(--muted)] hover:text-[var(--ink)]",
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-1.5">
      {user ? (
        <>
          <a
            href="/play"
            class="hidden items-center gap-2 rounded-[2px] border border-[var(--line)] bg-[var(--panel-2)] px-2.5 py-1.5 font-mono text-[0.64rem] uppercase tracking-[0.08em] no-underline sm:flex"
            title="Your Foil balance"
          >
            <span class="text-[var(--signal)]">✦</span>
            <span data-foil-balance>{session?.wallet ?? 0} Foil</span>
          </a>
          <a
            href="/account/security"
            class="hidden max-w-32 truncate text-xs text-[var(--muted)] hover:text-[var(--ink)] lg:inline"
          >
            {user.displayName}
          </a>
          {!["owner", "editor", "economy_admin"].includes(user.role) ? (
            <a class="btn btn-secondary btn-sm hidden sm:inline-flex" href="/create-bot">
              Create a Bot
            </a>
          ) : null}{" "}
          <LogoutButton client:load />
        </>
      ) : (
        <a class="btn btn-primary btn-sm" href="/login">
          Sign in
        </a>
      )}
      <ThemeToggle client:load />
      <details class="relative md:hidden">
        <summary class="btn btn-ghost btn-sm cursor-pointer list-none" aria-label="Menu">
          Menu
        </summary>
        <div class="absolute right-0 top-11 z-30 min-w-52 border border-[var(--line-strong)] bg-[var(--paper)] p-2 shadow-xl">
          {links.map((link) => (
            <a
              class="block px-3 py-2 font-mono text-[0.68rem] uppercase tracking-[0.08em] text-[var(--muted)] no-underline hover:bg-[var(--ink)]/5 hover:text-[var(--ink)]"
              href={link.href}
            >
              {link.label}
            </a>
          ))}
          {user ? (
            <a
              class="block px-3 py-2 font-mono text-[0.68rem] uppercase tracking-[0.08em] text-[var(--muted)] no-underline hover:bg-[var(--ink)]/5 hover:text-[var(--ink)]"
              href="/account/security"
            >
              Account security
            </a>
          ) : null}
          {!user ? (
            <a
              class="block px-3 py-2 font-mono text-[0.68rem] uppercase tracking-[0.08em] text-[var(--muted)] no-underline hover:bg-[var(--ink)]/5 hover:text-[var(--ink)]"
              href="/create-bot"
            >
              Create a Bot
            </a>
          ) : null}
        </div>
      </details>
    </div>
  </div>
</header>
<script>
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Node)) return;
    document.querySelectorAll<HTMLDetailsElement>(".site-header details[open]").forEach((details) => {
      if (!details.contains(event.target as Node)) details.open = false;
    });
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    document.querySelectorAll<HTMLDetailsElement>(".site-header details[open]").forEach((details) => {
      const returnFocus = details.contains(document.activeElement);
      details.open = false;
      if (returnFocus) details.querySelector<HTMLElement>("summary")?.focus();
    });
  });
</script>
