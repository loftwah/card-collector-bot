---
import BrandMark from "./BrandMark.astro";
import ThemeToggle from "./ThemeToggle";
import LogoutButton from "./LogoutButton";
import { accountAvatarViewFor } from "../server/modules/account-avatar";
const session = Astro.locals.foilbury;
const user = session?.user ?? null;
const avatar = user ? accountAvatarViewFor(user) : null;
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + "/");
const links = [
  { href: "/cabinet", label: "Browse originals", primary: true },
  { href: "/brand-kit", label: "Media kit", primary: true },
  { href: "/find", label: "Find a page", primary: true },
  ...(user ? [{ href: "/play", label: "My library", primary: true }] : []),
  { href: "/tour", label: "Guided tour" },
  { href: "/journal", label: "Journal" },
  ...(user ? [{ href: "/account/security", label: "Account security" }] : []),
];
if (
  user?.platformAdmin ||
  user?.globalCollectionScope ||
  ["owner", "editor", "economy_admin"].includes(user?.role ?? "")
) {
  links.push({ href: "/studio", label: "Studio" });
}
if (user?.platformAdmin) links.push({ href: "/platform-admin", label: "Platform administration" });
---

<header class="site-header">
  <div class="container site-header__inner flex min-h-[68px] flex-wrap items-center justify-between gap-2 py-3 sm:gap-4">
    <a href="/" class="flex shrink-0 items-center gap-2.5 no-underline" aria-label="Foilbury home">
      <BrandMark size={26} class="text-[var(--ink)]" />
      <span class="hidden font-display text-[1.35rem] font-medium tracking-[-0.025em] min-[420px]:inline">
        Foilbury
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {links
        .filter((link) => link.primary)
        .map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
            class:list={[
              "border-b px-3 py-2 font-sans text-[0.84rem] font-medium no-underline transition-colors",
              isActive(link.href)
                ? "border-[var(--ink)] text-[var(--ink)]"
                : "border-transparent text-[var(--muted)] hover:text-[var(--ink)]",
            ]}
          >
            {link.label}
          </a>
        ))}
    </nav>

    <div class="ml-auto flex min-w-0 flex-wrap items-center justify-end gap-0 min-[360px]:gap-1.5">
      {user ? (
        <>
          <a
            href="/play"
            class="hidden min-h-[32px] items-center gap-1.5 rounded-full border border-[var(--line)] bg-[var(--panel)] px-2.5 py-1 font-sans text-[0.74rem] font-semibold no-underline sm:flex"
            title="Your Foil balance"
          >
            <svg
              viewBox="0 0 20 20"
              fill="none"
              aria-hidden="true"
              class="h-[15px] w-[15px] text-[var(--signal)]"
            >
              <circle cx="10" cy="10" r="7.25" stroke="currentColor" stroke-width="1.5"></circle>
              <path
                d="M10 5.8v8.4M12.6 7.4c-.55-.8-1.45-1.2-2.55-1.2-1.35 0-2.3.7-2.3 1.8 0 1 .8 1.5 2.3 1.8 1.55.3 2.4.8 2.4 1.95 0 1.15-1 1.85-2.4 1.85-1.15 0-2.1-.45-2.65-1.25"
                stroke="currentColor"
                stroke-width="1.25"
                stroke-linecap="round"
              ></path>
            </svg>
            <span data-foil-balance>{session?.wallet ?? 0} Foil</span>
          </a>
          <a
            href="/play/profile"
            class="site-avatar-link"
            aria-label={`${user.displayName} profile`}
            title={`${user.displayName} profile`}
          >
            <img
              src={avatar?.src ?? "/avatars/default/keeper-256.png"}
              srcset={avatar?.srcSet ?? undefined}
              sizes="28px"
              alt=""
              width="28"
              height="28"
              data-avatar-img
              data-fallback-src="/avatars/default/keeper-256.png"
            />
          </a>
          <a
            href="/account/security"
            class="hidden max-w-32 truncate text-xs text-[var(--muted)] hover:text-[var(--ink)] lg:inline"
          >
            {user.displayName}
          </a>
          <LogoutButton client:load />
        </>
      ) : (
        <a
          class="btn btn-primary btn-sm min-h-[44px] shrink-0 whitespace-nowrap px-2"
          href="/login"
        >
          Sign in
        </a>
      )}
      <ThemeToggle client:load />
      <details class="relative">
        <summary
          class="btn btn-ghost btn-sm min-h-[44px] cursor-pointer list-none px-2"
          aria-label="Menu"
        >
          Menu
        </summary>
        <nav
          aria-label="Site menu"
          class="site-header__menu absolute right-0 top-11 z-30 border border-[var(--line-strong)] bg-[var(--paper)] p-2 shadow-xl"
        >
          {links.map((link) => (
            <a
              class:list={[
                "flex min-h-11 items-center px-3 py-2 text-sm no-underline hover:bg-[var(--panel-3)]",
                link.primary && "lg:hidden",
                isActive(link.href) ? "font-semibold text-[var(--ink)]" : "text-[var(--muted)]",
              ]}
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>
<script>
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Node)) return;
    document
      .querySelectorAll<HTMLDetailsElement>(".site-header details[open]")
      .forEach((details) => {
        if (!details.contains(event.target as Node)) details.open = false;
      });
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    document
      .querySelectorAll<HTMLDetailsElement>(".site-header details[open]")
      .forEach((details) => {
        const returnFocus = details.contains(document.activeElement);
        details.open = false;
        if (returnFocus) details.querySelector<HTMLElement>("summary")?.focus();
      });
  });
</script>
