---
import BaseLayout from "../layouts/BaseLayout.astro";
import LoginForm from "../components/LoginForm";
import { pageContext } from "../server/page";

const ctx = await pageContext(Astro.request);
if (ctx.user) return Astro.redirect("/play");
const next = Astro.url.searchParams.get("next") ?? "/play";
const safeNext = next.startsWith("/") && !next.startsWith("//") ? next : "/play";
---
<BaseLayout title="Sign in · Foilbury" description="Sign in to your Foilbury cabinet." noIndex>
  <section class="container grid min-h-[calc(100vh-68px)] items-center gap-10 py-12 lg:grid-cols-2 lg:py-20">
    <div class="order-2 lg:order-1">
      <p class="eyebrow">Private cabinet · local access</p>
      <h1 class="display mt-4 text-[clamp(3rem,7vw,6rem)]">Welcome back.</h1>
      <p class="mt-5 max-w-md text-[var(--muted)]">Your collection, Foil balance, set progress and trade offers are waiting exactly where you left them.</p>
      <div class="surface mt-8 max-w-md p-6">
        <LoginForm client:load next={safeNext} devLoginEnabled={ctx.config.devLogin} />
      </div>
      {ctx.config.localMode ? (
        <div class="notice mt-5 max-w-md">
          <p class="font-mono text-[0.62rem] uppercase tracking-[0.12em] text-[var(--brass)]">Local development accounts</p>
          <p class="mt-2 text-sm leading-relaxed">
            Owner: <code>owner@foilbury.local</code><br />
            Player: <code>player@foilbury.local</code>
          </p>
          <p class="mt-2 text-xs text-[var(--muted)]">Passwords are generated by <code>pnpm setup:local</code> and stored only in <code>.foilbury/local-credentials.json</code> with mode 600. They are deliberately not printed here.</p>
        </div>
      ) : null}
    </div>
    <div class="relative order-1 flex min-h-[380px] items-center justify-center lg:order-2">
      <div class="absolute inset-10 rounded-full border border-[var(--line)]" aria-hidden="true"></div>
      <div class="relative w-[62%] max-w-[330px] -rotate-3">
        <div class="card-rail p-2">
          <img src="/brand/card-back.webp" alt="Foilbury card back: an ink-black cabinet pattern with a cream card mark and brass foil corner." class="block w-full rounded-[2px]" />
        </div>
        <p class="mt-3 text-center font-mono text-[0.58rem] uppercase tracking-[0.14em] text-[var(--muted)]">The cabinet is private by default</p>
      </div>
    </div>
  </section>
</BaseLayout>
