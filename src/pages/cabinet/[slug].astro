---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PublicVariantViewer from "../../components/PublicVariantViewer";
import { pageContext } from "../../server/page";
import { getCatalogueCard } from "../../server/modules/catalogue";
import { ApiError } from "../../server/context";
import { publicCard } from "../../server/api/public";
import { characterArtwork } from "../../lib/editorial-art";

const ctx = await pageContext(Astro.request);
const slug = Astro.params.slug ?? "";
let published;
try {
  published = await getCatalogueCard(ctx, slug, true);
} catch (error) {
  if (error instanceof ApiError && error.code === "card_not_found")
    return Astro.redirect("/cabinet");
  throw error;
}
const clean = publicCard(published);
const variants = clean.editions.flatMap((edition) =>
  edition.variants.map((variant) => ({
    ...variant,
    edition_name: edition.name,
    artwork_origin: edition.artwork_origin,
  })),
);
const artwork = characterArtwork.find((art) => art.slug === clean.slug);
const setName = clean.sets[0]?.name ?? null;
---

<BaseLayout
  title={`${clean.name} · Foilbury`}
  description={clean.description}
  shareImage={variants[0]?.render_url ?? "/brand/social-preview.jpg"}
  shareImageWidth={variants[0]?.render_url ? 750 : 1200}
  shareImageHeight={variants[0]?.render_url ? 1050 : 630}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "VisualArtwork",
      name: clean.name,
      description: clean.bio_safe ?? clean.description,
      creator: { "@type": "Organization", name: "Foilbury" },
      isPartOf: clean.collections[0]
        ? { "@type": "CollectionPage", name: clean.collections[0].name }
        : undefined,
      genre: clean.source_work ?? "Collectible card",
      image: new URL(
        variants[0]?.render_url ?? "/brand/social-preview.jpg",
        Astro.site ?? Astro.url,
      ).href,
      url: new URL(Astro.url.pathname, Astro.site ?? Astro.url).href,
    })}
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Foilbury",
          item: new URL("/", Astro.site ?? Astro.url).href,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Public showcase",
          item: new URL("/cabinet", Astro.site ?? Astro.url).href,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: clean.name,
          item: new URL(Astro.url.pathname, Astro.site ?? Astro.url).href,
        },
      ],
    })}
  />
  <section class="container py-12 md:py-16">
    <nav
      class="mb-8 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-[var(--muted)]"
      aria-label="Breadcrumb"
    >
      <a href="/cabinet">Cabinet</a> <span aria-hidden="true">/</span> <span>{clean.name}</span>
    </nav>
    <PublicVariantViewer
      client:load
      name={clean.name}
      subtitle={clean.subtitle}
      description={clean.description}
      bio={clean.bio}
      quote={clean.quote}
      collection={
        clean.collections[0]
          ? {
              name: clean.collections[0].name,
              logo_url: clean.collections[0].logo_url,
              description: clean.collections[0].name,
            }
          : null
      }
      cardBackUrl={clean.card_back_url}
      rarity={clean.rarity?.name ?? null}
      setName={setName}
      tags={clean.tags.map((tag) => tag.name)}
      attributes={
        clean.attributes as Array<{ label?: string; value?: string; unit?: string | null }>
      }
      sourceWork={clean.source_work}
      sourceRefs={clean.source_refs as string[]}
      reviewStatus={clean.review_status}
      variants={variants}
    />
    {artwork && (
      <section
        class="editorial-art border-t border-[var(--line)] pt-8"
        aria-labelledby="character-art-heading"
      >
        <h2 id="character-art-heading" class="display-sm mb-4 text-3xl">
          {artwork.title}
        </h2>
        <figure class="editorial-art__feature">
          <img
            src={artwork.src}
            alt={artwork.alt}
            width={artwork.width}
            height={artwork.height}
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            <a href={artwork.source}>Original artwork</a> · Woodhouse / Codex ImageGen
          </figcaption>
        </figure>
      </section>
    )}
    <div class="mt-14 grid gap-4 border-t border-[var(--line)] pt-8 md:grid-cols-3">
      <div>
        <p class="eyebrow">Identity</p>
        <p class="mt-1 text-sm">
          {clean.class?.name ?? "Cabinet card"} · {clean.category?.name ?? "Uncategorised"}
        </p>
      </div>
      <div>
        <p class="eyebrow">Sets</p>
        <p class="mt-1 text-sm">
          {clean.sets.map((set) => set.name).join(", ") || "No published set"}
        </p>
      </div>
      <div>
        <p class="eyebrow">Credit</p>
        <p class="mt-1 text-sm">
          Source art credited by the owner. Technical provenance is retained privately.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
