---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { pageContext } from "../../server/page";
import { getTaxonomy, listCards } from "../../server/modules/catalogue";
import { getCollection, listPublicCollections } from "../../server/modules/collections";

const ctx = await pageContext(Astro.request);
const search = Astro.url.searchParams.get("search") ?? "";
const category = Astro.url.searchParams.get("category") ?? "";
const tag = Astro.url.searchParams.get("tag") ?? "";
const collectionSlug = Astro.url.searchParams.get("collection") ?? "";
const [cards, taxonomy, collections] = await Promise.all([
  listCards(ctx, { publicOnly: true, search: search || undefined, category: category || undefined, tag: tag || undefined, collection: collectionSlug || undefined, limit: 100 }),
  getTaxonomy(ctx, { publicOnly: true }),
  listPublicCollections(ctx),
]);
const selectedCollection = collectionSlug ? collections.find((item) => item.slug === collectionSlug) ?? null : null;
const categories = taxonomy.categories as Array<{ slug: string; name: string }>;
const tags = taxonomy.tags as Array<{ slug: string; name: string }>;
function href(next: { search?: string; category?: string; tag?: string; collection?: string }) {
  const params = new URLSearchParams();
  const s = next.search ?? search;
  const c = next.category ?? category;
  const t = next.tag ?? tag;
  if (s) params.set("search", s);
  if (c) params.set("category", c);
  if (t) params.set("tag", t);
  const c2 = next.collection !== undefined ? next.collection : collectionSlug;
  if (c2) params.set("collection", c2);
  const query = params.toString();
  return `/cabinet${query ? `?${query}` : ""}`;
}
---
<BaseLayout title={selectedCollection ? `${selectedCollection.name} · Foilbury` : "The public showcase · Foilbury"} description="Explore the approved public showcase of original Foilbury worlds, characters and finishes.">
  <section class="border-b border-[var(--line)]">
    <div class="container py-14 md:py-20">
      <p class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-[var(--coral)]">Public showcase · Loftwah originals</p>
      <div class="mt-4 flex flex-wrap items-end justify-between gap-6">
        <div>
          <h1 class="display text-[clamp(3rem,7vw,6rem)]">{selectedCollection ? selectedCollection.name : "The public showcase."}</h1>
          <p class="mt-4 max-w-2xl text-[var(--muted)]">{selectedCollection ? selectedCollection.description : "Bubbles, Fighter, Protocol 11 and the shared cast are reviewed for public viewing. Member franchise albums are never promoted here."}</p>
        </div>
        <p class="font-mono text-[0.62rem] uppercase tracking-[0.12em] text-[var(--muted)]">{cards.length} published identities</p>
      </div>
      <div class="mt-6 flex flex-wrap gap-2">
        <a class="chip" data-active={!collectionSlug} href={href({ collection: "" })}>All public</a>
        {collections.map((item) => <a class="chip" data-active={collectionSlug === item.slug} href={`/cabinet?collection=${item.slug}`}>{item.name}</a>)}
      </div>
    </div>
  </section>

  <section class="container py-8">
    <form method="get" action="/cabinet" class="grid gap-3 border-b border-[var(--line)] pb-6 md:grid-cols-[1fr_auto_auto]">
      <label class="field">
        <span class="label">Search the catalogue</span>
        <input class="input" type="search" name="search" value={search} placeholder="Name, subtitle or description" />
      </label>
      <label class="field">
        <span class="label">Category</span>
        <select class="select" name="category">
          <option value="">All categories</option>
          {categories.map((item) => <option value={item.slug} selected={item.slug === category}>{item.name}</option>)}
        </select>
      </label>
      <label class="field">
        <span class="label">Tag</span>
        <select class="select" name="tag">
          <option value="">All tags</option>
          {tags.map((item) => <option value={item.slug} selected={item.slug === tag}>{item.name}</option>)}
        </select>
      </label>
      <div class="flex items-end gap-2 md:col-span-3">
        <button class="btn btn-primary btn-sm" type="submit">Apply filters</button>
        <a class="btn btn-ghost btn-sm" href="/cabinet">Reset</a>
      </div>
    </form>

    {cards.length ? (
      <div class="card-grid mt-9">
        {cards.map((card) => {
          const variant = card.editions.flatMap((edition) => edition.variants).find((item) => item.render_url);
          return (
            <a href={`/cabinet/${card.slug}`} class="group no-underline">
              <div class="card-face">
                {variant?.render_url ? <img src={variant.thumbnail_url ?? variant.render_url} alt={`${card.name} card`} loading="lazy" /> : <div class="card-face-fallback">{card.name.charAt(0)}</div>}
              </div>
              <div class="mt-2">
                <div class="flex items-start justify-between gap-2">
                  <p class="display-sm text-base leading-tight">{card.name}</p>
                  {card.rarity ? <span class="badge">{card.rarity.name}</span> : null}
                </div>
                <p class="mt-0.5 text-xs text-[var(--muted)]">{card.subtitle ?? card.category?.name ?? "Cabinet card"}</p>
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <div class="empty mt-9">
        <div>
          <p class="display-sm text-2xl">Nothing in this drawer.</p>
          <p class="mt-2 text-sm">Try another search, or <a class="underline" href="/cabinet">reset the filters</a>.</p>
        </div>
      </div>
    )}
  </section>
</BaseLayout>
