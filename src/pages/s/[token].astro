---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AchievementBadge from "../../components/player/AchievementBadge.astro";
import { pageContext } from "../../server/page";
import { resolveShareView } from "../../server/modules/shares";
import { formatDate, formatDual } from "../../lib/utils";

const ctx = await pageContext(Astro.request);
const raw = Astro.params.token ?? "";
const view = await resolveShareView(ctx, raw);
const { active, visible, publicView, link, collection, payload, showSerial, ownerDisplayName: owner } = view;
const kind = link?.kind ?? "cabinet";
if (!active) Astro.response.status = 404;
const shareTitle = kind === "card" || kind === "latest" ? String(payload.card_name ?? "A shared card") : kind === "achievement" ? String(payload.achievement_name ?? "A shared badge") : kind === "collection" ? String(payload.collection_name ?? "A shared collection") : kind === "profile" ? String(payload.display_name ?? "A collector") : "A shared Foilbury cabinet";
const pageTitle = active ? `${publicView ? shareTitle : "Member share"} · Foilbury` : "Share not found · Foilbury";
const currentPublic = Boolean(collection && collection.view_audience === "public" && collection.public_approved_at);
const finishLabel = String(payload.finish ?? "").replaceAll("diamond", "holographic");
const publicHref = currentPublic && collection ? `/cabinet?collection=${collection.slug}` : collection ? `/play/collection?collection=${collection.slug}` : "/cabinet";
---
<BaseLayout title={pageTitle} description={publicView ? `${shareTitle} — an explicitly shared Foilbury snapshot.` : "A members-only Foilbury share. Sign in with an entitled account to view it."} noIndex>
  <section class="container py-12 md:py-16">
    {active && visible ? (
      <>
        <div class="share-proof">
          <span class="badge badge-signal">{kind === "card" || kind === "latest" ? "Card share" : kind === "achievement" ? "Achievement share" : kind === "collection" ? "Collection share" : kind === "wishlist" ? "Wishlist share" : kind === "profile" ? "Collector showcase" : "Cabinet share"}</span>
          <span class="badge">{publicView ? "Public-safe" : "Members-only"}</span>
          <span class="badge">Snapshot · {formatDual(String(payload.captured_at ?? link!.created_at))}</span>
          <span class="badge">Expires {formatDate(link!.expires_at)}</span>
        </div>
        <h1 class="display mt-5 text-[clamp(2.8rem,7vw,6rem)] uppercase">{kind === "card" || kind === "latest" ? payload.card_name : kind === "achievement" ? payload.achievement_name : kind === "collection" ? payload.collection_name : kind === "wishlist" ? "Wanted cards" : kind === "profile" ? `${payload.display_name ?? owner ?? "A collector"}'s showcase` : `${owner ?? "A collector"} shared a cabinet`}</h1>
        <p class="mt-3 max-w-2xl text-[var(--muted)]">{kind === "card" || kind === "latest" ? `${finishLabel || "Card"}${payload.subtitle ? ` · ${payload.subtitle}` : ""}` : kind === "achievement" ? payload.achievement_description : kind === "collection" ? (collection?.description ?? payload.description ?? "A curated Foilbury world.") : "An explicitly shared snapshot. It is not a live inventory and cannot be used to act on the owner's account."}</p>

        {kind === "card" || kind === "latest" ? (
          <div class="mt-8 grid max-w-5xl gap-6 lg:grid-cols-2 lg:items-start">
            <figure>
              {payload.render_url ? <img class="share-card" src={String(payload.render_url)} alt={`${payload.card_name} front`} width="750" height="1050" /> : <div class="card-face-fallback">Front unavailable</div>}
              <figcaption class="mt-2 font-mono text-[0.58rem] uppercase tracking-[0.1em] text-[var(--muted)]">Front · {finishLabel || "published finish"}</figcaption>
            </figure>
            <figure>
              {payload.back_url ? <img class="share-card" src={String(payload.back_url)} alt={`${payload.card_name} back`} width="750" height="1050" /> : <div class="card-face-fallback">Back unavailable</div>}
              <figcaption class="mt-2 font-mono text-[0.58rem] uppercase tracking-[0.1em] text-[var(--muted)]">Back · collection identity, bio and credits</figcaption>
            </figure>
          </div>
        ) : null}

        {kind === "collection" ? (
          <div class="mt-8 max-w-3xl border border-[var(--line)] p-5">
            <div class="flex items-center gap-4">
              {collection?.logo_url ? <img src={collection.logo_url} alt="" class="h-16 w-16 object-contain" width="64" height="64" /> : null}
              <div><p class="font-semibold">{collection?.name ?? payload.collection_name}</p><p class="font-mono text-[0.6rem] uppercase tracking-[0.1em] text-[var(--muted)]">{collection?.view_audience ?? "member"} · snapshot</p></div>
            </div>
            <p class="mt-4 text-sm text-[var(--muted)]">{collection?.description ?? payload.description}</p>
            <a class="btn btn-secondary btn-sm mt-4" href={publicHref}>{currentPublic ? "Open the public collection" : "Open the member album"}</a>
          </div>
        ) : null}

        {kind === "achievement" ? (
          <div class="mt-8 flex max-w-2xl items-start gap-5 border border-[var(--line)] p-5">
            <AchievementBadge artKey={String(payload.art_key ?? "medal-collection")} name={String(payload.achievement_name ?? "Achievement")} category={String(payload.category ?? "milestone")} earned size={96} emblemUrl={typeof payload.collection_logo_url === "string" ? payload.collection_logo_url : null} />
            <div><p class="text-sm font-semibold">Earned {payload.earned_at ? formatDual(String(payload.earned_at)) : ""}</p><p class="mt-1 text-sm text-[var(--muted)]">{payload.achievement_description}</p><p class="mt-3 text-xs text-[var(--muted)]">A badge is a historical fact. It is not removed when a collection grows or a card is traded.</p></div>
          </div>
        ) : null}

        {kind === "wishlist" ? (
          <ul class="mt-8 grid max-w-3xl gap-2 sm:grid-cols-2">
            {(Array.isArray(payload.items) ? payload.items : []).map((item: { card_name?: string }) => <li class="border border-[var(--line)] px-3 py-2 text-sm">{item.card_name ?? "Wanted card"}</li>)}
          </ul>
        ) : null}

        {kind === "cabinet" ? (
          <div class="mt-8 grid max-w-2xl gap-3 sm:grid-cols-2">
            <div class="border border-[var(--line)] p-5"><p class="studio-stat__label">Owned cards</p><p class="display-sm mt-1 text-4xl">{String(payload.cards ?? 0)}</p></div>
            <div class="border border-[var(--line)] p-5"><p class="studio-stat__label">Favourites</p><p class="display-sm mt-1 text-4xl">{String(payload.favourites ?? 0)}</p></div>
          </div>
        ) : null}

        {kind === "profile" ? (
          <div class="mt-8 grid max-w-4xl gap-6 lg:grid-cols-[1fr_1fr]">
            <div class="grid gap-3 sm:grid-cols-2">
              {Array.isArray(payload.favourite_cards) && payload.favourite_cards.length ? payload.favourite_cards.map((card: { name?: string; variant_name?: string; render_url?: string | null }) => (
                <div class="border border-[var(--line)] bg-[var(--paper)] p-2">
                  {card.render_url ? <img src={card.render_url} alt="" class="w-full border border-[var(--line)]" loading="lazy" /> : null}
                  <p class="mt-1 text-sm font-semibold">{card.name}</p><p class="font-mono text-[0.54rem] uppercase tracking-[0.08em] text-[var(--muted)]">{card.variant_name}</p>
                </div>
              )) : <p class="text-sm text-[var(--muted)]">No pinned favourites in this snapshot.</p>}
            </div>
            <div>
              <div class="grid grid-cols-2 gap-3">
                <div class="border border-[var(--line)] p-4"><p class="studio-stat__label">Owned cards</p><p class="display-sm mt-1 text-3xl">{String(payload.cards ?? 0)}</p></div>
                <div class="border border-[var(--line)] p-4"><p class="studio-stat__label">Favourites</p><p class="display-sm mt-1 text-3xl">{String(payload.favourites ?? 0)}</p></div>
              </div>
              <p class="mt-4 studio-stat__label">Recent badges</p>
              <ul class="mt-2 grid gap-2">
                {Array.isArray(payload.badges) ? payload.badges.map((badge: { name?: string }) => <li class="border border-[var(--line)] px-3 py-2 text-sm">{badge.name}</li>) : null}
              </ul>
              <p class="mt-4 text-xs leading-relaxed text-[var(--muted)]">Only pinned favourites, counts and opted-in badges appear. Wallet, email, account ID and private ledger never do.</p>
            </div>
          </div>
        ) : null}

        <div class="mt-10 border-t border-[var(--line)] pt-5 text-xs leading-relaxed text-[var(--muted)]">
          <p>{showSerial ? `Your copy serial: ${payload.serial}. ` : ""}This is a snapshot captured at share time, not a live wallet or inventory. The owner can revoke the link; already-downloaded bytes cannot be recalled.</p>
          <p class="mt-2">No email, account ID, wallet balance, private ledger or admin data is exposed.</p>
        </div>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="btn btn-primary" href={publicView ? "/cabinet" : "/login"}>Browse Foilbury</a>
          <a class="btn btn-secondary" href="/play">Open my album</a>
        </div>
      </>
    ) : active ? (
      <div class="mx-auto max-w-2xl border border-[var(--line)] p-8">
        <p class="studio-kicker text-[var(--teal)]">A members-only share</p>
        <h1 class="display mt-3 text-4xl uppercase">This cabinet is behind membership.</h1>
        <p class="mt-4 text-[var(--muted)]">The link is active, but viewing restricted cards, collections and badges needs a signed-in Foilbury account with current access. A secret URL is not membership.</p>
        <div class="mt-6 flex flex-wrap gap-3"><a class="btn btn-primary" href={`/login?next=${encodeURIComponent(Astro.url.pathname)}`}>Sign in to view</a><a class="btn btn-secondary" href="/cabinet">See the public showcase</a></div>
      </div>
    ) : (
      <div class="mx-auto max-w-2xl">
        <p class="studio-kicker text-[var(--teal)]">Share link</p>
        <h1 class="display mt-3 text-5xl uppercase">This share is not available.</h1>
        <p class="mt-4 text-[var(--muted)]">The link may have expired, been revoked, or never existed. No private data is shown.</p>
        <a class="btn btn-secondary mt-6" href="/">Return home</a>
      </div>
    )}
  </section>
</BaseLayout>
