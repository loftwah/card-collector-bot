---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AchievementBadge from "../../components/player/AchievementBadge.astro";
import { pageContext } from "../../server/page";
import { resolveShareView } from "../../server/modules/shares";
import { formatDate, formatDual } from "../../lib/utils";
import { collectionBanner, collectionMark } from "../../lib/collection-art";

const ctx = await pageContext(Astro.request);
const raw = Astro.params.token ?? "";
const view = await resolveShareView(ctx, raw);
const { active, visible, publicView, link, collection, payload, showSerial, ownerDisplayName: owner } = view;
const kind = link?.kind ?? "cabinet";
if (!active) Astro.response.status = 404;
const shareTitle = kind === "card" || kind === "latest" ? String(payload.card_name ?? "A shared card") : kind === "achievement" ? String(payload.achievement_name ?? "A shared badge") : kind === "collection" ? String(payload.collection_name ?? "A shared collection") : kind === "profile" ? String(payload.display_name ?? "A collector") : "A shared Foilbury cabinet";
const pageTitle = active ? `${publicView ? shareTitle : "Member share"} · Foilbury` : "Share not found · Foilbury";
const currentPublic = Boolean(collection && collection.view_audience === "public" && collection.public_approved_at);
const collectionIdentity = collectionBanner(collection) ?? collectionMark(collection);
const finishLabel = String(payload.finish ?? "").replaceAll("diamond", "holographic");
const cardMeta = (variant: string | undefined, finish: string | undefined) => {
  const name = String(variant ?? "");
  const material = String(finish ?? "");
  return material && material !== name ? `${name} · ${material}` : name;
};
const publicHref = currentPublic && collection ? `/cabinet?collection=${collection.slug}` : collection ? `/play/collection?collection=${collection.slug}` : "/cabinet";
const profileLook = ["quiet", "signal", "binder", "night"].includes(String(payload.profile_look ?? ""))
  ? String(payload.profile_look)
  : "quiet";
const sharePresentation =
  payload.presentation && typeof payload.presentation === "object"
    ? (payload.presentation as {
        portrait?: { kind?: string; label?: string; image_url?: string | null };
        banner?: { kind?: string; label?: string; image_url?: string | null };
        frame?: string;
        avatar_decoration?: string;
        name_treatment?: string;
        effect?: string;
        featured?: {
          card_name?: string;
          variant_name?: string;
          finish?: string;
          render_url?: string | null;
        } | null;
        favourites?: Array<{
          card_name?: string;
          variant_name?: string;
          finish?: string;
          render_url?: string | null;
        }>;
        badges?: Array<{
          name?: string;
          category?: string;
          art_key?: string;
          collection_logo_url?: string | null;
        }>;
      })
    : null;
const sharePortrait = sharePresentation?.portrait?.image_url ?? null;
const shareBanner = sharePresentation?.banner?.image_url ?? null;
const cardRender = typeof payload.render_url === "string" ? payload.render_url : null;
const shareImage = publicView
  ? (cardRender ?? shareBanner ?? sharePortrait ?? "/brand/social-preview.jpg")
  : "/brand/social-preview.jpg";
const shareImageWidth = publicView && (cardRender || shareBanner || sharePortrait) ? 750 : 1200;
const shareImageHeight = publicView && (cardRender || shareBanner || sharePortrait) ? 1050 : 630;
const shareFavourites = sharePresentation?.favourites?.length
  ? sharePresentation.favourites
  : (Array.isArray(payload.favourite_cards)
      ? (payload.favourite_cards as Array<{ name?: string; variant_name?: string; render_url?: string | null }>)
      : []
    ).map((card) => ({
      card_name: card.name,
      variant_name: card.variant_name,
      finish: String(payload.finish ?? ""),
      render_url: card.render_url,
    }));
const shareBadges = sharePresentation?.badges?.length
  ? sharePresentation.badges
  : (Array.isArray(payload.badges)
      ? (payload.badges as Array<{ name?: string; art_key?: string }>)
      : []
    ).map((badge) => ({
      name: badge.name,
      category: "earned",
      art_key: badge.art_key,
      collection_logo_url: null,
    }));
---
<BaseLayout title={pageTitle} description={publicView ? `${shareTitle} — an explicitly shared Foilbury snapshot.` : "A members-only Foilbury share. Sign in with an entitled account to view it."} noIndex shareImage={shareImage} shareImageWidth={shareImageWidth} shareImageHeight={shareImageHeight}>
  <section class="container py-12 md:py-16">
    {active && visible ? (
      <>
        <div class="share-proof">
          <span class="badge badge-signal">{kind === "card" || kind === "latest" ? "Card share" : kind === "achievement" ? "Achievement share" : kind === "collection" ? "Collection share" : kind === "wishlist" ? "Wishlist share" : kind === "profile" ? "Collector showcase" : "Cabinet share"}</span>
          <span class="badge">{publicView ? "Public-safe" : "Members-only"}</span>
          <span class="badge">Snapshot · {formatDual(String(payload.captured_at ?? link!.created_at))}</span>
          <span class="badge">Expires {formatDate(link!.expires_at)}</span>
        </div>
        <h1 class="page-title mt-5">{kind === "card" || kind === "latest" ? payload.card_name : kind === "achievement" ? payload.achievement_name : kind === "collection" ? payload.collection_name : kind === "wishlist" ? "Wanted cards" : kind === "profile" ? `${payload.display_name ?? owner ?? "A collector"}'s showcase` : `${owner ?? "A collector"} shared a cabinet`}</h1>
        <p class="mt-3 max-w-2xl text-[var(--muted)]">{kind === "card" || kind === "latest" ? `${finishLabel || "Card"}${payload.subtitle ? ` · ${payload.subtitle}` : ""}` : kind === "achievement" ? payload.achievement_description : kind === "collection" ? (collection?.description ?? payload.description ?? "A curated Foilbury world.") : "An explicitly shared snapshot. It is not a live inventory and cannot be used to act on the owner's account."}</p>

        {kind === "card" || kind === "latest" ? (
          <div class="mt-8 grid max-w-5xl gap-6 lg:grid-cols-2 lg:items-start">
            <figure>
              {payload.render_url ? <img class="share-card" src={String(payload.render_url)} alt={`${payload.card_name} front`} width="750" height="1050" /> : <div class="card-face-fallback">Front unavailable</div>}
              <figcaption class="mt-2 font-mono text-[0.58rem] uppercase tracking-[0.1em] text-[var(--muted)]">Front · {finishLabel || "published finish"}</figcaption>
            </figure>
            <figure>
              {payload.back_url ? <img class="share-card" src={String(payload.back_url)} alt={`${payload.card_name} back`} width="750" height="1050" /> : <div class="card-face-fallback">Back unavailable</div>}
              <figcaption class="mt-2 font-mono text-[0.58rem] uppercase tracking-[0.1em] text-[var(--muted)]">Back · collection identity, bio and credits</figcaption>
            </figure>
          </div>
        ) : null}

        {kind === "collection" ? (
          <div class="mt-8 max-w-3xl border border-[var(--line)] p-5">
            {collectionIdentity ? <img src={collectionIdentity} alt="" class:list={["mb-4 aspect-[16/9] w-full max-w-xl border border-[var(--line)]", collection?.banner_url ? "object-cover" : "bg-[var(--panel-3)] object-contain p-6"]} width="640" height="360" /> : null}
            <div class="flex items-center gap-4">
              {collection?.logo_url ? <img src={collection.logo_url} alt="" class="h-16 w-16 object-contain" width="64" height="64" /> : null}
              <div><p class="font-semibold">{collection?.name ?? payload.collection_name}</p><p class="font-mono text-[0.6rem] uppercase tracking-[0.1em] text-[var(--muted)]">{collection?.view_audience ?? "member"} · snapshot</p></div>
            </div>
            <p class="mt-4 text-sm text-[var(--muted)]">{collection?.description ?? payload.description}</p>
            <a class="btn btn-secondary btn-sm mt-4" href={publicHref}>{currentPublic ? "Open the public collection" : "Open the member album"}</a>
          </div>
        ) : null}

        {kind === "achievement" ? (
          <div class="mt-8 flex max-w-2xl items-start gap-5 border border-[var(--line)] p-5">
            <AchievementBadge artKey={String(payload.art_key ?? "medal-collection")} name={String(payload.achievement_name ?? "Achievement")} category={String(payload.category ?? "milestone")} earned size={96} emblemUrl={typeof payload.collection_logo_url === "string" ? payload.collection_logo_url : null} />
            <div><p class="text-sm font-semibold">Earned {payload.earned_at ? formatDual(String(payload.earned_at)) : ""}</p><p class="mt-1 text-sm text-[var(--muted)]">{payload.achievement_description}</p><p class="mt-3 text-xs text-[var(--muted)]">A badge is a historical fact. It is not removed when a collection grows or a card is traded.</p></div>
          </div>
        ) : null}

        {kind === "wishlist" ? (
          <ul class="mt-8 grid max-w-3xl gap-2 sm:grid-cols-2">
            {(Array.isArray(payload.items) ? payload.items : []).map((item: { card_name?: string; target?: string | null }) => <li class="border border-[var(--line)] px-3 py-2 text-sm">{item.card_name ?? "Wanted card"}{item.target ? <span class="block font-mono text-[0.58rem] uppercase tracking-[0.08em] text-[var(--muted)]">{item.target}</span> : null}</li>)}
          </ul>
        ) : null}

        {kind === "cabinet" ? (
          <div class="mt-8 grid max-w-2xl gap-3 sm:grid-cols-2">
            <div class="border border-[var(--line)] p-5"><p class="studio-stat__label">Owned cards</p><p class="display-sm mt-1 text-4xl">{String(payload.cards ?? 0)}</p></div>
            <div class="border border-[var(--line)] p-5"><p class="studio-stat__label">Favourites</p><p class="display-sm mt-1 text-4xl">{String(payload.favourites ?? 0)}</p></div>
          </div>
        ) : null}

        {kind === "profile" ? (
          <div
            class="share-profile"
            data-profile-look={profileLook}
            data-profile-frame={sharePresentation?.frame ?? "none"}
            data-avatar-decoration={sharePresentation?.avatar_decoration ?? "none"}
            data-name-treatment={sharePresentation?.name_treatment ?? "plain"}
            data-profile-effect={sharePresentation?.effect ?? "none"}
          >
            <div class="share-profile__hero">
              {shareBanner ? <img class="profile-hero__banner" src={shareBanner} alt="" aria-hidden="true" /> : null}
              <div class="profile-hero__identity">
                {sharePortrait ? (
                  <span class="profile-avatar profile-avatar--image" aria-hidden="true">
                    <img src={sharePortrait} alt="" width="64" height="64" />
                  </span>
                ) : null}
                <div class="min-w-0">
                  <p class="share-profile__name">{payload.display_name ?? owner ?? "A collector"}</p>
                  <p class="profile-hero__meta">
                    {sharePresentation?.portrait?.label ? `${sharePresentation.portrait.label} · ` : ""}
                    Collector snapshot
                  </p>
                </div>
              </div>
              {payload.profile_bio ? <p class="profile-hero__bio">{String(payload.profile_bio)}</p> : null}
            </div>

            {sharePresentation?.featured ? (
              <div class="share-profile__feature">
                <div class="profile-card__object">
                  {sharePresentation.featured.render_url ? (
                    <img src={sharePresentation.featured.render_url} alt={`${sharePresentation.featured.card_name ?? "Card"} front`} width="300" height="420" />
                  ) : (
                    <div class="card-face-fallback">{(sharePresentation.featured.card_name ?? "?").charAt(0)}</div>
                  )}
                </div>
                <div class="profile-card__body">
                  <span class="badge badge-signal">Featured exact copy</span>
                  <p class="share-profile__feature-name">{sharePresentation.featured.card_name}</p>
                  <p class="profile-card__meta">
                    {cardMeta(sharePresentation.featured.variant_name, sharePresentation.featured.finish)}
                  </p>
                </div>
              </div>
            ) : null}

            <div class="profile-showcase share-profile__cards">
              {shareFavourites.length ? shareFavourites.map((card) => (
                <article class="profile-card">
                  <div class="profile-card__object">
                    {card.render_url ? <img src={card.render_url} alt="" loading="lazy" /> : <div class="card-face-fallback">{(card.card_name ?? "?").charAt(0)}</div>}
                  </div>
                  <div class="profile-card__body">
                    <p class="profile-card__name">{card.card_name}</p>
                    <p class="profile-card__meta">{cardMeta(card.variant_name, card.finish)}</p>
                  </div>
                </article>
              )) : <p class="text-sm text-[var(--muted)]">No pinned favourites in this snapshot.</p>}
            </div>
            <dl class="profile-stats share-profile__stats">
              <div><dt>Owned cards</dt><dd>{String(payload.cards ?? 0)}</dd></div>
              <div><dt>Favourites</dt><dd>{String(payload.favourites ?? 0)}</dd></div>
            </dl>
            <div class="profile-badges share-profile__badges">
              {shareBadges.length ? shareBadges.map((badge) => (
                <div class="profile-badge">
                  <AchievementBadge
                    artKey={String(badge.art_key ?? "medal-collection")}
                    name={String(badge.name ?? "Achievement")}
                    category={String(badge.category ?? "milestone")}
                    earned
                    size={48}
                    emblemUrl={badge.collection_logo_url ?? null}
                  />
                  <div class="min-w-0">
                    <p class="profile-badge__name">{badge.name}</p>
                    <p class="profile-badge__meta">{badge.category ?? "earned"}</p>
                  </div>
                </div>
              )) : null}
            </div>
            <p class="mt-4 text-xs leading-relaxed text-[var(--muted)]">Only the saved composition, featured exact copy, pinned favourites, counts and earned badges appear. Wallet, email, account ID and private ledger never do.</p>
          </div>
        ) : null}

        <div class="mt-10 border-t border-[var(--line)] pt-5 text-xs leading-relaxed text-[var(--muted)]">
          <p>{showSerial && (kind === "card" || kind === "latest") ? `Your copy serial: ${payload.serial}. ` : ""}This is a snapshot captured at share time, not a live wallet or inventory. The owner can revoke the link; already-downloaded bytes cannot be recalled.</p>
          <p class="mt-2">No email, account ID, wallet balance, private ledger or admin data is exposed.</p>
        </div>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="btn btn-primary" href={publicView ? "/cabinet" : "/login"}>Browse Foilbury</a>
          <a class="btn btn-secondary" href="/play">Open my album</a>
        </div>
      </>
    ) : active ? (
      <div class="mx-auto max-w-2xl border border-[var(--line)] p-8">
        <p class="studio-kicker text-[var(--teal)]">A members-only share</p>
        <h1 class="display mt-3 text-4xl uppercase">This cabinet is behind membership.</h1>
        <p class="mt-4 text-[var(--muted)]">The link is active, but viewing restricted cards, collections and badges needs a signed-in Foilbury account with current access. A secret URL is not membership.</p>
        <div class="mt-6 flex flex-wrap gap-3"><a class="btn btn-primary" href={`/login?next=${encodeURIComponent(Astro.url.pathname)}`}>Sign in to view</a><a class="btn btn-secondary" href="/cabinet">See the public showcase</a></div>
      </div>
    ) : (
      <div class="mx-auto max-w-2xl">
        <p class="studio-kicker text-[var(--teal)]">Share link</p>
        <h1 class="display mt-3 text-5xl uppercase">This share is not available.</h1>
        <p class="mt-4 text-[var(--muted)]">The link may have expired, been revoked, or never existed. No private data is shown.</p>
        <a class="btn btn-secondary mt-6" href="/">Return home</a>
      </div>
    )}
  </section>
</BaseLayout>
