---
import BaseLayout from "../layouts/BaseLayout.astro";
import BotCreator from "../components/bots/BotCreator";
import { pageContext } from "../server/page";
import { listBotsForUser } from "../server/modules/bots";
import { first } from "../server/db";

const ctx = await pageContext(Astro.request);
if (!ctx.user) return Astro.redirect(`/login?next=${encodeURIComponent("/create-bot")}`);
const user = ctx.user;
const [bots, protection] = await Promise.all([
  listBotsForUser(ctx.db, user.id),
  first<{ passkeys: number; totp: number; access: number }>(
    ctx.db,
    `SELECT
       (SELECT COUNT(*) FROM fb_webauthn_credentials WHERE user_id = ?) AS passkeys,
       (SELECT COUNT(*) FROM fb_totp_secrets WHERE user_id = ? AND confirmed_at IS NOT NULL) AS totp,
       (SELECT COUNT(*) FROM fb_access_identities WHERE user_id = ? AND revoked_at IS NULL) AS access`,
    user.id,
    user.id,
    user.id,
  ),
]);
const ready = Boolean(user.emailVerified) && Boolean(protection && (protection.passkeys > 0 || protection.totp > 0 || protection.access > 0));
---
<BaseLayout title="Create a Bot · Foilbury" description="Create your own Foilbury Bot and collection cabinet." noIndex>
  <section class="container grid gap-8 py-12 lg:grid-cols-[1fr_0.85fr] lg:items-start">
    <div>
      <p class="eyebrow">Creator journey</p>
      <h1 class="display mt-3 text-[clamp(3rem,7vw,6rem)]">Open your own cabinet.</h1>
      <p class="mt-5 max-w-xl text-[var(--muted)]">A Bot is your collection world: its own cards, pools, economy, installations and team. Foilbury remains the identity authority; Cloudflare Access is the door, not the role.</p>
      <div class="mt-8"><BotCreator client:load ready={ready} displayName={user.displayName} /></div>
    </div>
    <aside class="grid gap-4">
      {bots.length > 0 ? (
        <div class="surface p-5">
          <p class="eyebrow">Your Bots</p>
          <div class="mt-3 grid gap-2">
            {bots.map((bot) => (
              <div class="flex flex-wrap items-center justify-between gap-3 border border-[var(--line)] px-4 py-3">
                <div><p class="font-semibold">{bot.name}</p><p class="text-xs text-[var(--muted)]">{bot.role_label} · {bot.card_count} cards · {bot.member_count} members</p></div>
                <a class="btn btn-secondary btn-sm" href={`/api/v1/bots/${bot.id}/switch`} data-switch-bot={bot.id}>Open</a>
              </div>
            ))}
          </div>
        </div>
      ) : null}
      <div class="surface-flat p-5">
        <p class="eyebrow">What stays shared</p>
        <ul class="mt-3 grid gap-2 text-sm text-[var(--muted)]">
          <li><strong class="text-[var(--ink)]">Global collections</strong> are curated by the Super Admin and can be turned on or off per Bot.</li>
          <li><strong class="text-[var(--ink)]">Your Bot collections</strong> are private to your Bot and never appear in another creator&rsquo;s cabinet.</li>
          <li><strong class="text-[var(--ink)]">Cards, balances and serials</strong> stay in the Bot where they were awarded.</li>
        </ul>
      </div>
      <div class="notice">
        <p class="text-xs leading-relaxed">Cloudflare Access admission is verified on every administrative request. It does not grant Super Admin, Bot Owner or Bot Admin by itself. Dean is the only explicitly provisioned Super Admin.</p>
      </div>
    </aside>
  </section>
  <script>
    document.querySelectorAll("[data-switch-bot]").forEach((link) => {
      link.addEventListener("click", async (event) => {
        event.preventDefault();
        const id = link.getAttribute("data-switch-bot");
        const response = await fetch(`/api/v1/bots/${id}/switch`, { method: "POST", credentials: "same-origin", headers: { "x-foilbury-csrf": document.querySelector('meta[name="foilbury-csrf"]')?.getAttribute("content") ?? "" } });
        if (response.ok) window.location.href = "/admin";
      });
    });
  </script>
</BaseLayout>
