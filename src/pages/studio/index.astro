---
import StudioLayout from "../../layouts/StudioLayout.astro";
import { pageContext } from "../../server/page";
import { listCollections, collectionProgress } from "../../server/modules/collections";
import { botForTenant } from "../../server/modules/bots";

const ctx = await pageContext(Astro.request);
const user = ctx.user!;
const bot = await botForTenant(ctx.db, ctx.tenant.id);
const collections = await listCollections(ctx, { includeAll: true });
const visible = user.platformAdmin || user.globalCollectionScope
  ? collections.filter((collection) => collection.scope === "global")
  : collections.filter((collection) => collection.scope === "bot" || collection.enabled);
const managed = visible.filter((collection) => collection.manageable);
const progress = await Promise.all(managed.slice(0, 6).map(async (collection) => ({ collection, stat: await collectionProgress(ctx, collection.id) })));
const scopeText = user.platformAdmin
  ? "All shared collections and platform administration"
  : user.globalCollectionScope
    ? user.globalCollectionScope.all
      ? "Every shared collection"
      : `${user.globalCollectionScope.collectionIds.length} explicitly assigned shared collections`
    : bot
      ? `Bot-scoped only · ${bot.name}`
      : "No administration scope";
---
<StudioLayout>
  <div class="studio-rule">
    <div>
      <h2 class="display-sm text-4xl uppercase">What you can change.</h2>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-[var(--muted)]">The scope is enforced by the Worker on every request, not by hiding buttons. If a link is absent, the API will refuse it too.</p>
    </div>
    <span class="studio-stamp">{user.platformAdmin ? "Root · provisioned" : user.globalCollectionScope ? "Scoped · collection" : "Scoped · Bot"}</span>
  </div>

  <div class="mt-6 grid gap-3 sm:grid-cols-3">
    <div class="studio-stat"><p class="studio-stat__label">Your scope</p><p class="studio-stat__value">{scopeText}</p></div>
    <div class="studio-stat"><p class="studio-stat__label">Collections you can edit</p><p class="studio-stat__value">{managed.length}</p></div>
    <div class="studio-stat"><p class="studio-stat__label">Bot context</p><p class="studio-stat__value">{bot?.name ?? "Shared catalogue"}</p></div>
  </div>

  <section class="mt-8 border border-[var(--line)] bg-[var(--paper-2)]/50 p-5">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h3 class="display-sm text-2xl uppercase">The clean boundary</h3>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-[var(--muted)]">Foilbury owns card identity, variants, pools, inventory, achievements and permissions. EmDash owns journal drafts, editorial media and publishing. There is one card catalogue and one journal, deliberately.</p>
      </div>
      <a class="btn btn-signal btn-sm" href="/brand-kit">Open the brand kit ↗</a>
    </div>
  </section>

  <section class="mt-8">
    <div class="flex flex-wrap items-end justify-between gap-3 border-b border-[var(--line)] pb-3">
      <h3 class="display-sm text-2xl uppercase">Editable worlds</h3>
      <a class="font-mono text-[0.6rem] uppercase tracking-[0.12em] underline underline-offset-4" href="/studio/collections">All collections →</a>
    </div>
    <div class="mt-4 grid gap-3 md:grid-cols-2">
      {progress.map(({ collection, stat }) => (
        <a href={`/studio/collections`} class="group flex items-center gap-4 border border-[var(--line)] bg-[var(--paper)] p-3 no-underline transition-colors hover:border-[var(--ink)]">
          {collection.logo_url ? <img src={collection.logo_url} alt="" class="h-12 w-12 object-contain" width="48" height="48" loading="lazy" /> : <span class="grid h-12 w-12 place-items-center bg-[var(--ink)] font-display text-xl text-[var(--paper)]">{collection.name.charAt(0)}</span>}
          <div class="min-w-0">
            <p class="truncate font-semibold">{collection.name}</p>
            <p class="mt-0.5 font-mono text-[0.58rem] uppercase tracking-[0.1em] text-[var(--muted)]">{collection.scope} · {collection.status} · {stat.owned_cards}/{stat.total_cards} owned</p>
          </div>
          <span class="ml-auto text-lg transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      ))}
      {progress.length === 0 ? <p class="empty md:col-span-2">No collection assignment yet. Ask the Super Admin for a scoped role; you do not need platform root.</p> : null}
    </div>
  </section>

  <section class="mt-8 grid gap-4 md:grid-cols-2">
    <div class="border border-[var(--line)] p-5">
      <h3 class="display-sm text-xl uppercase">What you cannot do</h3>
      <ul class="mt-3 grid gap-2 text-sm text-[var(--muted)]">
        <li>Grant Super Admin, change Access or manage platform secrets.</li>
        <li>Edit a Bot you were not given, or read its private collections.</li>
        <li>Publish public showcase content without Super Admin approval.</li>
        <li>Mint cards, spend Foil or alter another member's inventory.</li>
      </ul>
    </div>
    <div class="border border-[var(--line)] p-5">
      <h3 class="display-sm text-xl uppercase">Next useful action</h3>
      <p class="mt-2 text-sm text-[var(--muted)]">Open a shared collection to edit its identity, branding, release state and card membership. Changes are audited with your account as the actor.</p>
      <div class="mt-4 flex flex-wrap gap-2">
        <a class="btn btn-primary btn-sm" href="/studio/collections">Edit collections</a>
        <a class="btn btn-secondary btn-sm" href="/play/collections">See the member view</a>
      </div>
    </div>
  </section>
</StudioLayout>
