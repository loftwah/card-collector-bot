---
import StudioLayout from "../../layouts/StudioLayout.astro";
import DiscordInstallations from "../../components/studio/DiscordInstallations";
---
<StudioLayout>
  <div class="studio-rule">
    <div>
      <h2 class="display-sm text-4xl uppercase">Discord servers.</h2>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-[var(--muted)]">Set collection availability for each connected server. Bot availability and audience permissions still apply.</p>
    </div>
    <span class="studio-stamp">Bot-scoped</span>
  </div>
  <div class="mt-7"><DiscordInstallations client:load /></div>
</StudioLayout>
