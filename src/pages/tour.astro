---
import BaseLayout from "../layouts/BaseLayout.astro";
import CardInspector from "../components/player/CardInspector";
import { pageContext, pickVariant, publicStats } from "../server/page";
import { listCards } from "../server/modules/catalogue";
import { listPublicCollections } from "../server/modules/collections";
import { first } from "../server/db";
import { displayFinish } from "../lib/utils";

const ctx = await pageContext(Astro.request);
const user = ctx.user;
const [cards, collections, stats, economy] = await Promise.all([
  listCards(ctx, { publicOnly: true, limit: 60 }),
  listPublicCollections(ctx),
  publicStats(ctx),
  first<{ starter_grant: number; daily_reward: number; daily_cooldown_seconds: number }>(
    ctx.db,
    "SELECT starter_grant, daily_reward, daily_cooldown_seconds FROM fb_economy_settings WHERE tenant_id = ?",
    ctx.tenant.id,
  ),
]);
const featured = cards
  .map((card) => {
    const variant = card.editions.flatMap((edition) => edition.variants).find((item) => item.render_url && item.back_render_url);
    return variant ? { card, variant } : null;
  })
  .filter(Boolean) as Array<{ card: (typeof cards)[number]; variant: NonNullable<ReturnType<typeof pickVariant>> }>;
const hero = featured[0] ?? null;
const step = Math.min(6, Math.max(1, Math.floor(Number(Astro.url.searchParams.get("step") ?? 1) || 1)));
const finishExamples = hero
  ? hero.card.editions.flatMap((edition) => edition.variants).filter((variant) => variant.render_url).slice(0, 4)
  : [];
const admin = Boolean(user && (user.platformAdmin || user.globalCollectionScope || ["owner", "editor", "economy_admin"].includes(user.role)));
const steps = [
  { title: "What Foilbury is", body: "A free collectible-card album. Loftwah's original worlds are the public showcase; the curated members' album holds the larger launch catalogue." },
  { title: "A real set", body: "Collections are branded worlds with a roster, a mark and a release boundary — not tags around a grid." },
  { title: "Free play", body: "Claim the allowance, see the exact price and live odds, then choose to open. Nothing is purchasable." },
  { title: "Inspect the object", body: "Front, designed back, finish comparison and an on-demand 3D view. Reduced motion gets a clean static inspection." },
  { title: "Progress and mastery", body: "Unique subjects, owned copies, duplicates and each core finish are separate facts. A complete roster is not the same as a complete finish run." },
  { title: "Show it off", body: "Create a preview-first share for a card, collection, badge or wishlist. Member material stays behind membership." },
];
const fmtDuration = (seconds: number) => seconds >= 3600 ? `${Math.round(seconds / 3600)} hours` : `${Math.round(seconds / 60)} minutes`;
---
<BaseLayout title="The guided tour · Foilbury" description="A short, real tour of Foilbury: the public showcase, a branded set, free play, card inspection, collection mastery and deliberate sharing." shareImage={hero?.variant.render_url ?? "/brand/social-preview.jpg"}>
  <section class="signal-rule" aria-hidden="true"></section>
  <section class="container py-10 md:py-14">
    <div class="grid min-w-0 grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:items-start">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <span class="badge badge-signal">Guided tour</span>
          <span class="badge">Six sections</span>
        </div>
        <h1 class="display mt-4 text-[clamp(2rem,7vw,5.5rem)] uppercase [overflow-wrap:anywhere]">See the whole cabinet.</h1>
        <p class="mt-3 max-w-2xl text-[var(--muted)]">Explore collections, opening cards, finishing a set and sharing what you find.</p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a class="btn btn-signal max-w-full text-center" href={`#step-${step}`}>{step === 1 ? "Start the tour" : `Go to section ${step}`}</a>
          <a class="btn btn-secondary max-w-full text-center" href="/cabinet">Skip to the public cabinet</a>
          {admin ? <a class="btn btn-secondary" href="/studio">Open the Studio</a> : null}
        </div>
      </div>
      <div class="border border-[var(--line)] bg-[var(--paper-2)]/45 p-5">
        <p class="studio-stat__label">Jump to a section</p>
        <ol class="mt-3 grid gap-2">
          {steps.map((item, index) => (
            <li><a class="flex min-h-11 items-center gap-3 text-sm underline-offset-4 hover:underline" href={`#step-${index + 1}`}><span class="grid h-6 w-6 shrink-0 place-items-center border border-[var(--line-strong)] font-mono text-[0.62rem] text-[var(--muted)]" aria-hidden="true">{index + 1}</span><span>{item.title}</span></a></li>
          ))}
        </ol>
        <div class="mt-5 border-t border-[var(--line)] pt-4 text-xs leading-relaxed text-[var(--muted)]">
          <p>Nothing in this tour spends Foil, draws a card or grants a reward. Every number is read from the live public catalogue.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="container pb-12">
    <article id="step-1" class="tour-step" tabindex="-1">
      <div class="tour-step__index">01</div>
      <div>
        <h2 class="display-sm text-[clamp(1.35rem,6vw,1.875rem)] uppercase">Start with the public front door.</h2>
        <p class="mt-3 max-w-3xl text-[var(--muted)]">The public showcase is deliberately small and approved: {collections.length} original Loftwah worlds, {stats.cards} cards and {stats.variants} published finishes. The 17-property launch album is members-only and is never used as public SEO bait.</p>
        <div class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
          {collections.map((collection) => (
            <a class="border border-[var(--line)] bg-[var(--paper)] p-4 no-underline transition-colors hover:border-[var(--ink)]" href={`/cabinet?collection=${collection.slug}`}>
              <div class="flex min-w-0 flex-wrap items-center gap-3">
                {collection.logo_url ? <img src={collection.logo_url} alt="" class="h-10 w-10 object-contain" width="40" height="40" /> : null}
                <div class="min-w-0 break-words"><p class="font-semibold">{collection.name}</p><p class="font-mono text-[0.56rem] uppercase tracking-[0.1em] text-[var(--muted)]">{collection.card_count} public cards</p></div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </article>

    <article id="step-2" class="tour-step" tabindex="-1">
      <div class="tour-step__index">02</div>
      <div>
        <h2 class="display-sm text-[clamp(1.35rem,6vw,1.875rem)] uppercase">A set has a mark, not just a grid.</h2>
        <p class="mt-3 max-w-3xl text-[var(--muted)]">Each collection carries a readable emblem, palette, description, source boundary and a frozen release roster. The card front and back use the same mark so the set is recognisable before the name is read.</p>
        <div class="mt-5 grid gap-4 lg:grid-cols-[0.9fr_1.1fr]">
          <div class="border border-[var(--line)] bg-[var(--paper)] p-4">
            <div class="flex min-w-0 flex-wrap items-center gap-4">
              {collections[0]?.logo_url ? <img src={collections[0].logo_url} alt="" class="h-16 w-16 object-contain" width="64" height="64" /> : null}
              <div class="min-w-0 break-words"><p class="display-sm text-2xl uppercase">{collections[0]?.name ?? "Foilbury world"}</p><p class="font-mono text-[0.58rem] uppercase tracking-[0.1em] text-[var(--muted)]">{collections[0]?.card_count ?? 0} cards · public showcase</p></div>
            </div>
            <p class="mt-3 text-sm text-[var(--muted)]">{collections[0]?.description ?? "A curated world."}</p>
          </div>
          <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
            {finishExamples.map((variant) => (
              <div class="border border-[var(--line)] bg-[var(--paper)] p-1">
                {variant.render_url ? <img src={variant.render_url} alt={`${hero?.card.name} in ${displayFinish(variant.name, variant.material_key, variant.effect_key)}`} class="aspect-[5/7] w-full object-cover" loading="lazy" width="150" height="210" /> : null}
                <p class="mt-1 font-mono text-[0.5rem] uppercase tracking-[0.06em] text-[var(--muted)]">{displayFinish(variant.name, variant.material_key, variant.effect_key)}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </article>

    <article id="step-3" class="tour-step" tabindex="-1">
      <div class="tour-step__index">03</div>
      <div>
        <h2 class="display-sm text-[clamp(1.35rem,6vw,1.875rem)] uppercase">Free play, with the odds in front of you.</h2>
        <p class="mt-3 max-w-3xl text-[var(--muted)]">The cabinet grants {economy?.starter_grant ?? 800} Foil on first entry and {economy?.daily_reward ?? 480} Foil each {fmtDuration(economy?.daily_cooldown_seconds ?? 86400)}. You choose a capsule, see its price and eligible pool, then open one real card. No purchase, no cash-out, no hidden reroll.</p>
        <div class="mt-5 grid gap-3 sm:grid-cols-3">
          <div class="tour-callout"><p class="studio-stat__label">Before the draw</p><p class="mt-1 text-sm">Exact price, balance, eligible variants and finish odds.</p></div>
          <div class="tour-callout"><p class="studio-stat__label">At the draw</p><p class="mt-1 text-sm">One server-committed receipt, one serial, one spend.</p></div>
          <div class="tour-callout"><p class="studio-stat__label">After</p><p class="mt-1 text-sm">New subject, new finish or duplicate; progress and next goal.</p></div>
        </div>
        <a class="btn btn-primary mt-5" href={user ? "/play/draw" : "/login?next=%2Fplay%2Fdraw"}>{user ? "Open the draw room" : "Sign in to open a capsule"}</a>
      </div>
    </article>

    <article id="step-4" class="tour-step" tabindex="-1">
      <div class="tour-step__index">04</div>
      <div>
        <h2 class="display-sm text-[clamp(1.35rem,6vw,1.875rem)] uppercase">Inspect both faces.</h2>
        <p class="mt-3 max-w-3xl text-[var(--muted)]">The front is the card; the back is the file. Flip, tilt and zoom this real public card. The 3D view is an inspection aid only — it never changes ownership, finish or serial. Reduced motion keeps a clean static view.</p>
        {hero ? (
          <div class="mt-5 grid gap-5 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
            <CardInspector client:load frontUrl={hero.variant.render_url} backUrl={hero.variant.back_render_url} fallbackUrl="/brand/card-back.webp" name={hero.card.name} subtitle={hero.card.subtitle} finish={displayFinish(hero.variant.name, hero.variant.material_key, hero.variant.effect_key)} collection={hero.card.collections[0]?.name ?? null} serial={null} />
            <div class="border border-[var(--line)] bg-[var(--paper)] p-5">
              <p class="display-sm text-2xl uppercase">{hero.card.name}</p>
              <p class="mt-1 text-sm text-[var(--muted)]">{hero.card.subtitle}</p>
              <p class="mt-4 text-sm leading-relaxed text-[var(--muted)]">{hero.card.bio_safe ?? hero.card.description}</p>
              <p class="mt-4 font-mono text-[0.58rem] uppercase tracking-[0.1em] text-[var(--muted)]">Real public card · rendered front and designed back</p>
              <a class="btn btn-secondary btn-sm mt-4" href={`/cabinet/${hero.card.slug}`}>Open the full card page</a>
            </div>
          </div>
        ) : <p class="empty mt-5">No public card with a front and back is available yet.</p>}
      </div>
    </article>

    <article id="step-5" class="tour-step" tabindex="-1">
      <div class="tour-step__index">05</div>
      <div>
        <h2 class="display-sm text-[clamp(1.35rem,6vw,1.875rem)] uppercase">Roster, copies, finishes — three different truths.</h2>
        <p class="mt-3 max-w-3xl text-[var(--muted)]">A collection can be 8/8 subjects while only 11/32 core variants are held. The album shows unique subjects, owned copies, duplicates and each finish separately. Achievements can be lifetime-earned while current ownership changes after a trade.</p>
        <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {[["Roster", "Unique subjects ever owned", "Permanent"], ["Copies", "Every owned instance", "Can grow with duplicates"], ["Core finishes", "Plain, Silver, Gold, Holographic", "Per subject"], ["Mastery", "All subjects × all four finishes", "Freezes the release roster"]].map(([title, body, note]) => (
            <div class="border border-[var(--line)] bg-[var(--paper)] p-4"><p class="font-semibold">{title}</p><p class="mt-1 text-sm text-[var(--muted)]">{body}</p><p class="mt-2 font-mono text-[0.54rem] uppercase tracking-[0.08em] text-[var(--signal)]">{note}</p></div>
          ))}
        </div>
        <div class="mt-5 flex flex-wrap gap-2"><a class="btn btn-secondary btn-sm" href={user ? "/play/achievements" : "/login?next=%2Fplay%2Fachievements"}>See the achievement cabinet</a><a class="btn btn-ghost btn-sm" href={user ? "/play/collections" : "/cabinet"}>Browse worlds</a></div>
      </div>
    </article>

    <article id="step-6" class="tour-step" tabindex="-1">
      <div class="tour-step__index">06</div>
      <div>
        <h2 class="display-sm text-[clamp(1.35rem,6vw,1.875rem)] uppercase">Share only what is permitted.</h2>
        <p class="mt-3 max-w-3xl text-[var(--muted)]">A share starts with a preview of exactly what the viewer gets. Public-safe cards can travel; member cards stay behind membership. The link can be revoked, but a downloaded or Discord-hosted image cannot be recalled — the preview says so before you create it.</p>
        <div class="mt-5 grid gap-4 lg:grid-cols-[1fr_1fr]">
          <div class="border border-[var(--line)] bg-[var(--paper)] p-5">
            <p class="studio-stat__label">Safe defaults</p>
            <ul class="mt-3 grid gap-2 text-sm text-[var(--muted)]">
              <li>Personal share pages are <code>noindex</code> and use generic metadata.</li>
              <li>A secret URL never replaces membership authorisation.</li>
              <li>Mixed public/private collages fail closed to the most restrictive item.</li>
              <li>No auto-posting to social accounts.</li>
            </ul>
          </div>
          <div class="border border-[var(--line)] bg-[var(--paper)] p-5">
            <p class="studio-stat__label">Try the real thing</p>
            <p class="mt-3 text-sm text-[var(--muted)]">Open your album, choose a card or badge, and use its Share panel. For now you can inspect a real public card without an account.</p>
            <div class="mt-4 flex flex-wrap gap-2">{hero ? <a class="btn btn-primary btn-sm" href={`/cabinet/${hero.card.slug}`}>Inspect a public card</a> : null}<a class="btn btn-secondary btn-sm" href={user ? "/play" : "/login?next=%2Fplay"}>Open my album</a></div>
          </div>
        </div>
      </div>
    </article>

    <nav class="mt-8 flex flex-wrap items-center justify-between gap-3 border-t-2 border-[var(--ink)] pt-5" aria-label="End of tour">
      <a class="btn btn-secondary btn-sm" href="#step-1">Back to the start</a>
      <p class="text-sm text-[var(--muted)]">You've reached the end of the tour.</p>
      <a class="btn btn-signal btn-sm" href={user ? "/play" : "/login?next=%2Fplay"}>{user ? "Open my album →" : "Sign in to play →"}</a>
    </nav>

    {admin ? (
      <section class="mt-10 border border-[var(--line)] bg-[var(--paper-2)]/45 p-5">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div><p class="studio-kicker text-[var(--teal)]">Private operator appendix</p><h3 class="display-sm mt-2 text-2xl uppercase">Your scoped controls are separate.</h3><p class="mt-2 max-w-2xl text-sm text-[var(--muted)]">The Studio is a normal signed-in Foilbury session with live role checks. Platform Administration remains Cloudflare Access plus the provisioned Super Admin. EmDash remains the editorial console. Do not show this appendix in a spectator channel.</p></div>
          <div class="flex flex-wrap gap-2"><a class="btn btn-primary btn-sm" href="/studio">Studio</a>{user?.platformAdmin ? <a class="btn btn-secondary btn-sm" href="/platform-admin">Platform root</a> : null}<a class="btn btn-secondary btn-sm" href="/admin/editorial">EmDash</a></div>
        </div>
      </section>
    ) : null}
  </section>
</BaseLayout>
