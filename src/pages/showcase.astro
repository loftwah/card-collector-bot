---
import BaseLayout from "../layouts/BaseLayout.astro";
import { BRAND_ASSETS } from "../lib/brand-catalogue";
import { cabinetArtwork, characterArtwork, editorialShareImage } from "../lib/editorial-art";
import manifest from "../../public/media/showcase/manifest.json";

const media = (file: string) => `/media/showcase/${file}`;
const publicBrandShareIds = ["share-square", "share-portrait", "share-story", "share-banner"];
const brandImages = BRAND_ASSETS.filter((item) => publicBrandShareIds.includes(item.id));
const cardImages = [
  { file: "card-1x1-1080.png", title: "Square post", width: 1080, height: 1080 },
  { file: "card-4x5-1080.png", title: "Portrait post", width: 1080, height: 1350 },
  { file: "card-9x16-1080.png", title: "Story image", width: 1080, height: 1920 },
  { file: "card-16x9-1920.png", title: "Landscape post", width: 1920, height: 1080 },
  { file: "og-1200x630.png", title: "Link preview", width: 1200, height: 630 },
  { file: "finish-mastery-16x9-1920.png", title: "Card finishes", width: 1920, height: 1080 },
].map((item) => ({ ...item, path: media(item.file) }));
const videos = [
  {
    file: "foilbury-teaser-9x16.mp4",
    title: "Vertical teaser",
    poster: "card-9x16-1080.png",
    details: "1080 × 1920 · 8 seconds",
  },
  {
    file: "foilbury-trailer-16x9.mp4",
    title: "Landscape trailer",
    poster: "card-16x9-1920.png",
    details: "1920 × 1080 · 18 seconds",
  },
];
---

<BaseLayout
  title="Social images & videos · Foilbury"
  description="Download public Foilbury card images for posts and stories, plus the vertical teaser and landscape trailer."
  shareImage={editorialShareImage}
>
  <div class="container py-10 md:py-16">
    <a class="text-link" href="/brand-kit">
      Media kit
    </a>
    <h1 class="display-sm mt-3 text-4xl md:text-6xl">Social images &amp; videos</h1>
    <p class="mt-3 text-[var(--muted)]">
      Download Foilbury graphics for posts and stories, or share a clip from the original-card
      showcase.
    </p>
    <nav class="mt-5 flex flex-wrap gap-2" aria-label="Social downloads">
      <a class="btn btn-secondary" href="#illustrations">
        Illustrations
      </a>
      <a class="btn btn-secondary" href="#images">
        Brand graphics
      </a>
      <a class="btn btn-secondary" href="#card-images">
        Card images
      </a>
      <a class="btn btn-secondary" href="#videos">
        Videos
      </a>
    </nav>

    <section
      id="illustrations"
      class="editorial-art scroll-mt-24 border-t border-[var(--line)] pt-5"
    >
      <h2 class="mb-4 text-2xl font-semibold">Illustrations</h2>
      <div class="editorial-art__grid">
        {[cabinetArtwork, ...characterArtwork].map((art) => (
          <figure>
            <img
              src={art.src}
              alt={art.alt}
              width={art.width}
              height={art.height}
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <strong class="block">{art.title}</strong>
              <a href={art.source} aria-label={`View original artwork for ${art.title}`}>
                View original
              </a>
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="mt-3 text-sm text-[var(--muted)]">Woodhouse / Codex ImageGen</p>
    </section>

    {[
      {
        id: "images",
        title: "Brand graphics",
        images: brandImages.map((item) => ({
          path: item.path,
          title: item.label,
          width: item.width,
          height: item.height,
        })),
      },
      { id: "card-images", title: "Original-card showcase images", images: cardImages },
    ].map((group) => (
      <section id={group.id} class="mt-10 scroll-mt-24 border-t border-[var(--line)] pt-5">
        <h2 class="text-2xl font-semibold">{group.title}</h2>
        <ul class="mt-4 grid gap-x-5 gap-y-7 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {group.images.map((item) => (
            <li class="min-w-0">
              <a
                href={item.path}
                class="block"
                aria-label={`View ${item.title.toLowerCase()} at full size`}
              >
                <img
                  src={item.path}
                  alt=""
                  width={item.width}
                  height={item.height}
                  loading="lazy"
                  class="aspect-[4/3] w-full border border-[var(--line)] bg-[var(--panel)] object-contain"
                />
              </a>
              <div class="flex flex-wrap items-center justify-between gap-x-2 pt-2">
                <div>
                  <h3 class="font-semibold">{item.title}</h3>
                  <p class="text-sm text-[var(--muted)]">
                    {item.width} × {item.height}
                  </p>
                </div>
                <a
                  class="btn btn-secondary btn-sm min-h-11"
                  href={item.path}
                  aria-label={`Download ${item.title.toLowerCase()} PNG`}
                  download
                >
                  Download PNG
                </a>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section id="videos" class="mt-10 scroll-mt-24 border-t border-[var(--line)] pt-5">
      <h2 class="text-2xl font-semibold">Videos</h2>
      <ul class="mt-4 grid gap-6 sm:grid-cols-2">
        {videos.map((item) => (
          <li>
            <video
              class="block aspect-[4/3] w-full border border-[var(--line)] bg-black object-contain"
              controls
              preload="none"
              poster={media(item.poster)}
              aria-label={item.title}
              playsinline
            >
              <source src={media(item.file)} type="video/mp4" />
              <a href={media(item.file)} download>
                Download the video
              </a>
            </video>
            <div class="flex flex-wrap items-center justify-between gap-x-2 pt-2">
              <div>
                <h3 class="font-semibold">{item.title}</h3>
                <p class="text-sm text-[var(--muted)]">{item.details} · silent</p>
              </div>
              <a
                class="btn btn-secondary btn-sm min-h-11"
                href={media(item.file)}
                aria-label={`Download ${item.title.toLowerCase()} MP4`}
                download
              >
                Download MP4
              </a>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <p class="mt-10 border-t border-[var(--line)] pt-4 text-sm text-[var(--muted)]">
      Original showcase exports generated{" "}
      {new Date(manifest.generated_at).toLocaleDateString("en-AU", {
        dateStyle: "medium",
        timeZone: "Australia/Melbourne",
      })}{" "}
      ·{" "}
      <a class="text-link" href={media("manifest.json")} download>
        Download export details
      </a>
    </p>

    <section class="mt-10 scroll-mt-24 border-t border-[var(--line)] pt-5" aria-labelledby="studio-film">
      <h2 id="studio-film" class="text-2xl font-semibold">Foilbury in motion</h2>
      <div class="mt-4 grid gap-5 sm:grid-cols-2">
        <video
          class="block aspect-[4/3] w-full border border-[var(--line)] bg-black object-contain"
          controls
          preload="none"
          poster={media("foilbury-studio-poster.jpg")}
          aria-label="Foilbury project plate in motion"
          playsinline
        >
          <source src={media("foilbury-studio-motion.mp4")} type="video/mp4" />
          <a href={media("foilbury-studio-motion.mp4")} download>Download the video</a>
        </video>
        <div>
          <p>5.2 seconds · promotional illustration · includes audio</p>
          <p class="mt-3 text-[var(--muted)]">
            This AI-animated study was made in Media Studio with MiniMax H3 Max Turbo from the
            retained Woodhouse Share project plate. It is not a collectible print or an app recording.
          </p>
          <p class="mt-3 text-sm">
            <a class="text-link" href="https://media.loftwah.com/p/Z7_WEb7Tpt68x_cW">Studio film and provenance</a>
            · <a class="text-link" href="https://woodhouse.loftwah.com/api/v1/assets/atlas-plate-20-foilbury">Original artwork</a>
          </p>
          <a class="btn btn-secondary btn-sm mt-4 min-h-11" href={media("foilbury-studio-motion.mp4")} download>
            Download MP4
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
