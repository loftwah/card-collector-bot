---
import BaseLayout from "../layouts/BaseLayout.astro";
import manifest from "../../public/media/showcase/manifest.json";

const stills = manifest.outputs.filter((item) => item.file.endsWith(".png"));
const stillDescriptions: Record<string, string> = {
  "card-16x9-1920.png": "Drop Bear card and back in a landscape Foilbury showcase",
  "card-1x1-1080.png": "Drop Bear card in a square Foilbury showcase",
  "card-4x5-1080.png": "Drop Bear card in a portrait Foilbury showcase",
  "card-9x16-1080.png": "Drop Bear card in a vertical Foilbury showcase",
  "finish-mastery-16x9-1920.png": "Foilbury card finish mastery showcase",
  "og-1200x630.png": "Foilbury public showcase image",
};
const publicPath = (file: string) => `/${file.replace(/^public\//, "")}`;
const generated = new Date(manifest.generated_at);
const parts = Object.fromEntries(
  new Intl.DateTimeFormat("en-AU", {
    timeZone: "Australia/Melbourne",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    hourCycle: "h23",
  })
    .formatToParts(generated)
    .map(({ type, value }) => [type, value]),
);
const generatedLabel = `${parts.year}/${parts.month}/${parts.day} ${parts.hour}:${parts.minute} Australia/Melbourne · ${generated.toISOString().replace("T", " ").slice(0, 16).replaceAll("-", "/")} UTC`;
---

<BaseLayout
  title="Foilbury showcase · cards worth keeping"
  description="Explore Foilbury's public showcase, from original character cards to shareable stills and short films."
  shareImage="/media/showcase/og-1200x630.png"
>
  <section class="signal-rule" aria-hidden="true"></section>
  <section class="container py-8 md:py-16">
    <div class="grid gap-6 lg:grid-cols-[0.8fr_1.2fr] lg:items-center lg:gap-10">
      <div>
        <h1 class="display text-[clamp(2.75rem,6vw,6rem)] uppercase">Cards worth keeping.</h1>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-[var(--muted)]">
          Meet the characters, explore their cards and take a little of Foilbury with you.
          Everything here is from our public collection.
        </p>
      </div>
      <article>
        <video
          class="w-full border border-[var(--line)] bg-[var(--ink)]"
          controls
          preload="none"
          poster="/media/showcase/card-16x9-1920.png"
          playsinline
        >
          <source src="/media/showcase/foilbury-trailer-16x9.mp4" type="video/mp4" />
          Your browser cannot play this MP4.{" "}
          <a href="/media/showcase/foilbury-trailer-16x9.mp4">Download it instead.</a>
        </video>
        <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
          <div>
            <p class="font-semibold">A glimpse of Foilbury · 18 seconds</p>
            <p class="font-mono text-[0.56rem] uppercase tracking-[0.1em] text-[var(--muted)]">
              Silent · public collection
            </p>
          </div>
          <a
            class="btn btn-secondary btn-sm"
            href="/media/showcase/foilbury-trailer-16x9.mp4"
            download
          >
            Download MP4
          </a>
        </div>
      </article>
    </div>

    <section class="mt-12 grid gap-5 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="self-center">
        <h2 class="display-sm text-3xl uppercase">Made to share</h2>
        <p class="mt-3 max-w-xl leading-relaxed text-[var(--muted)]">
          Save a still or download the short vertical film. These images feature Foilbury's public
          original worlds; your member artwork and private receipts stay private.
        </p>
      </div>
      <article class="border border-[var(--line)] bg-[var(--paper)] p-3">
        <video
          class="mx-auto w-full max-w-[360px] border border-[var(--line)]"
          controls
          preload="none"
          poster="/media/showcase/card-9x16-1080.png"
          playsinline
        >
          <source src="/media/showcase/foilbury-teaser-9x16.mp4" type="video/mp4" />
          Your browser cannot play this MP4.{" "}
          <a href="/media/showcase/foilbury-teaser-9x16.mp4">Download it instead.</a>
        </video>
        <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
          <div>
            <p class="font-semibold">Silent social teaser · 8 seconds</p>
            <p class="font-mono text-[0.56rem] uppercase tracking-[0.1em] text-[var(--muted)]">
              1080×1920 · H.264 · silent
            </p>
          </div>
          <a
            class="btn btn-secondary btn-sm"
            href="/media/showcase/foilbury-teaser-9x16.mp4"
            download
          >
            Download 9:16
          </a>
        </div>
      </article>
    </section>

    <section class="mt-12">
      <div class="flex flex-wrap items-end justify-between gap-3 border-b-2 border-[var(--ink)] pb-3">
        <h2 class="display-sm text-3xl uppercase">Stills and crops</h2>
        <p class="font-mono text-[0.6rem] uppercase tracking-[0.12em] text-[var(--muted)]">
          1:1 · 4:5 · 9:16 · 16:9 · 1200×630
        </p>
      </div>
      <div class="mt-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {stills.map((item) => (
          <article class="border border-[var(--line)] bg-[var(--paper)] p-3">
            <img
              src={publicPath(item.file)}
              alt={
                stillDescriptions[item.file.split("/").pop() ?? ""] ??
                "Foilbury public showcase still"
              }
              loading="lazy"
              class="w-full border border-[var(--line)]"
            />
            <div class="mt-2 flex items-center justify-between gap-2">
              <p class="font-mono text-[0.56rem] uppercase tracking-[0.08em] text-[var(--muted)]">
                {item.file.split("/").pop()} · {(item.bytes / 1024).toFixed(0)} KB
              </p>
              <a class="btn btn-ghost btn-sm" href={publicPath(item.file)} download>
                Download
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <details class="mt-10 border-t border-[var(--line)] pt-5">
      <summary class="cursor-pointer font-semibold">Export details</summary>
      <p class="mt-3 text-sm text-[var(--muted)]">
        Source commit <span class="font-mono">{manifest.source_commit.slice(0, 12)}</span> ·
        generated {generatedLabel}. The manifest records a SHA-256 for each output.
      </p>
      <div class="mt-4 flex flex-wrap gap-2">
        <a class="btn btn-secondary btn-sm" href="/media/showcase/manifest.json" download>
          Download manifest
        </a>
        <a class="btn btn-secondary btn-sm" href="/brand-kit">
          Brand kit
        </a>
      </div>
    </details>

    <section class="mt-10 grid gap-5 md:grid-cols-2">
      <div class="border border-[var(--line)] p-5">
        <h2 class="display-sm text-2xl uppercase">What is safe to share</h2>
        <ul class="mt-3 grid gap-2 text-sm text-[var(--muted)]">
          <li>The four approved original-IP worlds and these public renders.</li>
          <li>The brand kit marks, avatars, wordmarks and banners.</li>
          <li>Your own member share link, with a preview before you publish it.</li>
        </ul>
      </div>
      <div class="border border-[var(--line)] p-5">
        <h2 class="display-sm text-2xl uppercase">What is not</h2>
        <ul class="mt-3 grid gap-2 text-sm text-[var(--muted)]">
          <li>Member-only franchise art, rosters, bios or badge names in a public post.</li>
          <li>Another member's inventory, wallet, serials or private receipt.</li>
          <li>
            The private opening replay under <code>.foilbury/exports</code>; it is a local demo, not
            marketing.
          </li>
        </ul>
      </div>
    </section>
  </section>
</BaseLayout>
