---
import BaseLayout from "../layouts/BaseLayout.astro";
import manifest from "../../public/brand/kit/manifest.json";

const identity = manifest.identity;
const palette = identity?.palette ?? [];
const asset = (id: string) => identity?.assets?.find((item: { id: string }) => item.id === id)?.path;
const mark = asset("mark-1024") ?? "/brand/kit/foil-standard/mark-1024.png";
const markTransparent = asset("mark-transparent-1024") ?? "/brand/kit/foil-standard/mark-transparent-1024.png";
const wordmark = asset("wordmark-png") ?? "/brand/wordmark.png";
const wordmarkReverse = asset("wordmark-reverse") ?? "/brand/wordmark-reverse.png";
const og = asset("social-og-png") ?? "/brand/kit/social/og-1200x630.png";
const banner = asset("banner-1920") ?? "/brand/kit/banners/foil-standard-1920x1080.png";
const avatar = asset("discord-avatar") ?? "/brand/discord-avatar.png";
const cardBack = asset("card-back") ?? "/brand/card-back.webp";
---

<BaseLayout
  title="Brand kit · Foilbury"
  description="The Foil Standard: Foilbury's monochrome identity, Geist type, foil-blue signal, app icon, Discord assets and social previews."
  shareImage={og}
>
  <section class="brand-hero">
    <div class="container brand-hero__grid">
      <div class="brand-hero__copy">
        <h1 class="brand-hero__title">The Foil Standard.</h1>
        <p class="brand-hero__lede">
          A monochrome archive with one electric foil edge. Geist Serif gives the cabinet its
          voice; Geist Sans and Mono keep the odds, serials and controls exact.
        </p>
        <div class="brand-hero__actions">
          <a class="btn btn-invert" href="#downloads">Download the kit</a>
          <a class="btn btn-invert-outline" href="/">See it live</a>
        </div>
        <dl class="brand-hero__facts">
          <div><dt>Identity</dt><dd>Foil Standard</dd></div>
          <div><dt>Type</dt><dd>Geist Serif / Sans / Mono</dd></div>
          <div><dt>Signal</dt><dd>Foil blue #1F5EFF</dd></div>
          <div><dt>Licence</dt><dd>SIL OFL 1.1</dd></div>
        </dl>
      </div>
      <div class="brand-hero__mark">
        <div class="brand-hero__tile">
          <img src={mark} width="1024" height="1024" alt="The Foilbury mark: a paper F over a foil-blue card plane" />
          <span class="brand-hero__holo" aria-hidden="true"></span>
        </div>
        <p class="brand-hero__caption">The mark · paper F over foil plane · chamfered fold</p>
      </div>
    </div>
  </section>

  <section class="brand-section" id="mark">
    <div class="container">
      <div class="brand-section__head">
        <h2>The mark.</h2>
        <p>
          Two card planes, one fold. The paper F sits over a foil-blue plane and the top-right
          corner is chamfered like a turned card. It reads as an F at 16px and as a stacked card at
          512px. Use the opaque icon where the platform applies its own mask.
        </p>
      </div>
      <div class="brand-marks">
        <figure class="brand-mark-card brand-mark-card--ink">
          <img src={mark} width="1024" height="1024" alt="Foilbury app icon on ink" loading="lazy" />
          <figcaption><span>Primary icon</span><span>Ink ground</span></figcaption>
        </figure>
        <figure class="brand-mark-card brand-mark-card--paper">
          <img src="/brand/kit/systems/foil-standard/icon-light-1024.png" width="1024" height="1024" alt="Foilbury mark on paper" loading="lazy" />
          <figcaption><span>Light ground</span><span>Paper / ink / foil</span></figcaption>
        </figure>
        <figure class="brand-mark-card brand-mark-card--mono">
          <img src={markTransparent} width="1024" height="1024" alt="Foilbury mark with a transparent background" loading="lazy" />
          <figcaption><span>Transparent</span><span>For authored grounds</span></figcaption>
        </figure>
      </div>
      <div class="brand-mark-meta">
        <div>
          <h3>Small sizes</h3>
          <div class="brand-size-row" aria-label="Mark at shipping sizes">
            <span><img src="/brand/favicon-16.png" width="16" height="16" alt="" /> 16</span>
            <span><img src="/brand/favicon-32.png" width="32" height="32" alt="" /> 32</span>
            <span><img src="/brand/favicon-48.png" width="48" height="48" alt="" /> 48</span>
            <span><img src="/brand/icon-192.png" width="64" height="64" alt="" /> 192</span>
          </div>
        </div>
        <div>
          <h3>Clearspace</h3>
          <p>Keep one third of the F height clear on every side. Never redraw, recolour or add a glow to the mark.</p>
        </div>
        <div id="downloads">
          <h3>Download</h3>
          <p class="brand-links">
            <a href={mark} download>PNG</a>
            <a href="/brand/kit/foil-standard/mark.svg" download>SVG</a>
            <a href="/brand/kit/foil-standard/glyph.svg" download>Glyph</a>
            <a href="/brand/kit/manifest.json" download>Manifest</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="brand-section brand-section--ink" id="type">
    <div class="container">
      <div class="brand-section__head brand-section__head--invert">
        <h2>The type.</h2>
        <p>
          Geist Serif carries the display voice: sentence case, tight tracking, generous scale.
          Geist Sans runs the interface. Geist Mono is reserved for serials, odds, labels and
          provenance. All three are self-hosted under the SIL Open Font License 1.1.
        </p>
      </div>
      <div class="brand-type">
        <div class="brand-type__row">
          <span class="brand-type__label">Display · Geist Serif 500</span>
          <p class="brand-type__serif">Characters worth keeping.</p>
        </div>
        <div class="brand-type__row">
          <span class="brand-type__label">Interface · Geist Sans</span>
          <p class="brand-type__sans">
            Open a capsule, keep the copy, and arrange a shelf that is yours.
          </p>
        </div>
        <div class="brand-type__row">
          <span class="brand-type__label">Data · Geist Mono</span>
          <p class="brand-type__mono">
            FB-1-DE-513D6B · PLAIN · 0.40% SHOWN CHANCE · 80 FOIL
          </p>
        </div>
      </div>
      <div class="brand-wordmarks">
        <figure><img src={wordmark} width="1600" height="400" alt="Foilbury wordmark on paper" loading="lazy" /></figure>
        <figure><img src={wordmarkReverse} width="1600" height="400" alt="Foilbury wordmark on ink" loading="lazy" /></figure>
      </div>
    </div>
  </section>

  <section class="brand-section" id="colour">
    <div class="container">
      <div class="brand-section__head">
        <h2>The colour.</h2>
        <p>
          Paper, ink, graphite and a hairline rule carry the surface. Foil blue is the one signal:
          links, focus, the mark edge and the active state. The holo gradient appears once per
          surface, on an edge, never as text.
        </p>
      </div>
      <div class="brand-swatches">
        {palette.map((colour: { name: string; hex: string; role: string }) => (
          <div class="brand-swatch">
            <span class="brand-swatch__chip" style={`background:${colour.hex}`} aria-hidden="true"></span>
            <strong>{colour.name}</strong>
            <code>{colour.hex}</code>
            <p>{colour.role}</p>
          </div>
        ))}
        <div class="brand-swatch brand-swatch--holo">
          <span class="brand-swatch__chip brand-swatch__chip--holo" aria-hidden="true"></span>
          <strong>Holo edge</strong>
          <code>8BE9FF → 1F5EFF → B18CFF → E9FF8A</code>
          <p>The one material flourish: a 2–4px edge, never a fill.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="brand-section brand-section--paper" id="surfaces">
    <div class="container">
      <div class="brand-section__head">
        <h2>The surfaces.</h2>
        <p>
          Social previews, the Discord application, the server banner and the card back all use the
          same ink field, the same mark and the same foil edge.
        </p>
      </div>
      <figure class="brand-social">
        <img src={og} width="1200" height="630" alt="Foilbury social preview with the serif headline Characters worth keeping" loading="lazy" />
        <figcaption><span>Open Graph / Twitter · 1200 × 630</span><a href={og} download>Download PNG</a></figcaption>
      </figure>
      <div class="brand-surface-grid">
        <figure class="brand-surface">
          <img src={avatar} width="512" height="512" alt="Foilbury Discord application avatar" loading="lazy" />
          <figcaption><span>Discord avatar</span><span>512 × 512</span></figcaption>
        </figure>
        <figure class="brand-surface brand-surface--wide">
          <img src={banner} width="1920" height="1080" alt="Foilbury Discord banner with the wordmark and card edge" loading="lazy" />
          <figcaption><span>Discord banner</span><span>1920 × 1080 · 960 × 540</span></figcaption>
        </figure>
        <figure class="brand-surface brand-surface--card">
          <img src={cardBack} width="750" height="1050" alt="Foilbury card back" loading="lazy" />
          <figcaption><span>Card back</span><span>750 × 1050</span></figcaption>
        </figure>
        <figure class="brand-surface brand-surface--downloads">
          <div>
            <h3>Ready-to-ship files</h3>
            <p>
              Every asset is deterministic, local and generated from the same masters. No paid
              generation and no stock imagery.
            </p>
            <p class="brand-links">
              <a href={og} download>Open Graph</a>
              <a href={banner} download>Banner</a>
              <a href={avatar} download>Avatar</a>
              <a href={cardBack} download>Card back</a>
            </p>
          </div>
        </figure>
      </div>
    </div>
  </section>

  <section class="brand-section" id="voice">
    <div class="container brand-voice">
      <div>
        <h2>Say the thing.</h2>
        <p>
          Foilbury sounds like a good shopkeeper: specific, calm and a little delighted. Name the
          action, name the cost, name the recovery. No invented rarity, no fake urgency, no
          investment language.
        </p>
      </div>
      <blockquote>
        “Free to play. Earned Foil only. The odds are on the label.”
      </blockquote>
    </div>
  </section>

  <section class="brand-close">
    <div class="container brand-close__inner">
      <h2>Use it well.</h2>
      <p>
        The complete manifest records every file, dimension and intended use. The historical
        systems remain in the kit as reference, not as active identities.
      </p>
      <div class="brand-close__actions">
        <a class="btn btn-invert" href="/brand/kit/manifest.json" download>Download the manifest</a>
        <a class="btn btn-invert-outline" href="/brand/kit/selection.json" download>Read the selection record</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .brand-hero {
    background: #0a0a0a;
    color: #fafaf8;
  }

  .brand-hero__grid {
    display: grid;
    gap: 3rem;
    padding-block: 4rem 5rem;
  }

  @media (min-width: 900px) {
    .brand-hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: center;
      gap: 5rem;
      padding-block: 6rem 7rem;
    }
  }

  .brand-hero__title {
    max-width: 9ch;
    font-family: var(--font-display);
    font-size: clamp(3.6rem, 8vw, 8rem);
    font-weight: 500;
    line-height: 0.88;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .brand-hero__lede {
    max-width: 38rem;
    margin-top: 1.5rem;
    color: #a3a39e;
    font-size: 1.08rem;
    line-height: 1.65;
  }

  .brand-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.9rem;
  }

  .brand-hero__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid #2a2a2a;
  }

  .brand-hero__facts div {
    display: grid;
    gap: 0.2rem;
  }

  .brand-hero__facts dt {
    color: #8a8a84;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .brand-hero__facts dd {
    margin: 0;
    font-size: 0.9rem;
  }

  .brand-hero__mark {
    min-width: 0;
  }

  .brand-hero__tile {
    position: relative;
    overflow: hidden;
    border: 1px solid #2a2a2a;
    background: #0e0e0e;
  }

  .brand-hero__tile img {
    display: block;
    width: 100%;
    height: auto;
  }

  .brand-hero__holo {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 5px;
    background: var(--holo);
  }

  .brand-hero__caption {
    margin-top: 0.8rem;
    color: #8a8a84;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .brand-section {
    padding-block: 4.5rem;
    border-bottom: 1px solid var(--line);
  }

  .brand-section--ink {
    background: #0a0a0a;
    color: #fafaf8;
    border-bottom-color: #2a2a2a;
  }

  .brand-section--paper {
    background: var(--paper-2);
  }

  .brand-section__head {
    display: grid;
    gap: 1rem;
    max-width: 68rem;
    margin-bottom: 2.25rem;
  }

  @media (min-width: 900px) {
    .brand-section__head {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: start;
      gap: 4rem;
    }
  }

  .brand-section__head h2,
  .brand-voice h2,
  .brand-close h2 {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 5vw, 4.6rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .brand-section__head p {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  .brand-section__head--invert p {
    color: #a3a39e;
  }

  .brand-marks {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 720px) {
    .brand-marks {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .brand-mark-card {
    margin: 0;
    border: 1px solid var(--line);
  }

  .brand-mark-card img {
    display: block;
    width: 100%;
    height: auto;
  }

  .brand-mark-card--paper {
    background: var(--paper);
  }

  .brand-mark-card--mono {
    display: grid;
    place-items: center;
    background: var(--paper-2);
  }

  .brand-mark-card--mono img {
    width: 58%;
    height: auto;
    margin: 3rem auto;
  }

  .brand-mark-card figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0.9rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .brand-mark-meta {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-strong);
  }

  @media (min-width: 760px) {
    .brand-mark-meta {
      grid-template-columns: 1.1fr 1fr 0.9fr;
      gap: 2.5rem;
    }
  }

  .brand-mark-meta h3 {
    margin-bottom: 0.5rem;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .brand-mark-meta p {
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .brand-size-row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 1rem;
  }

  .brand-size-row span {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
  }

  .brand-size-row img {
    display: block;
    border: 1px solid var(--line-strong);
  }

  .brand-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
  }

  .brand-links a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .brand-type {
    border-top: 1px solid #2a2a2a;
  }

  .brand-type__row {
    display: grid;
    gap: 0.6rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid #2a2a2a;
  }

  @media (min-width: 760px) {
    .brand-type__row {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: 2rem;
      align-items: baseline;
    }
  }

  .brand-type__label {
    color: #8a8a84;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .brand-type__serif {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 5.2vw, 5rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .brand-type__sans {
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .brand-type__mono {
    font-family: var(--font-mono);
    font-size: clamp(0.9rem, 1.8vw, 1.2rem);
    letter-spacing: 0.08em;
    line-height: 1.6;
    color: #8fb0ff;
  }

  .brand-wordmarks {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  @media (min-width: 760px) {
    .brand-wordmarks {
      grid-template-columns: 1fr 1fr;
    }
  }

  .brand-wordmarks figure {
    margin: 0;
    border: 1px solid #2a2a2a;
  }

  .brand-wordmarks img {
    display: block;
    width: 100%;
    height: auto;
  }

  .brand-swatches {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 700px) {
    .brand-swatches {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .brand-swatches {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  .brand-swatch {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }

  .brand-swatch__chip {
    display: block;
    height: 6.5rem;
    border: 1px solid var(--line);
  }

  .brand-swatch__chip--holo {
    background: var(--holo);
  }

  .brand-swatch strong {
    font-size: 0.86rem;
  }

  .brand-swatch code {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .brand-swatch p {
    color: var(--muted);
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .brand-social {
    margin: 0;
    border: 1px solid var(--line);
    background: #0a0a0a;
  }

  .brand-social img {
    display: block;
    width: 100%;
    height: auto;
  }

  .brand-social figcaption,
  .brand-surface figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 0.75rem 0.9rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .brand-surface-grid {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  @media (min-width: 800px) {
    .brand-surface-grid {
      grid-template-columns: 1fr 1.6fr;
    }
  }

  .brand-surface {
    margin: 0;
    border: 1px solid var(--line);
    background: #0a0a0a;
  }

  .brand-surface img {
    display: block;
    width: 100%;
    height: auto;
  }

  .brand-surface--wide {
    align-self: start;
  }

  .brand-surface--wide img {
    height: auto;
    object-fit: contain;
  }

  .brand-surface--card {
    max-width: 22rem;
    align-self: start;
  }

  .brand-surface--downloads {
    display: grid;
    place-items: center;
    padding: 2rem;
    background: var(--paper);
    color: var(--ink);
  }

  .brand-surface--downloads h3 {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .brand-surface--downloads p {
    max-width: 30rem;
    margin-top: 0.6rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .brand-voice {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .brand-voice {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 5rem;
      align-items: start;
    }
  }

  .brand-voice p {
    max-width: 36rem;
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  .brand-voice blockquote {
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--line-strong);
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.4vw, 3rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .brand-close {
    background: #0a0a0a;
    color: #fafaf8;
  }

  .brand-close__inner {
    display: grid;
    gap: 1.5rem;
    padding-block: 5rem 5.5rem;
  }

  .brand-close p {
    max-width: 42rem;
    color: #a3a39e;
    font-size: 1rem;
    line-height: 1.65;
  }

  .brand-close__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 0.5rem;
  }

  @media (max-width: 520px) {
    .brand-hero__actions .btn,
    .brand-close__actions .btn {
      width: 100%;
    }
  }
</style>
