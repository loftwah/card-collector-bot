---
import BaseLayout from "../layouts/BaseLayout.astro";
import manifest from "../../public/brand/kit/manifest.json";

const system = manifest.systems.find((item) => item.slug === "signal-fold");
if (!system) throw new Error("Signal Fold brand assets are missing");
const asset = (id: string) => {
  const item = system.assets.find((entry) => entry.id === id);
  if (!item) throw new Error(`Missing Signal Fold asset: ${id}`);
  return item.path;
};
---

<BaseLayout title="Brand kit · Foilbury" description="Download Foilbury's marks, icons and banner artwork." shareImage="/brand/kit/social/og-1200x630.png">
  <section class="signal-rule" aria-hidden="true"></section>
  <div class="container brand-kit">
    <header class="brand-kit__hero">
      <div class="brand-kit__intro">
        <h1 class="display">Foilbury brand kit.</h1>
        <p>Our marks, colours and artwork for sharing the collectible card cabinet.</p>
        <a class="btn btn-primary" href="#downloads">Explore the kit</a>
      </div>
      <div class="brand-kit__mark">
        <img src={asset("icon-512")} width="512" height="512" alt="Foilbury's Signal Fold icon" />
      </div>
    </header>

    <section class="brand-kit__section" id="downloads" aria-labelledby="marks-heading">
      <div class="brand-kit__heading">
        <div><h2 class="display-sm" id="marks-heading">The mark</h2><p>Use the full-colour icon where space allows. Transparent and monochrome versions are available for other backgrounds.</p></div>
      </div>
      <div class="brand-kit__assets">
        <article class="brand-kit__asset">
          <div class="brand-kit__preview brand-kit__preview--dark"><img src={asset("icon-512")} width="192" height="192" alt="Full-colour Foilbury icon" loading="lazy" /></div>
          <div class="brand-kit__asset-info"><h3>Full colour</h3><div><a href={asset("icon-1024")} download aria-label="Download full-colour icon as PNG">PNG</a><a href={asset("icon-svg")} download aria-label="Download full-colour icon as SVG">SVG</a></div></div>
        </article>
        <article class="brand-kit__asset">
          <div class="brand-kit__preview brand-kit__preview--light"><img src={asset("icon-light-1024")} width="192" height="192" alt="Foilbury icon on a light background" loading="lazy" /></div>
          <div class="brand-kit__asset-info"><h3>Light background</h3><div><a href={asset("icon-light-1024")} download aria-label="Download light-background icon as PNG">PNG</a><a href={asset("icon-light-svg")} download aria-label="Download light-background icon as SVG">SVG</a></div></div>
        </article>
        <article class="brand-kit__asset">
          <div class="brand-kit__preview brand-kit__preview--neutral"><img src={asset("icon-transparent-1024")} width="192" height="192" alt="Foilbury icon with a transparent background" loading="lazy" /></div>
          <div class="brand-kit__asset-info"><h3>Transparent</h3><div><a href={asset("icon-transparent-1024")} download aria-label="Download transparent icon as PNG">PNG</a><a href={asset("icon-transparent-svg")} download aria-label="Download transparent icon as SVG">SVG</a></div></div>
        </article>
      </div>
      <p class="brand-kit__more">Monochrome: <a href={asset("icon-mono-dark-svg")} download>dark SVG</a> · <a href={asset("icon-mono-light-svg")} download>light SVG</a></p>
    </section>

    <section class="brand-kit__section" aria-labelledby="banner-heading">
      <div class="brand-kit__heading"><div><h2 class="display-sm" id="banner-heading">The banner</h2><p>A wide-format expression of Foilbury, ready for a profile or community space.</p></div></div>
      <figure class="brand-kit__banner"><img src={asset("banner-1920")} width="1920" height="1080" alt="Foilbury Signal Fold banner artwork" loading="lazy" /><figcaption><span>1920 × 1080</span><span><a href={asset("banner-1920")} download>Download PNG</a> <a href={asset("banner-svg")} download>Download SVG</a></span></figcaption></figure>
    </section>

    <section class="brand-kit__section" aria-labelledby="palette-heading">
      <div class="brand-kit__heading"><div><h2 class="display-sm" id="palette-heading">The colours</h2><p>The palette behind the mark and the cabinet.</p></div></div>
      <div class="brand-kit__palette">{system.palette.map((colour) => <div class="brand-kit__swatch"><span style={`background:${colour.hex}`} aria-hidden="true"></span><strong>{colour.name}</strong><code>{colour.hex}</code></div>)}</div>
      <p class="brand-kit__more"><a href="/brand/kit/manifest.json" download>Download the complete asset manifest</a></p>
    </section>
  </div>
</BaseLayout>

<style>
  .brand-kit { padding-top: clamp(3rem, 7vw, 6rem); padding-bottom: 6rem; }
  .brand-kit__hero { display: grid; gap: 2.5rem; align-items: center; padding-bottom: clamp(3rem, 7vw, 6rem); }
  .brand-kit__intro h1 { font-size: clamp(2.6rem, 6vw, 5rem); line-height: .98; letter-spacing: -.04em; text-transform: uppercase; }
  .brand-kit__intro p, .brand-kit__heading p { max-width: 50ch; color: var(--muted); line-height: 1.65; }
  .brand-kit__intro p { margin: 1.5rem 0; font-size: 1.1rem; }
  .brand-kit__mark { display: grid; place-items: center; background: #07110f; padding: clamp(2rem, 7vw, 5rem); }
  .brand-kit__mark img { width: min(100%, 24rem); height: auto; }
  .brand-kit__section { border-top: 1px solid var(--line-strong); padding-top: 2rem; margin-top: 3rem; scroll-margin-top: 2rem; }
  .brand-kit__heading { margin-bottom: 1.5rem; }
  .brand-kit__heading h2 { font-size: clamp(2rem, 4vw, 3rem); text-transform: uppercase; }
  .brand-kit__heading p { margin-top: .6rem; }
  .brand-kit__assets { display: grid; gap: 1rem; }
  .brand-kit__asset { min-width: 0; }
  .brand-kit__preview { display: grid; place-items: center; aspect-ratio: 1.35; padding: 2rem; }
  .brand-kit__preview img { width: min(60%, 12rem); height: auto; }
  .brand-kit__preview--dark { background: #07110f; }
  .brand-kit__preview--light { background: #eff5f1; }
  .brand-kit__preview--neutral { background: var(--paper-2); }
  .brand-kit__asset-info, .brand-kit__banner figcaption { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding: .85rem 0; }
  .brand-kit__asset-info h3 { font-weight: 700; }
  .brand-kit__asset-info a + a, .brand-kit__banner a + a { margin-left: 1rem; }
  .brand-kit a:not(.btn) { text-decoration: underline; text-underline-offset: .18em; }
  .brand-kit__more { margin-top: 1.25rem; color: var(--muted); }
  .brand-kit__banner { margin: 0; }
  .brand-kit__banner img { display: block; width: 100%; height: auto; }
  .brand-kit__palette { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .brand-kit__swatch { display: grid; gap: .3rem; min-width: 0; }
  .brand-kit__swatch span { height: 5rem; }
  .brand-kit__swatch code { color: var(--muted); }
  @media (min-width: 700px) { .brand-kit__hero { grid-template-columns: 1fr 1fr; } .brand-kit__assets { grid-template-columns: repeat(3, minmax(0, 1fr)); } .brand-kit__palette { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
</style>
