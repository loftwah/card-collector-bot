---
import BaseLayout from "../layouts/BaseLayout.astro";

const assets = [
  { name: "Album mark", detail: "Scalable SVG", href: "/brand/kit/colophon/mark.svg" },
  { name: "Wordmark", detail: "Scalable SVG", href: "/brand/kit/colophon/wordmark-ink.svg" },
  { name: "App icon", detail: "1024 × 1024 PNG", href: "/brand/kit/colophon/discord-avatar-1024.png" },
  { name: "Social preview", detail: "1200 × 630 PNG", href: "/brand/kit/colophon/social-preview.png" },
];
---

<BaseLayout title="Brand assets" description="Foilbury marks and downloadable assets.">
  <section class="container py-10 md:py-16" aria-labelledby="brand-heading">
    <header class="max-w-2xl">
      <h1 id="brand-heading" class="display-sm text-4xl md:text-5xl">Foilbury brand assets</h1>
      <p class="mt-4 text-lg leading-relaxed text-[var(--muted)]">
        A small mark for a home full of characters. Find the Foilbury mark, wordmark and app assets here.
      </p>
    </header>

    <div class="brand-assets mt-10">
      <section class="brand-assets__preview" aria-labelledby="mark-heading">
        <div class="brand-assets__mark">
          <img src="/brand/kit/colophon/mark.svg" alt="Foilbury open album mark" width="128" height="128" />
          <img src="/brand/kit/colophon/wordmark-ink.svg" alt="Foilbury" width="180" height="48" />
        </div>
        <div>
          <h2 id="mark-heading" class="display-sm text-2xl">The open album</h2>
          <p class="mt-2 max-w-md leading-relaxed text-[var(--muted)]">A card sits opposite its index: a quiet frame for the collections inside.</p>
        </div>
        <div class="flex items-end gap-6" aria-label="Icon at small sizes">
          <div class="flex flex-col items-center gap-2"><img src="/brand/kit/colophon/favicon-32.png" alt="" width="32" height="32" /><span class="text-xs text-[var(--muted)]">32 px</span></div>
          <div class="flex flex-col items-center gap-2"><img src="/brand/kit/colophon/favicon-16.png" alt="" width="16" height="16" /><span class="text-xs text-[var(--muted)]">16 px</span></div>
        </div>
      </section>

      <section aria-labelledby="downloads-heading">
        <h2 id="downloads-heading" class="display-sm text-2xl">Downloads</h2>
        <div class="brand-assets__list mt-4">
          {assets.map((asset) => (
            <a class="brand-assets__download" href={asset.href} download>
              <span><strong>{asset.name}</strong><span class="brand-assets__detail">{asset.detail}</span></span>
              <span aria-hidden="true">↓</span><span class="sr-only">Download {asset.name}</span>
            </a>
          ))}
        </div>
        <p class="mt-5 text-sm leading-relaxed text-[var(--muted)]">
          <a class="underline underline-offset-4" href="/brand/kit/colophon/manifest.json">Asset manifest</a>
          <span aria-hidden="true"> · </span>
          <a class="underline underline-offset-4" href="/brand/kit/manifest.json">Earlier designs</a>
        </p>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .brand-assets { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2.5rem; }
  .brand-assets__preview { display: grid; gap: 1.5rem; padding: clamp(1.25rem, 4vw, 2.5rem); border: 1px solid var(--line); background: var(--paper-2); }
  .brand-assets__mark { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; }
  .brand-assets__mark img:last-child { width: min(180px, 100%); height: auto; }
  .brand-assets__list { border-top: 1px solid var(--line); }
  .brand-assets__download { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 68px; padding: .85rem .1rem; border-bottom: 1px solid var(--line); text-decoration: none; }
  .brand-assets__download:hover { color: var(--signal); }
  .brand-assets__detail { display: block; margin-top: .15rem; color: var(--muted); font-size: .875rem; }
  @media (min-width: 768px) { .brand-assets { grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); gap: 3rem; } }
</style>
