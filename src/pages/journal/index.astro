---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../lib/utils";
import { readJournalFeed } from "../../lib/journal-feed.mjs";
const { entries, error } = await readJournalFeed(async () => {
  const { getEmDashCollection } = await import("emdash");
  return getEmDashCollection("posts", { orderBy: { published_at: "desc" }, limit: 12 });
});
if (error) Astro.response.status = 503;
---
<BaseLayout title="Journal · Foilbury" description="Notes from the Foilbury editorial desk: the cabinet, the source artwork and the collecting practice.">
  <section class="journal-intro border-b border-[var(--line)]">
    <div class="container py-8 md:py-14">
      <h1 class="display max-w-[18ch] text-[clamp(2.5rem,6vw,5rem)]">Notes from the cabinet.</h1>
      <p class="mt-3 max-w-2xl text-[var(--muted)]">Stories, updates and ideas from the worlds in your cabinet.</p>
    </div>
  </section>
  <section class="journal-list container py-8">
    {error ? (
      <div class="notice max-w-2xl">
        <h2 class="display-sm text-2xl">The journal is unavailable.</h2>
        <p class="mt-2 text-sm">We couldn't load the notes right now. Please try again.</p>
        <a class="btn btn-secondary btn-sm mt-4" href="/journal">Try again</a>
      </div>
    ) : entries.length ? (
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {entries.map((entry) => (
          <a href={`/journal/${entry.slug}`} class="surface-flat block p-6 no-underline hover:border-[var(--brass)]">
            <p class="eyebrow">{entry.publishedAt ? formatDate(entry.publishedAt) : "Editorial note"}</p>
            <h2 class="display-sm mt-3 text-2xl">{entry.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-[var(--muted)]">{entry.excerpt || "Read the entry in the journal."}</p>
            <span class="mt-5 inline-block font-mono text-[0.62rem] uppercase tracking-[0.1em] text-[var(--green)]">Read entry →</span>
          </a>
        ))}
      </div>
    ) : (
      <div class="surface-flat max-w-2xl p-6">
        <h2 class="display-sm text-2xl">No notes yet.</h2>
        <p class="mt-2 text-sm text-[var(--muted)]">When there are stories to share, you'll find them here.</p>
        <a class="btn btn-secondary btn-sm mt-4" href="/cabinet">Explore the cards</a>
      </div>
    )}
  </section>
</BaseLayout>
