---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../lib/utils";
let entries: Array<{ id: string; slug: string; title: string; excerpt: string; publishedAt: string | null }> = [];
let error = false;
try {
  const { getEmDashCollection } = await import("emdash");
  const result = await getEmDashCollection("posts", { orderBy: { published_at: "desc" }, limit: 12 });
  entries = (result.entries ?? []).map((entry: { id: string; slug?: string | null; data: { title?: string; excerpt?: string; publishedAt?: string | null } }) => ({
    id: entry.id,
    slug: entry.slug ?? entry.id,
    title: entry.data.title ?? "Untitled",
    excerpt: entry.data.excerpt ?? "",
    publishedAt: entry.data.publishedAt ?? null,
  }));
} catch {
  error = true;
}
---
<BaseLayout title="Journal · Foilbury" description="Notes from the Foilbury editorial desk: the cabinet, the source artwork and the collecting practice.">
  <section class="journal-intro border-b border-[var(--line)]">
    <div class="container py-14 md:py-20">
      <p class="eyebrow">Editorial desk · EmDash</p>
      <h1 class="display mt-4 max-w-[14ch] text-[clamp(3rem,7vw,6.5rem)]">Notes from the cabinet.</h1>
      <p class="mt-5 max-w-2xl text-[var(--muted)]">Editorial drafts, media and journal entries are authored in EmDash. The journal is deliberately separate from the collectible catalogue: it cannot issue a card or change a wallet.</p>
    </div>
  </section>
  <section class="journal-list container py-12">
    {error ? (
      <div class="notice max-w-2xl">
        <p class="eyebrow eyebrow-brass">Editorial desk unavailable</p>
        <p class="mt-2 text-sm">The published journal could not be read. Gameplay, collection and draws are unaffected. The owner can finish EmDash setup from <a class="underline" href="/admin/editorial">the editorial desk</a>.</p>
      </div>
    ) : entries.length ? (
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {entries.map((entry) => (
          <a href={`/journal/${entry.slug}`} class="surface-flat block p-6 no-underline hover:border-[var(--brass)]">
            <p class="eyebrow">{entry.publishedAt ? formatDate(entry.publishedAt) : "Editorial note"}</p>
            <h2 class="display-sm mt-3 text-2xl">{entry.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-[var(--muted)]">{entry.excerpt || "Read the entry in the journal."}</p>
            <span class="mt-5 inline-block font-mono text-[0.62rem] uppercase tracking-[0.1em] text-[var(--green)]">Read entry →</span>
          </a>
        ))}
      </div>
    ) : (
      <div class="grid gap-5 md:grid-cols-2">
        <article class="surface-flat p-6">
          <p class="eyebrow">First note</p>
          <h2 class="display-sm mt-3 text-3xl">The first cabinet is open.</h2>
          <p class="mt-3 text-sm leading-relaxed text-[var(--muted)]">The starter selection is deliberately small: sixteen identities across three source worlds, with shared characters represented as separate artwork editions rather than merged aliases.</p>
          <p class="mt-3 text-sm leading-relaxed text-[var(--muted)]">This placeholder is not an invented journal entry. Once EmDash is set up, the owner can publish the real note here.</p>
        </article>
        <article class="surface-flat p-6">
          <p class="eyebrow">Editorial workflow</p>
          <h2 class="display-sm mt-3 text-3xl">Drafts stay in the desk.</h2>
          <p class="mt-3 text-sm leading-relaxed text-[var(--muted)]">EmDash owns editorial drafts, media and taxonomy. A published journal entry is a separate release from a published collectible. The two share a local database but not an authority boundary.</p>
          <a class="btn btn-secondary btn-sm mt-5" href="/admin/editorial">Open the editorial desk</a>
        </article>
      </div>
    )}
  </section>
</BaseLayout>
