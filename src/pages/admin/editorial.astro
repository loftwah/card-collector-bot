---
import AdminLayout from "../../layouts/AdminLayout.astro";
let posts: Array<{ title: string; slug: string; excerpt: string; publishedAt: string | null }> = [];
let offline = false;
try {
  const { getEmDashCollection } = await import("emdash");
  const { entries } = await getEmDashCollection("posts", { orderBy: { published_at: "desc" } });
  posts = entries.slice(0, 10).map((entry: { data: { title?: string; excerpt?: string; publishedAt?: string | null }; slug?: string | null }) => ({
    title: entry.data.title ?? "Untitled",
    slug: entry.slug ?? "",
    excerpt: entry.data.excerpt ?? "",
    publishedAt: entry.data.publishedAt ?? null,
  }));
} catch {
  offline = true;
}
---
<AdminLayout>
  <div class="border-b border-[var(--line)] pb-5">
    <p class="eyebrow">Editorial desk</p>
    <h2 class="display-sm mt-1 text-4xl">Publishing, kept separate.</h2>
    <p class="mt-2 max-w-2xl text-sm text-[var(--muted)]">EmDash owns journal drafts, editorial media and publishing workflow. Foilbury owns card identity, artwork editions, pools, awards and inventory. The CMS never issues cards or mutates a wallet directly.</p>
  </div>
  <div class="mt-6 grid gap-5 lg:grid-cols-[1.2fr_0.8fr]">
    <section class="surface-flat p-5">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div><p class="eyebrow">Recent journal entries · read-only</p><p class="mt-1 text-sm text-[var(--muted)]">Read from EmDash on the same D1 database. This is a handoff, not a second CMS.</p></div>
        <a class="btn btn-primary btn-sm" href="/_emdash/admin" target="_blank" rel="noreferrer">Open EmDash admin ↗</a>
      </div>
      {offline ? <div class="empty mt-4"><p>The editorial database is unavailable. Core gameplay is unaffected. Open the EmDash console with an authorised operator account; this page never substitutes placeholder journal entries.</p></div> : null}
      <div class="mt-4 grid gap-3">
        {posts.map((post) => (
          <article class="border-b border-[var(--line)] pb-3 last:border-0">
            <p class="font-semibold">{post.title}</p>
            <p class="mt-1 text-sm text-[var(--muted)]">{post.excerpt || "No excerpt."}</p>
            <p class="mt-1 font-mono text-[0.58rem] uppercase tracking-[0.1em] text-[var(--brass)]">{post.slug} · published</p>
          </article>
        ))}
        {!offline && posts.length === 0 ? <p class="text-sm text-[var(--muted)]">No journal entries yet. Create one in EmDash; it will appear at /journal.</p> : null}
      </div>
    </section>
    <aside class="grid gap-4">
      <div class="surface-flat p-5">
        <p class="eyebrow">Source of truth</p>
        <p class="mt-2 text-sm text-[var(--muted)]">EmDash is the editable source for journal titles, bodies and media. Foilbury is the source of truth for card identity, artwork editions, categories, tags, pools, awards and inventory. There is no two-way catalogue sync loop or second editable card catalogue.</p>
        <p class="mt-3 font-mono text-[0.58rem] uppercase tracking-[0.1em] text-[var(--muted)]">Boundary: docs/EMDASH_BOUNDARY.md</p>
      </div>
      <div class="surface-flat p-5">
        <p class="eyebrow">Editorial release sequence</p>
        <ol class="mt-2 grid gap-2 text-sm text-[var(--muted)]">
          <li>1. Author and save a draft in EmDash.</li>
          <li>2. Use the authorised EmDash preview to check blocks and media.</li>
          <li>3. Publish or schedule that entry in EmDash.</li>
          <li>4. Read the public entry at <a class="underline" href="/journal">/journal</a>, then revise or unpublish there.</li>
        </ol>
      </div>
      <div class="notice">
        <p class="text-xs leading-relaxed">EmDash operator access is protected by Cloudflare Access for Dean at the edge and by EmDash's supported Access adapter in production. Auto-provisioning is disabled: only the explicitly mapped operator account can enter. Native passkey login remains available only in local development.</p>
      </div>
      <a class="btn btn-secondary" href="/journal">View public journal</a>
    </aside>
  </div>
</AdminLayout>
