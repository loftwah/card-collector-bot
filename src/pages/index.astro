---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageContext } from "../server/page";
import { listCards } from "../server/modules/catalogue";
import { listPublicCollections } from "../server/modules/collections";

const ctx = await pageContext(Astro.request);
const session = Astro.locals.foilbury;
const user = session?.user ?? null;
const collections = await listPublicCollections(ctx);
const featuredCollection = collections[0] ?? null;
const featuredCards = featuredCollection
  ? await listCards(ctx, {
      publicOnly: true,
      collection: featuredCollection.slug,
      limit: 4,
    })
  : [];

const featuredCard =
  featuredCards.find((card) =>
    card.editions.some((edition) => edition.variants.some((variant) => variant.render_url)),
  ) ?? null;
const featuredVariant =
  featuredCard?.editions
    .flatMap((edition) => edition.variants)
    .find((variant) => variant.render_url) ?? null;
const primaryHref = user ? "/play" : "/login?next=%2Fplay";
const shelfCollections = collections.slice(0, 4);
---

<BaseLayout
  title="Foilbury — a personal card library"
  description="A free collectible-card album for approved original worlds. Browse the public shelf, open a capsule and keep the cards you love."
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "Foilbury",
      url: "https://foilbury.loftwah.com/",
      description:
        "A free personal card library for approved original collections, with a public shelf and a member album.",
      potentialAction: {
        "@type": "SearchAction",
        target: "https://foilbury.loftwah.com/cabinet?search={search_term_string}",
        "query-input": "required name=search_term_string",
      },
    })}
  />
  <section class="public-hero border-b border-[var(--line)]">
    <div class="container public-hero__grid">
      <div class="public-hero__copy">
        <h1 class="public-hero__title">Pull something wonderful.</h1>
        <p class="public-hero__lede">
          A free album for original character cards. Open a capsule, keep the copy, and arrange a
          shelf that is yours.
        </p>
        <div class="public-hero__actions">
          <a class="btn btn-primary" href="/cabinet">Browse originals</a>
          <a class="btn btn-secondary" href={primaryHref}>
            {user ? "Open my library" : "Sign in"}
          </a>
        </div>
        <p class="public-hero__note">
          Free to play. Earned Foil only. No purchase, marketplace or cash-out.
        </p>
      </div>

      <div class="public-hero__shelf">
        {
          featuredCard && featuredVariant ? (
            <a class="public-feature" href={`/cabinet/${featuredCard.slug}`}>
              <div class="public-feature__card">
                <img
                  src={featuredVariant.render_url!}
                  srcset={
                    featuredVariant.preview_url
                      ? `${featuredVariant.preview_url} 600w, ${featuredVariant.render_url} 750w`
                      : undefined
                  }
                  sizes="(min-width: 1024px) 34vw, 76vw"
                  alt=""
                  width="750"
                  height="1050"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              </div>
              <div class="public-feature__caption">
                <p class="eyebrow">{featuredCollection?.name ?? "Public shelf"}</p>
                <p class="public-feature__name">{featuredCard.name}</p>
                <p class="public-feature__meta">
                  {featuredVariant.material_name}
                  {featuredVariant.effect_name &&
                  featuredVariant.effect_name.toLowerCase() !== "none"
                    ? ` · ${featuredVariant.effect_name}`
                    : ""}{" "}
                  finish
                </p>
                <span class="public-feature__link">View this card</span>
              </div>
            </a>
          ) : (
            <div class="public-feature public-feature--empty">
              <div class="public-feature__card" aria-hidden="true">
                <span>Foilbury</span>
              </div>
              <div class="public-feature__caption">
                <p class="eyebrow">Public shelf</p>
                <p class="public-feature__name">The first originals are being prepared.</p>
                <p class="public-feature__meta">Approved public artwork appears here.</p>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section id="how-it-works" class="public-band border-b border-[var(--line)]">
    <div class="container public-how">
      <div class="public-how__intro">
        <h2 class="public-how__title">One capsule. One card. Keep the copy.</h2>
      </div>
      <ol class="public-steps">
        <li>
          <span class="public-step__index" aria-hidden="true">01</span>
          <h3>Choose a capsule</h3>
          <p>See the exact cost and the actual eligible odds before you open anything.</p>
        </li>
        <li>
          <span class="public-step__index" aria-hidden="true">02</span>
          <h3>Open one card</h3>
          <p>Every opening commits one card copy with its own serial and saved receipt.</p>
        </li>
        <li>
          <span class="public-step__index" aria-hidden="true">03</span>
          <h3>Keep it in your library</h3>
          <p>Inspect the front and back, follow roster progress and trade duplicates.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="public-collections border-b border-[var(--line)]">
    <div class="container">
      <div class="public-section-head">
        <div>
          <h2 class="public-section-title">A shelf of original worlds.</h2>
          <p class="public-section-lede">
            Approved original collections, shown without member data. The public shelf is a
            preview; your own album stays private.
          </p>
        </div>
        <a class="btn btn-secondary btn-sm" href="/cabinet">Browse every card</a>
      </div>

      {
        shelfCollections.length ? (
          <div class="public-collection-grid">
            {shelfCollections.map((collection, index) => (
              <a
                class="public-collection"
                href={`/cabinet?collection=${collection.slug}`}
                data-tone={index % 4}
              >
                <div class="public-collection__art">
                  {collection.cover_url ? (
                    <img
                      src={collection.cover_url}
                      alt=""
                      width="750"
                      height="1050"
                      loading={index === 0 ? "eager" : "lazy"}
                    />
                  ) : (
                    <div class="public-collection__fallback" aria-hidden="true">
                      {collection.logo_url ? (
                        <img src={collection.logo_url} alt="" width="72" height="72" />
                      ) : null}
                      <span>{collection.name}</span>
                    </div>
                  )}
                </div>
                <div class="public-collection__body">
                  <h3>{collection.name}</h3>
                  <p>{collection.description || "An approved original collection."}</p>
                  <span class="public-collection__link">Explore collection →</span>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="empty mt-6">
            <div>
              <p class="display-sm text-2xl">The public shelf is being prepared.</p>
              <p class="mt-2 text-sm">
                Approved originals will appear here. Member collections stay private.
              </p>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <section class="public-close">
    <div class="container public-close__inner">
      <div>
        <h2 class="public-close__title">Start with one card.</h2>
        <p class="public-close__lede">
          Sign in with Discord, a one-use email link or a passkey. Your copies, serials and progress
          stay in this Bot's album.
        </p>
      </div>
      <div class="public-close__actions">
        <a class="btn btn-primary" href={primaryHref}>
          {user ? "Open my library" : "Sign in to collect"}
        </a>
        <a class="btn btn-secondary" href="/cabinet">Browse the public shelf</a>
      </div>
    </div>
  </section>
</BaseLayout>
