---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageContext } from "../server/page";
import { listPublicCollections } from "../server/modules/collections";
import { collectionBanner, collectionMark } from "../lib/collection-art";
import { cabinetArtwork, editorialShareImage } from "../lib/editorial-art";

const ctx = await pageContext(Astro.request);
const session = Astro.locals.foilbury;
const user = session?.user ?? null;
const collections = await listPublicCollections(ctx);
const primaryHref = user ? "/play" : "/login?next=%2Fplay";
const browseHref = user ? "/play" : "/cabinet";
const shelfCollections = collections.slice(0, 6);
const albumFeatures = [
  [
    "Open a capsule",
    "See the exact price and the live eligible odds before a card moves. One opening commits one copy.",
  ],
  [
    "Inspect the object",
    "Front, back and an on-demand 3D view. Reduced motion gets a clean static inspection instead.",
  ],
  [
    "Keep the story",
    "Every card carries a reviewed profile, a source boundary and its collection context.",
  ],
  [
    "Let duplicates travel",
    "Trade or recycle extras. Your ledger, serials and history stay authoritative.",
  ],
];
---

<BaseLayout
  title="Foilbury — characters worth keeping"
  description="A free collectible-card cabinet for original worlds. Browse the public shelf, open a capsule and keep the copy you pull."
  shareImage={editorialShareImage}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "Foilbury",
      url: "https://foilbury.loftwah.com/",
      description:
        "A free personal card library for approved original collections, with a public shelf and a member album.",
      potentialAction: {
        "@type": "SearchAction",
        target: "https://foilbury.loftwah.com/cabinet?search={search_term_string}",
        "query-input": "required name=search_term_string",
      },
    })}
  />
  <section class="home-hero">
    <div class="container home-hero__grid">
      <div class="home-hero__copy">
        <h1 class="home-title">
          <span>Characters</span>
          <span>worth keeping.</span>
        </h1>
        <p class="home-hero__lede">
          A free collectible-card cabinet for original worlds. Open a capsule, keep the copy, and
          arrange a shelf that is yours.
        </p>
        <div class="home-hero__actions">
          <a class="btn btn-primary" href={browseHref}>
            {user ? "Open my library" : "Browse originals"}
          </a>
          <a class="btn btn-secondary" href="#how-it-works">
            See how it works
          </a>
        </div>
        <p class="home-hero__note">Free to play · no purchase · earned Foil only</p>
      </div>

      <figure class="home-artwork">
        <img
          src={cabinetArtwork.src}
          srcset={cabinetArtwork.srcset}
          sizes="(min-width: 960px) 44vw, (min-width: 600px) 540px, calc(100vw - 2.5rem)"
          alt={cabinetArtwork.alt}
          width={cabinetArtwork.width}
          height={cabinetArtwork.height}
          fetchpriority="high"
          decoding="async"
        />
        <figcaption>
          <span>{cabinetArtwork.title}</span>
          <a href="/cabinet#character-artwork">Explore the artwork</a>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="home-worlds" aria-label="Public collections">
    <div class="container home-worlds__row">
      <span class="home-worlds__label">Original worlds</span>
      {
        collections.slice(0, 4).map((collection) => (
          <a href={`/cabinet?collection=${collection.slug}`}>{collection.name}</a>
        ))
      }
    </div>
  </section>

  <section id="how-it-works" class="home-loop">
    <div class="container home-loop__grid">
      <div class="home-loop__intro">
        <h2>One capsule. One card. Keep the copy.</h2>
        <p>
          No gacha theatre, no mystery price. The odds, the cost and the receipt are visible before
          and after the opening.
        </p>
      </div>
      <ol class="home-steps">
        <li>
          <span class="home-step__number" aria-hidden="true">01</span>
          <div>
            <h3>Choose a capsule</h3>
            <p>See the exact cost and the actual eligible odds before you open anything.</p>
          </div>
        </li>
        <li>
          <span class="home-step__number" aria-hidden="true">02</span>
          <div>
            <h3>Open one card</h3>
            <p>Every opening commits one copy with its own serial and a saved receipt.</p>
          </div>
        </li>
        <li>
          <span class="home-step__number" aria-hidden="true">03</span>
          <div>
            <h3>Keep it in your library</h3>
            <p>Inspect the front and back, follow roster progress and trade duplicates.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="home-shelf">
    <div class="container">
      <div class="home-shelf__head">
        <h2>A shelf of original worlds.</h2>
        <a class="home-shelf__all" href="/cabinet">
          Browse every card <span aria-hidden="true">↗</span>
        </a>
      </div>
      {
        shelfCollections.length ? (
          <div class="home-shelf__list">
            {shelfCollections.map((collection, index) => (
              <a class="home-shelf__row" href={`/cabinet?collection=${collection.slug}`}>
                <span class="home-shelf__index">{String(index + 1).padStart(2, "0")}</span>
                <span class="home-shelf__name">{collection.name}</span>
                <span class="home-shelf__desc">
                  {collection.description || "An approved original collection."}
                </span>
                <span class="home-shelf__count">{collection.card_count} cards</span>
                <span class:list={["home-shelf__mark", collectionBanner(collection) && "home-shelf__mark--banner"]}>
                  {collectionBanner(collection) ?? collectionMark(collection) ? (
                    <img
                      src={collectionBanner(collection) ?? collectionMark(collection) ?? ""}
                      alt=""
                      width={collectionBanner(collection) ? 1600 : 512}
                      height={collectionBanner(collection) ? 900 : 512}
                      loading="lazy"
                    />
                  ) : (
                    <span aria-hidden="true">{collection.name.charAt(0)}</span>
                  )}
                </span>
                <span class="home-shelf__arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        ) : (
          <p class="home-shelf__empty">
            The public shelf is being prepared. Approved originals will appear here.
          </p>
        )
      }
    </div>
  </section>

  <section class="home-album">
    <div class="container home-album__grid">
      <div class="home-album__intro">
        <h2>The members' album.</h2>
        <p>
          Sign in with Discord, a one-use email link or a passkey. Your album holds the collections
          you are entitled to, with full profiles, spoiler controls, duplicates and provenance.
        </p>
        <div class="home-album__actions">
          <a class="btn btn-primary" href="/login?next=%2Fplay">Join the album</a>
          <a class="btn btn-secondary" href="/login?next=%2Fplay%2Fcollection">
            I already have an account
          </a>
        </div>
      </div>
      <div class="home-features">
        {
          albumFeatures.map(([title, body], index) => (
            <div class="home-feature">
              <span class="home-feature__index" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3>{title}</h3>
              <p>{body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="home-close">
    <div class="container home-close__inner">
      <h2>Start with one card.</h2>
      <p>A room of your own, built one pull at a time. The public shelf is open; the album is one click away.</p>
      <div class="home-close__actions">
        <a class="btn btn-invert" href={primaryHref}>
          {user ? "Open my library" : "Sign in to collect"}
        </a>
        <a class="btn btn-invert-outline" href="/cabinet">Browse the public shelf</a>
      </div>
    </div>
  </section>
</BaseLayout>
