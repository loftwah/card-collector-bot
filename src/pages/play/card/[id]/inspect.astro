---
import PlayerLayout from '../../../../layouts/PlayerLayout.astro';
import { pageContext } from '../../../../server/page';
import { recordOwnedInspection } from '../../../../server/modules/missions';

export const prerender = false;
if (Astro.request.method !== 'POST') return new Response('Method not allowed', {status:405,headers:{allow:'POST','cache-control':'no-store'}});
const id = Astro.params.id ?? '';
const ctx = await pageContext(Astro.request);
let recorded = false;
let status = 403;
if (/^[A-Za-z0-9_-]{1,128}$/.test(id) && ctx.user && ctx.sessionId && ctx.csrfToken &&
    Astro.request.headers.get('content-type')?.split(';',1)[0]?.trim().toLowerCase() === 'application/x-www-form-urlencoded') {
  try {
    const reader = Astro.request.body?.getReader();
    if (!reader) throw new Error('Missing form body');
    const chunks: Uint8Array[] = []; let total = 0; let count = 0;
    while (true) {
      const part = await reader.read(); if (part.done) break;
      total += part.value.byteLength; count += 1;
      if (total > 4096 || count > 128) { await reader.cancel(); throw new Error('Form too large'); }
      chunks.push(part.value);
    }
    const bytes = new Uint8Array(total); let offset = 0;
    for (const chunk of chunks) { bytes.set(chunk, offset); offset += chunk.length; }
    const form = new URLSearchParams(new TextDecoder('utf-8', {fatal:true}).decode(bytes));
    const tokens = form.getAll('csrf');
    if (tokens.length === 1 && tokens[0] === ctx.csrfToken) {
      status = 503;
      const result = await recordOwnedInspection(ctx, id);
      recorded = result.recorded === true;
      if (recorded) status = 200;
    }
  } catch { /* A failure is not proof of the outcome; the request is safe to retry. */ }
}
Astro.response.status = status;
Astro.response.headers.set('cache-control','no-store');
---
<PlayerLayout title="Inspection · Foilbury">
  <section class="mx-auto max-w-xl py-10">
    <h1 class="display-sm text-3xl">{recorded ? 'Inspection recorded' : 'Inspection not confirmed'}</h1>
    <p class="mt-3 text-[var(--muted)]">{recorded ? 'Your inspection was recorded for today’s missions.' : 'We could not confirm the inspection. Return to the card and try again.'}</p>
    <a class="btn btn-secondary mt-5" href={`/play/card/${encodeURIComponent(id)}`}>Return to card</a>
  </section>
</PlayerLayout>
