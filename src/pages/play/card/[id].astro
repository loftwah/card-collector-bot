---
import PlayerLayout from "../../../layouts/PlayerLayout.astro";
import LayeredCard from "../../../components/player/LayeredCard";
import CardDetailActions from "../../../components/player/CardDetailActions";
import { pageContext } from "../../../server/page";
import { getInstance } from "../../../server/modules/collection";
import { listSets } from "../../../server/modules/catalogue";
import { getWishlist } from "../../../server/modules/collection";
import { formatDual } from "../../../lib/utils";

const ctx = await pageContext(Astro.request);
const instanceId = Astro.params.id ?? "";
let detail;
try {
  detail = await getInstance(ctx, instanceId);
} catch {
  return Astro.redirect("/play/collection");
}
const { instance, history, draws } = detail;
const sets = await listSets(ctx, ctx.user!.id);
const set = sets.find((item) => item.cards.some((card) => card.id === instance.card_id) && item.status === "published");
const wishlist = await getWishlist(ctx);
const wished = wishlist.some((item) => item.card_id === instance.card_id);
const eventLabel: Record<string, string> = {
  drawn: "Drawn from a cabinet pool",
  traded: "Transferred in a trade",
  gifted: "Received as a gift",
  recycled: "Recycled into Foil",
};
---
<PlayerLayout title={`${instance.card_name} · Collection`}>
  <nav class="mb-6 font-mono text-[0.62rem] uppercase tracking-[0.12em] text-[var(--muted)]" aria-label="Breadcrumb">
    <a href="/play/collection">Collection</a> <span aria-hidden="true">/</span> <span>{instance.card_name}</span>
  </nav>

  <div class="grid gap-9 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-start">
    <div>
      <LayeredCard
        client:load
        subjectUrl={`/media/asset/${instance.subject_asset_id}`}
        backgroundUrl={instance.background_asset_id ? `/media/asset/${instance.background_asset_id}` : "/brand/card-back.webp"}
        material={instance.material_key}
        effect={instance.effect_key}
        name={instance.card_name}
        subtitle={instance.subtitle}
        setName={set?.name ?? instance.category_name ?? "Cabinet"}
        characterClass={instance.class_name}
        rarity={instance.rarity_name}
        serial={instance.serial}
        subjectWidth={instance.subject_width}
        subjectHeight={instance.subject_height}
      />
      <div class="mt-4 flex flex-wrap items-center justify-between gap-2">
        <p class="font-mono text-[0.58rem] uppercase tracking-[0.12em] text-[var(--muted)]">Live layered composition · {instance.material_key}{instance.effect_key ? ` · ${instance.effect_key}` : ""}</p>
        {instance.render_url ? <a class="font-mono text-[0.58rem] uppercase tracking-[0.12em] text-[var(--green)]" href={instance.render_url} target="_blank" rel="noreferrer">Published render ↗</a> : null}
      </div>
      <p class="mt-2 text-xs text-[var(--muted)]">The layered view uses the private source assets with your session. The public render is an explicit export; it does not expose the source library.</p>
    </div>

    <div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="badge badge-rare">{instance.rarity_name ?? "Cabinet card"}</span>
        <span class="badge">{instance.class_name ?? "Unclassified"}</span>
        {instance.status === "reserved" ? <span class="badge">Reserved for trade</span> : null}
        {instance.locked ? <span class="badge">Locked</span> : null}
      </div>
      <h1 class="display mt-4 text-[clamp(2.8rem,7vw,5.5rem)]">{instance.card_name}</h1>
      <p class="mt-2 text-lg text-[var(--brass)]">{instance.subtitle}</p>
      <p class="prose mt-5 text-[var(--muted)]">{instance.description}</p>

      <div class="mt-7">
        <CardDetailActions client:load instanceId={instance.id} cardId={instance.card_id} initialFavourite={Boolean(instance.favourite)} initialLocked={Boolean(instance.locked)} initialWishlist={wished} reserved={instance.status === "reserved"} />
      </div>

      <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-4 border-t border-[var(--line)] pt-5 text-sm">
        <div><dt class="eyebrow">Serial</dt><dd class="mt-1 font-mono text-xs">{instance.serial}</dd></div>
        <div><dt class="eyebrow">Finish</dt><dd class="mt-1">{instance.material_key}{instance.effect_key ? ` · ${instance.effect_key}` : ""}</dd></div>
        <div><dt class="eyebrow">Acquired</dt><dd class="mt-1">{formatDual(instance.acquired_at)}</dd></div>
        <div><dt class="eyebrow">Via</dt><dd class="mt-1">{instance.acquired_via}</dd></div>
        <div><dt class="eyebrow">Set</dt><dd class="mt-1">{set ? `${set.name} · v${set.version}` : "No published set"}</dd></div>
        <div><dt class="eyebrow">Category</dt><dd class="mt-1">{instance.category_name ?? "—"}</dd></div>
      </dl>

      {set?.progress ? (
        <div class="mt-6 border border-[var(--line)] p-4">
          <div class="flex items-center justify-between gap-3">
            <p class="text-sm font-semibold">{set.name}</p>
            <span class="font-mono text-[0.62rem] text-[var(--muted)]">{set.progress.owned}/{set.progress.total}</span>
          </div>
          <div class="mt-2 h-1.5 bg-[var(--paper-3)]"><div class="h-full bg-[var(--brass)]" style={`width:${set.progress.total ? Math.round((set.progress.owned / set.progress.total) * 100) : 0}%`}></div></div>
          <p class="mt-2 text-xs text-[var(--muted)]">{set.progress.claimed ? "Completion reward already claimed." : set.progress.complete ? "Completion reward is ready in Rewards." : `Complete the set for ✦ ${set.reward_amount}.`}</p>
        </div>
      ) : null}

      <div class="mt-8">
        <p class="eyebrow mb-3">Ownership history</p>
        <ol class="grid gap-3">
          {history.map((event) => (
            <li class="flex gap-3 border-l-2 border-[var(--line)] pl-4">
              <div>
                <p class="text-sm font-semibold">{eventLabel[event.event] ?? event.event}</p>
                <p class="mt-0.5 text-xs text-[var(--muted)]">{formatDual(event.created_at)}</p>
                {event.reference_id ? <p class="mt-0.5 font-mono text-[0.56rem] uppercase tracking-[0.08em] text-[var(--muted)]">{event.reference_type} · {event.reference_id}</p> : null}
              </div>
            </li>
          ))}
        </ol>
        {draws.length ? (
          <div class="mt-5 border-t border-[var(--line)] pt-4">
            <p class="eyebrow">Draw receipt</p>
            {draws.map((draw) => (
              <p class="mt-1 text-sm text-[var(--muted)]">Pool revision {draw.pool_revision} · paid <span class="font-mono text-[var(--brass)]">✦ {draw.price}</span> · {formatDual(draw.created_at)}</p>
            ))}
          </div>
        ) : null}
      </div>
    </div>
  </div>
</PlayerLayout>
