---
import PlayerLayout from "../../../layouts/PlayerLayout.astro";
import CardInspector from "../../../components/player/CardInspector";
import CardDetailActions from "../../../components/player/CardDetailActions";
import SharePanel from "../../../components/player/SharePanel";
import { pageContext } from "../../../server/page";
import { first } from "../../../server/db";
import { getInstance } from "../../../server/modules/collection";
import { getCard, listSets } from "../../../server/modules/catalogue";
import { getWishlist } from "../../../server/modules/collection";
import { displayFinish, formatDual, printTitle as editionPrintTitle } from "../../../lib/utils";
import { CARD_STYLE_LABEL } from "../../../lib/card-styles";

const ctx = await pageContext(Astro.request);
const instanceId = Astro.params.id ?? "";
let detail;
try {
  detail = await getInstance(ctx, instanceId);
} catch {
  return Astro.redirect("/play/collection");
}
const { instance, history, draws } = detail;
const ownedCopy = await first<{ id: string }>(
  ctx.db,
  `SELECT ci.id
     FROM fb_card_instances ci
     JOIN fb_card_definitions cd ON cd.id=ci.card_id AND cd.status='published' AND cd.archived_at IS NULL
     JOIN fb_variants v ON v.id=ci.variant_id AND v.card_id=cd.id AND v.status='published' AND v.archived_at IS NULL
     JOIN fb_artwork_editions e ON e.id=v.edition_id AND e.tenant_id=v.tenant_id AND e.card_id=cd.id AND e.status='published' AND e.archived_at IS NULL
    WHERE ci.id=? AND ci.tenant_id=? AND ci.user_id=? AND ci.status IN ('owned','reserved')`,
  instance.id,
  ctx.tenant.id,
  ctx.user!.id,
);
const sets = await listSets(ctx, ctx.user!.id);
const set = sets.find(
  (item) => item.cards.some((card) => card.id === instance.card_id) && item.status === "published",
);
const wishlist = await getWishlist(ctx);
const wish = wishlist.find((item) => item.card_id === instance.card_id) ?? null;
const wished = Boolean(wish);
const cardCatalogue = await getCard(ctx, instance.card_slug).catch(() => null);
const variantComparisons = cardCatalogue
  ? cardCatalogue.editions
      .flatMap((edition) =>
        edition.variants
          .filter((variant) => variant.render_url)
          .map((variant) => ({
            id: variant.id,
            name: variant.name,
            material: variant.material_key,
            effect: variant.effect_key,
            render_url: variant.render_url,
            owned: variant.id === instance.variant_id,
          })),
      )
      .slice(0, 6)
  : [];
// Multi-print editions are named "Subject — Print title". Keep the subject as
// the card identity and surface the print title as the human-readable edition.
const cardPrintTitle = editionPrintTitle(instance.edition_name);
const artOriginLabel = (origin: string): string => {
  if (origin === "ai_assisted") return "AI-assisted print, reviewed; not official artwork";
  if (origin === "ai_generated") return "AI-generated print, reviewed; not official artwork";
  if (origin === "sourced") return "Sourced character reference; card design Foilbury original";
  if (origin === "foilbury_original") return "Foilbury original";
  if (origin === "derived") return "Deterministic render of the source layers";
  return "Provenance review outstanding";
};
const finishText = displayFinish(instance.variant_name, instance.material_key, instance.effect_key);
const viewerItems = [
  {
    id: instance.id,
    name: instance.card_name,
    subtitle: cardPrintTitle ?? instance.subtitle,
    collection: instance.collection_name,
    styleKey: instance.style_key,
    finish: finishText,
    method: "Saved card render",
    status: instance.status,
    width: 750,
    height: 1050,
    serial: instance.serial,
    audience: instance.collection_name ? "Member album" : null,
    provenance: artOriginLabel(instance.subject_origin),
    front: instance.render_url ?? "/brand/card-back.webp",
    back: instance.back_render_url,
    href: `/play/card/${instance.id}`,
  },
  ...variantComparisons.map((variant) => ({
    id: variant.id,
    name: instance.card_name,
    subtitle: cardPrintTitle ?? instance.subtitle,
    collection: instance.collection_name,
    styleKey: instance.style_key,
    finish: displayFinish(variant.name, variant.material, variant.effect),
    method: "Saved card render",
    status: variant.owned ? "Your copy" : "Preview only · ownership unchanged",
    width: 750,
    height: 1050,
    audience: "Member album",
    provenance: artOriginLabel(instance.subject_origin),
    front: variant.render_url ?? instance.render_url ?? "/brand/card-back.webp",
    back: null,
    href: null,
  })),
];
const eventLabel: Record<string, string> = {
  drawn: "Drawn from a cabinet pool",
  traded: "Transferred in a trade",
  gifted: "Received as a gift",
  recycled: "Recycled into Foil",
};
---

<PlayerLayout title={`${instance.card_name} · Collection`}>
  <nav
    class="mb-6 font-mono text-[0.62rem] uppercase tracking-[0.12em] text-[var(--muted)]"
    aria-label="Breadcrumb"
  >
    <a href="/play/collection">Collection</a> <span aria-hidden="true">/</span>{" "}
    <span>{instance.card_name}</span>
  </nav>

  <div class="grid gap-9 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-start">
    <div>
      <CardInspector
        client:load
        inspectionInstanceId={ownedCopy ? instance.id : undefined}
        frontUrl={instance.render_url}
        backUrl={instance.back_render_url}
        fallbackUrl="/brand/card-back.webp"
        name={instance.card_name}
        subtitle={cardPrintTitle ?? instance.subtitle}
        finish={displayFinish(instance.variant_name, instance.material_key, instance.effect_key)}
        collection={instance.collection_name}
        serial={instance.serial}
        viewerItems={viewerItems}
      />
      {ownedCopy && ctx.csrfToken ? (
        <noscript>
          <form
            method="post"
            action={`/play/card/${encodeURIComponent(instance.id)}/inspect`}
            class="mt-3"
          >
            <input type="hidden" name="csrf" value={ctx.csrfToken} />
            <button type="submit" class="btn btn-secondary btn-sm">
              Record inspection for daily missions
            </button>
            <p class="mt-2 text-xs text-[var(--muted)]">
              Use the front link below and{" "}
              <a
                class="underline underline-offset-4"
                href={instance.back_render_url ?? "/brand/card-back.webp"}
              >
                {instance.back_render_url ? "view the card back" : "view the generic card back"}
              </a>
              , then record your inspection.
            </p>
          </form>
        </noscript>
      ) : null}
      <div class="mt-4 flex flex-wrap items-center justify-between gap-2">
        <p class="font-mono text-[0.58rem] uppercase tracking-[0.12em] text-[var(--muted)]">
          Your copy ·{" "}
          {displayFinish(instance.variant_name, instance.material_key, instance.effect_key)}
        </p>
        <span class="font-mono text-[0.58rem] uppercase tracking-[0.12em] text-[var(--muted)]">
          Click the card or Expand
        </span>
      </div>
      {variantComparisons.length > 1 ? (
        <div class="mt-5 border border-[var(--line)] bg-[var(--paper-2)]/35 p-3">
          <div class="flex items-end justify-between gap-3">
            <p class="studio-stat__label">Variant comparison</p>
            <p class="font-mono text-[0.52rem] uppercase tracking-[0.08em] text-[var(--muted)]">
              Preview only · ownership unchanged
            </p>
          </div>
          <div class="mt-2 grid grid-cols-3 gap-2 sm:grid-cols-4" data-card-grid>
            {variantComparisons.map((variant) => (
              <div
                class:list={[
                  "border p-1",
                  variant.owned ? "border-[var(--signal)]" : "border-[var(--line)]",
                ]}
              >
                {variant.render_url ? (
                  <button
                    type="button"
                    class="card-trigger"
                    data-card-facts={JSON.stringify({
                      id: variant.id,
                      name: instance.card_name,
                      subtitle: cardPrintTitle ?? instance.subtitle,
                      collection: instance.collection_name,
                      styleKey: instance.style_key,
                      finish: displayFinish(variant.name, variant.material, variant.effect),
                      method: "Saved card render",
                      status: variant.owned ? "Your copy" : "Preview only",
                      width: 750,
                      height: 1050,
                      audience: "Member album",
                      front: variant.render_url,
                      back: null,
                      href: null,
                    })}
                    aria-label={`Open ${instance.card_name} in ${variant.name} full size`}
                  >
                    <img
                      src={variant.render_url}
                      alt={`${instance.card_name} in ${variant.name}`}
                      class="aspect-[5/7] w-full object-cover"
                      loading="lazy"
                      width="150"
                      height="210"
                    />
                  </button>
                ) : null}
                <p class="mt-1 truncate text-[0.6rem] font-semibold">
                  {displayFinish(variant.name, variant.material, variant.effect)}
                </p>
                <p
                  class:list={[
                    "font-mono text-[0.48rem] uppercase tracking-[0.06em]",
                    variant.owned ? "text-[var(--signal)]" : "text-[var(--muted)]",
                  ]}
                >
                  {variant.owned ? "Your copy" : "Preview only"}
                </p>
              </div>
            ))}
          </div>
        </div>
      ) : null}
      <p class="mt-2 text-xs text-[var(--muted)]">
        The 3D view is an inspection aid. Your ownership, finish and serial are fixed in your album,
        not changed by the camera.
      </p>
    </div>

    <div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="badge badge-rare">{instance.rarity_name ?? "Cabinet card"}</span>
        <span class="badge">{instance.class_name ?? "Unclassified"}</span>
        {instance.status === "reserved" ? <span class="badge">Reserved for trade</span> : null}
        {instance.locked ? <span class="badge">Locked</span> : null}
      </div>
      <h1 class="page-title mt-3">{instance.card_name}</h1>
      <p class="mt-2 text-lg text-[var(--signal)]">
        {cardPrintTitle ? `Print · ${cardPrintTitle}` : instance.subtitle}
      </p>
      <p class="prose mt-5 text-[var(--muted)]">
        {instance.bio_safe || instance.bio || instance.description}
      </p>
      {instance.spoiler_level > 0 && instance.bio ? (
        <details class="mt-4 border border-[var(--line)] p-4">
          <summary class="cursor-pointer font-mono text-[0.62rem] uppercase tracking-[0.1em] text-[var(--coral)]">
            Show full profile · spoiler level {instance.spoiler_level}
          </summary>
          <p class="prose mt-3 text-[var(--muted)]">{instance.bio}</p>
        </details>
      ) : null}
      {instance.quote ? (
        <blockquote class="mt-5 border-l-2 border-[var(--brass)] pl-4 text-xl italic text-[var(--ink)]">
          “{instance.quote}”
        </blockquote>
      ) : null}
      {(() => {
        try {
          const attributes = JSON.parse(instance.attributes_json ?? "[]") as Array<{
            label?: string;
            value?: string;
            unit?: string | null;
            source?: string;
          }>;
          if (!attributes.length) return null;
          return (
            <dl class="mt-7 grid grid-cols-2 gap-x-6 gap-y-4 border-t border-[var(--line)] pt-5 text-sm">
              {attributes.slice(0, 8).map((attribute) => (
                <div>
                  <dt class="eyebrow">{attribute.label}</dt>
                  <dd class="mt-1">
                    {attribute.value}
                    {attribute.unit ? ` ${attribute.unit}` : ""}
                    {attribute.source ? (
                      <span class="mt-0.5 block text-[0.65rem] text-[var(--muted)]">
                        {attribute.source}
                      </span>
                    ) : null}
                  </dd>
                </div>
              ))}
            </dl>
          );
        } catch {
          return null;
        }
      })()}

      <div class="mt-7">
        <CardDetailActions
          client:load
          instanceId={instance.id}
          cardId={instance.card_id}
          initialFavourite={Boolean(instance.favourite)}
          initialLocked={Boolean(instance.locked)}
          initialWishlist={wished}
          initialWishlistTarget={wish?.target_variant_id ?? ""}
          wishlistVariants={(cardCatalogue?.editions ?? []).flatMap((edition) =>
            edition.variants
              .filter((variant) => variant.status === "published" && variant.render_url)
              .map((variant) => ({ id: variant.id, label: `${edition.name} · ${variant.name}` })),
          )}
          reserved={instance.status === "reserved"}
        />
      </div>

      <div class="mt-7">
        <SharePanel
          client:load
          kind="card"
          targetId={instance.id}
          title={instance.card_name}
          description={`${cardPrintTitle ? `${cardPrintTitle} · ` : ""}${displayFinish(instance.variant_name, instance.material_key, instance.effect_key)} · ${instance.collection_name ?? "Cabinet"}. Choose the exact audience before creating a link.`}
          frontUrl={instance.render_url}
          backUrl={instance.back_render_url}
        />
      </div>

      <dl class="card-facts mt-8 grid grid-cols-1 gap-x-6 gap-y-4 border-t border-[var(--line)] pt-5 text-sm sm:grid-cols-2">
        {instance.style_key ? (
          <div>
            <dt class="eyebrow">Style</dt>
            <dd class="mt-1">{CARD_STYLE_LABEL[instance.style_key] ?? instance.style_key}</dd>
          </div>
        ) : null}
        <div>
          <dt class="eyebrow">Serial</dt>
          <dd class="mt-1 font-mono text-xs">{instance.serial}</dd>
        </div>
        <div>
          <dt class="eyebrow">Finish</dt>
          <dd class="mt-1">
            {displayFinish(instance.variant_name, instance.material_key, instance.effect_key)}
          </dd>
        </div>
        <div>
          <dt class="eyebrow">Acquired</dt>
          <dd class="mt-1">{formatDual(instance.acquired_at)}</dd>
        </div>
        <div>
          <dt class="eyebrow">Via</dt>
          <dd class="mt-1">{instance.acquired_via}</dd>
        </div>
        <div>
          <dt class="eyebrow">Set</dt>
          <dd class="mt-1">{set ? `${set.name} · v${set.version}` : "No published set"}</dd>
        </div>
        <div>
          <dt class="eyebrow">Category</dt>
          <dd class="mt-1">{instance.category_name ?? "—"}</dd>
        </div>
        <div>
          <dt class="eyebrow">Collection</dt>
          <dd class="mt-1">{instance.collection_name ?? "Uncollected"}</dd>
        </div>
        <div>
          <dt class="eyebrow">Source work</dt>
          <dd class="mt-1">{instance.source_work ?? "Foilbury original"}</dd>
        </div>
        <div>
          <dt class="eyebrow">Artwork origin</dt>
          <dd class="mt-1">{artOriginLabel(instance.subject_origin)}</dd>
        </div>
        <div>
          <dt class="eyebrow">Review</dt>
          <dd class="mt-1">{instance.review_status}</dd>
        </div>
      </dl>

      {set?.progress ? (
        <div class="mt-6 border border-[var(--line)] p-4">
          <div class="flex items-center justify-between gap-3">
            <p class="text-sm font-semibold">{set.name}</p>
            <span class="font-mono text-[0.62rem] text-[var(--muted)]">
              {set.progress.owned}/{set.progress.total}
            </span>
          </div>
          <div class="mt-2 h-1.5 bg-[var(--paper-3)]">
            <div
              class="h-full bg-[var(--brass)]"
              style={`width:${set.progress.total ? Math.round((set.progress.owned / set.progress.total) * 100) : 0}%`}
            ></div>
          </div>
          <p class="mt-2 text-xs text-[var(--muted)]">
            {set.progress.claimed
              ? "Completion reward already claimed."
              : set.progress.complete
                ? "Completion reward is ready in Rewards."
                : `Complete the set for ✦ ${set.reward_amount}.`}
          </p>
        </div>
      ) : null}

      <div class="mt-8">
        <p class="eyebrow mb-3">Ownership history</p>
        <ol class="grid gap-3">
          {history.map((event) => (
            <li class="flex gap-3 border-l-2 border-[var(--line)] pl-4">
              <div>
                <p class="text-sm font-semibold">{eventLabel[event.event] ?? event.event}</p>
                <p class="mt-0.5 text-xs text-[var(--muted)]">{formatDual(event.created_at)}</p>
                {event.reference_id ? (
                  <p class="mt-0.5 font-mono text-[0.56rem] uppercase tracking-[0.08em] text-[var(--muted)]">
                    {event.reference_type} · {event.reference_id}
                  </p>
                ) : null}
              </div>
            </li>
          ))}
        </ol>
        {draws.length ? (
          <div class="mt-5 border-t border-[var(--line)] pt-4">
            <p class="eyebrow">Draw receipt</p>
            {draws.map((draw) => (
              <p class="mt-1 text-sm text-[var(--muted)]">
                Pool revision {draw.pool_revision} · paid{" "}
                <span class="font-mono text-[var(--brass)]">✦ {draw.price}</span> ·{" "}
                {formatDual(draw.created_at)}
              </p>
            ))}
          </div>
        ) : null}
      </div>
    </div>
  </div>
</PlayerLayout>
