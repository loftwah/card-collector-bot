---
import PlayerLayout from "../../layouts/PlayerLayout.astro";
import TradeDesk from "../../components/player/TradeDesk";
import { pageContext } from "../../server/page";
import { listTrades, listGifts } from "../../server/modules/trades";
import { getInventory, listTenantMembers } from "../../server/modules/collection";

const ctx = await pageContext(Astro.request);
const user = ctx.user!;
const [trades, inventory, members, gifts] = await Promise.all([
  listTrades(ctx),
  getInventory(ctx, { limit: 200 }),
  listTenantMembers(ctx),
  listGifts(ctx),
]);
---

<PlayerLayout title="Trades · Foilbury">
  <header class="trades-page-head">
    <h1 class="page-title mt-2">Trades</h1>
    <p class="mt-3 max-w-2xl text-[var(--muted)]">
      Exchange exact card copies with human members. Every offer reserves both sides and moves
      atomically. NPC collectors are labelled NPC and are read-only in this release.
    </p>
  </header>
  <div class="mt-6">
    <TradeDesk
      client:load
      currentUserId={user.id}
      initialTrades={trades}
      inventory={inventory.map((item) => ({
        id: item.id,
        card_name: item.card_name,
        variant_name: item.variant_name,
        serial: item.serial,
        render_url: item.render_url,
        favourite: item.favourite,
        locked: item.locked,
        status: item.status,
      }))}
      members={members}
      initialGifts={gifts}
    />
  </div>
</PlayerLayout>
