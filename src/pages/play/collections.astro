---
import PlayerLayout from "../../layouts/PlayerLayout.astro";
import { pageContext } from "../../server/page";
import { listCollections, collectionProgress } from "../../server/modules/collections";
import { collectionBanner, collectionMark } from "../../lib/collection-art";

const ctx = await pageContext(Astro.request);
const collections = await listCollections(ctx);
const progressEntries = await Promise.all(
  collections.map(
    async (collection) => [collection.id, await collectionProgress(ctx, collection.id)] as const,
  ),
);
const progress = new Map<string, Awaited<ReturnType<typeof collectionProgress>>>(progressEntries);

const q = (Astro.url.searchParams.get("q") ?? "").trim();
const statusFilter = Astro.url.searchParams.get("status") ?? "all";
const sort = Astro.url.searchParams.get("sort") ?? "progress";

const finishKeys = ["plain", "silver", "gold", "holographic"] as const;

const enriched = collections.map((collection, index) => {
  const stat = progress.get(collection.id);
  const total = stat?.total_cards ?? 0;
  const owned = Math.min(stat?.owned_cards ?? 0, total);
  const cardCount = collection.card_count;
  const state =
    total === 0
      ? "unavailable"
      : owned >= total
        ? "complete"
        : owned > 0
          ? "in-progress"
          : "unstarted";
  const pct = total > 0 ? Math.round((owned / total) * 100) : 0;
  const finishes = stat?.finishes ?? {};
  const finishStarted = finishKeys.filter((key) => (finishes[key]?.owned ?? 0) > 0).length;
  const finishMastered = finishKeys.filter(
    (key) => (finishes[key]?.total ?? 0) > 0 && (finishes[key]?.owned ?? 0) >= (finishes[key]?.total ?? 0),
  ).length;
  return {
    collection,
    stat,
    total,
    owned,
    cardCount,
    state,
    pct,
    finishStarted,
    finishMastered,
    index,
  };
});

const playable = enriched.filter((item) => item.total > 0);
const completeCount = playable.filter((item) => item.state === "complete").length;
const inProgress = playable.filter((item) => item.state === "in-progress");
const continueItem = [...inProgress].sort((a, b) => b.pct - a.pct)[0] ?? null;

const matchesStatus = (item: (typeof playable)[number]) => {
  if (statusFilter === "in-progress") return item.state === "in-progress";
  if (statusFilter === "complete") return item.state === "complete";
  if (statusFilter === "unstarted") return item.state === "unstarted";
  return true;
};

const searchable = (item: (typeof playable)[number]) =>
  `${item.collection.name} ${item.collection.description} ${item.collection.source_work ?? ""}`.toLowerCase();

const filtered = playable
  .filter((item) => (q ? searchable(item).includes(q.toLowerCase()) : true))
  .filter(matchesStatus)
  .sort((a, b) => {
    if (sort === "name") return a.collection.name.localeCompare(b.collection.name);
    if (sort === "least") return a.pct - b.pct || a.collection.name.localeCompare(b.collection.name);
    const order: Record<string, number> = {
      "in-progress": 0,
      unstarted: 1,
      complete: 2,
      unavailable: 3,
    };
    const byState = (order[a.state] ?? 99) - (order[b.state] ?? 99);
    if (byState !== 0) return byState;
    return b.pct - a.pct || a.collection.name.localeCompare(b.collection.name);
  });

const PAGE_SIZE = 9;
const requestedPage = Math.max(1, Math.floor(Number(Astro.url.searchParams.get("page") ?? 1) || 1));
const pageCount = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
const currentPage = Math.min(requestedPage, pageCount);
const pageItems = filtered.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);

function pageHref(page: number) {
  const params = new URLSearchParams();
  if (q) params.set("q", q);
  if (statusFilter !== "all") params.set("status", statusFilter);
  if (sort !== "progress") params.set("sort", sort);
  if (page > 1) params.set("page", String(page));
  const query = params.toString();
  return `/play/collections${query ? `?${query}` : ""}`;
}

const labelFor = (item: (typeof playable)[number]) => {
  if (item.state === "complete") return "Roster complete";
  if (item.state === "unstarted") return "Not started";
  return `${item.owned} of ${item.total} subjects`;
};

const cardWord = (count: number) => `${count} ${count === 1 ? "card" : "cards"}`;
const audienceLabel = (audience: string) =>
  audience === "public" ? "Public showcase" : audience === "private" ? "Private" : "Member album";
---

<PlayerLayout title="Collections · Foilbury">
  <section class="collections-head border-b border-[var(--line)] pb-6">
    <div class="flex flex-wrap items-end justify-between gap-5">
      <div class="max-w-3xl">
        <h1 class="page-title mt-2">Collections</h1>
        <p class="mt-3 max-w-2xl text-[var(--muted)]">
          Every collection you can open in this Bot. Roster progress counts the subjects you own;
          finish progress is a separate goal.
        </p>
        <p class="mt-2 text-sm text-[var(--muted)]">
          {completeCount} of {playable.length} rosters complete.
          {continueItem ? (
            <span>
              {" "}
              <a class="underline underline-offset-4" href={`/play/collection?collection=${continueItem.collection.slug}`}>
                Continue with {continueItem.collection.name}
              </a>
              .
            </span>
          ) : null}
        </p>
      </div>
      <a class="btn btn-secondary btn-sm" href="/play/collection">
        My cards
      </a>
    </div>

    <form
      method="get"
      action="/play/collections"
      class="collections-toolbar mt-6 border-t border-[var(--line)] pt-5"
    >
      <label class="field collections-toolbar__search">
        <span class="label">Search collections</span>
        <input
          class="input"
          type="search"
          name="q"
          value={q}
          placeholder="Name, description or source"
        />
      </label>
      <label class="field">
        <span class="label">Status</span>
        <select class="select" name="status">
          <option value="all" selected={statusFilter === "all"}>All</option>
          <option value="in-progress" selected={statusFilter === "in-progress"}>Started</option>
          <option value="unstarted" selected={statusFilter === "unstarted"}>Not started</option>
          <option value="complete" selected={statusFilter === "complete"}>Complete</option>
        </select>
      </label>
      <label class="field">
        <span class="label">Sort</span>
        <select class="select" name="sort">
          <option value="progress" selected={sort === "progress"}>Progress first</option>
          <option value="least" selected={sort === "least"}>Least complete</option>
          <option value="name" selected={sort === "name"}>Name A–Z</option>
        </select>
      </label>
      <div class="flex items-end gap-2">
        <button class="btn btn-primary btn-sm" type="submit">Apply</button>
        <a class="btn btn-ghost btn-sm" href="/play/collections">Reset</a>
      </div>
    </form>
  </section>

  <section class="mt-7">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <p class="text-sm text-[var(--muted)]" role="status">
        {filtered.length === 0
          ? "No collections match"
          : `${(currentPage - 1) * PAGE_SIZE + 1}–${Math.min(currentPage * PAGE_SIZE, filtered.length)} of ${filtered.length} matching collections`}
      </p>
      {inProgress.length ? (
        <p class="font-mono text-[0.62rem] uppercase tracking-[0.12em] text-[var(--muted)]">
          {inProgress.length} in progress
        </p>
      ) : null}
    </div>

    <div class="collection-tile-grid mt-4">
      {pageItems.map((item) => {
        const { collection, owned, total, pct, cardCount, finishStarted, finishMastered, index } = item;
        const banner = collectionBanner(collection);
        const mark = collectionMark(collection);
        return (
          <article class="collection-tile" data-tone={index % 4}>
            <div class:list={["collection-tile__art", !banner && "collection-tile__art--mark"]}>
              {banner ? (
                <img
                  src={banner}
                  alt=""
                  loading={index < 3 ? "eager" : "lazy"}
                  fetchpriority={index === 0 ? "high" : "auto"}
                  width="1600"
                  height="900"
                />
              ) : (
                <span class="collection-tile__fallback" aria-hidden="true">
                  {mark ? <img src={mark} alt="" width="512" height="512" loading="lazy" /> : null}
                  <span>{collection.name}</span>
                </span>
              )}
              <span class="collection-tile__audience">{audienceLabel(collection.view_audience)}</span>
            </div>

            <div class="collection-tile__body">
              <div class="collection-tile__heading">
                <h2 class="collection-tile__name">
                  <a href={`/play/collection?collection=${collection.slug}`}>{collection.name}</a>
                </h2>
                <span class="collection-tile__count">{owned}/{total}</span>
              </div>
              <p class="collection-tile__description">
                {collection.description || "A curated collection."}
              </p>

              <div class="collection-tile__progress">
                <div class="flex items-baseline justify-between gap-3">
                  <span class="collection-tile__label">Roster</span>
                  <span class="collection-tile__value">{labelFor(item)}</span>
                </div>
                <div
                  class="collection-tile__bar"
                  role="progressbar"
                  aria-valuemin="0"
                  aria-valuemax={total}
                  aria-valuenow={owned}
                  aria-label={`${collection.name} roster progress`}
                >
                  <span style={`width:${pct}%`}></span>
                </div>
              </div>

              <div class="collection-tile__finish">
                <span class="collection-tile__label">Finishes</span>
                <span class="collection-tile__value">
                  {finishStarted} of 4 started{finishMastered ? ` · ${finishMastered} mastered` : ""}
                </span>
              </div>

              <div class="collection-tile__actions">
                <a class="btn btn-primary btn-sm" href={`/play/collection?collection=${collection.slug}`}>
                  Open collection
                </a>
                <a
                  class="btn btn-secondary btn-sm"
                  href={`/play/collection?collection=${collection.slug}#my-cards`}
                >
                  My cards
                </a>
              </div>

              <p class="collection-tile__meta">
                {collection.source_work ??
                  (collection.scope === "global" ? "Foilbury original" : "This Bot")}
                <span aria-hidden="true"> · </span>
                {cardWord(cardCount)}
              </p>
            </div>
          </article>
        );
      })}
    </div>

    {pageCount > 1 ? (
      <nav
        class="mt-7 flex flex-wrap items-center justify-between gap-3 border-t border-[var(--line)] pt-5"
        aria-label="Collection pages"
      >
        <a
          class:list={[
            "btn btn-secondary btn-sm",
            currentPage === 1 && "pointer-events-none opacity-40",
          ]}
          href={pageHref(currentPage - 1)}
          aria-disabled={currentPage === 1}
        >
          Previous
        </a>
        <div class="flex flex-wrap items-center gap-1">
          {Array.from({ length: pageCount }, (_, index) => index + 1).map((page) => (
            <a
              href={pageHref(page)}
              aria-current={page === currentPage ? "page" : undefined}
              class:list={[
                "inline-flex min-h-9 min-w-9 items-center justify-center border px-2 font-mono text-xs no-underline",
                page === currentPage
                  ? "border-[var(--signal)] bg-[var(--signal)] text-[var(--signal-ink)]"
                  : "border-[var(--line-strong)] hover:border-[var(--signal)]",
              ]}
            >
              {page}
            </a>
          ))}
        </div>
        <a
          class:list={[
            "btn btn-secondary btn-sm",
            currentPage === pageCount && "pointer-events-none opacity-40",
          ]}
          href={pageHref(currentPage + 1)}
          aria-disabled={currentPage === pageCount}
        >
          Next
        </a>
      </nav>
    ) : null}

    {filtered.length === 0 ? (
      <div class="empty mt-8">
        <div>
          <p class="display-sm text-2xl">
            {playable.length === 0 ? "No collections are open yet." : "No collections match those filters."}
          </p>
          <p class="mt-2 text-sm">
            {playable.length === 0
              ? "Ask the album owner to publish a collection for this Bot."
              : "Try another search, or reset the filters."}
          </p>
          {playable.length > 0 ? (
            <a class="btn btn-secondary btn-sm mt-4" href="/play/collections">
              Reset filters
            </a>
          ) : null}
        </div>
      </div>
    ) : null}
  </section>
</PlayerLayout>
