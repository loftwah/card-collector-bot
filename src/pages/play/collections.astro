---
import PlayerLayout from "../../layouts/PlayerLayout.astro";
import { pageContext } from "../../server/page";
import { listCollections, collectionProgress } from "../../server/modules/collections";
import { getInventory } from "../../server/modules/collection";

const ctx = await pageContext(Astro.request);
const user = ctx.user!;
const [collections, inventory] = await Promise.all([listCollections(ctx), getInventory(ctx, { limit: 500 })]);
const progress = new Map<string, Awaited<ReturnType<typeof collectionProgress>>>();
for (const collection of collections) {
  progress.set(collection.id, await collectionProgress(ctx, collection.id));
}
const coverFor = (id: string) => {
  const collection = collections.find((item) => item.id === id);
  if (collection?.banner_url) return collection.banner_url;
  const card = inventory.find((item) => item.collection_name === collection?.name);
  return card?.thumbnail_url ?? card?.render_url ?? null;
};
const ownedByCollection = new Map<string, number>();
for (const item of inventory) {
  if (!item.collection_name) continue;
  ownedByCollection.set(item.collection_name, (ownedByCollection.get(item.collection_name) ?? 0) + 1);
}
---
<PlayerLayout title="Worlds · Foilbury">
  <section class="border-b border-[var(--line)] pb-7">
    <p class="text-[0.68rem] uppercase tracking-[0.16em] text-[var(--coral)]">Your worlds</p>
    <div class="mt-3 flex flex-wrap items-end justify-between gap-5">
      <div>
        <h2 class="display text-[clamp(2.8rem,7vw,5.6rem)]">Every world you can enter.</h2>
        <p class="mt-4 max-w-2xl text-[var(--muted)]">Each collection has its own cast, visual language and source boundary. Progress counts the subjects you actually own; variants are a separate collection goal.</p>
      </div>
      <div class="text-right">
        <p class="text-[0.6rem] uppercase tracking-[0.12em] text-[var(--muted)]">Available</p>
        <p class="display-sm mt-1 text-4xl">{collections.length}</p>
        <p class="text-xs text-[var(--muted)]">{collections.filter((item) => item.enabled).length} enabled for this Bot</p>
      </div>
    </div>
  </section>

  <section class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    {collections.map((collection, index) => {
      const stat = progress.get(collection.id);
      const pct = stat && stat.total_cards ? Math.round((stat.owned_cards / stat.total_cards) * 100) : 0;
      const cover = coverFor(collection.id);
      return (
        <a href={`/play/collection?collection=${collection.slug}`} class="world-card group no-underline" data-tone={index % 4}>
          <div class="world-card__art">
            {cover ? <img src={cover} alt="" loading="lazy" width="750" height="1050" /> : <div class="world-card__fallback">{collection.name.charAt(0)}</div>}
            <div class="world-card__wash" aria-hidden="true"></div>
            <div class="world-card__head">
              {collection.logo_url ? <img src={collection.logo_url} alt="" class="world-card__mark" width="52" height="52" loading="lazy" /> : <span class="world-card__monogram">{collection.name.charAt(0)}</span>}
              <span class="world-card__audience">{collection.view_audience === "public" ? "Public showcase" : collection.view_audience === "private" ? "Private" : "Members"}</span>
            </div>
          </div>
          <div class="p-4">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <h3 class="display-sm text-2xl leading-tight">{collection.name}</h3>
                <p class="mt-1 line-clamp-2 text-sm text-[var(--muted)]">{collection.description || "A curated world."}</p>
              </div>
              <span class="whitespace-nowrap font-mono text-[0.56rem] uppercase tracking-[0.08em] text-[var(--muted)]">{stat?.owned_cards ?? 0}/{stat?.total_cards ?? collection.card_count}</span>
            </div>
            <div class="mt-4 h-1.5 bg-[var(--paper-3)]" role="progressbar" aria-valuemin="0" aria-valuemax={stat?.total_cards ?? collection.card_count} aria-valuenow={stat?.owned_cards ?? 0} aria-label={`${collection.name} base-card progress`}>
              <div class="h-full bg-[var(--brass)]" style={`width:${pct}%`}></div>
            </div>
            <div class="mt-3 flex flex-wrap items-center justify-between gap-2 font-mono text-[0.54rem] uppercase tracking-[0.08em] text-[var(--muted)]">
              <span>{collection.source_work ?? (collection.scope === "global" ? "Foilbury world" : "This Bot")}</span>
              <span>{collection.scope === "global" ? "Global" : "Bot"} · {collection.card_count} cards</span>
            </div>
          </div>
        </a>
      );
    })}
  </section>
  {collections.length === 0 ? <div class="empty mt-8"><div><p class="display-sm text-2xl">No worlds are open yet.</p><p class="mt-2 text-sm">Ask the album owner to enable a collection for this Bot.</p></div></div> : null}
</PlayerLayout>
