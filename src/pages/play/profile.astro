---
import PlayerLayout from "../../layouts/PlayerLayout.astro";
import AchievementBadge from "../../components/player/AchievementBadge.astro";
import ShareLinkButton from "../../components/player/ShareLinkButton";
import ShareManager from "../../components/player/ShareManager";
import ProfileCustomiser from "../../components/player/ProfileCustomiser";
import ProfileCard from "../../components/player/ProfileCard.astro";
import { pageContext } from "../../server/page";
import { countInventory, getInventory } from "../../server/modules/collection";
import { listAchievements } from "../../server/modules/achievements";
import { listCollections } from "../../server/modules/collections";
import { getPreferences, listShareLinks } from "../../server/modules/economy";
import { first } from "../../server/db";
import { printTitle } from "../../lib/utils";

const ctx = await pageContext(Astro.request);
const user = ctx.user!;
const [favourites, recent, totalCopies, subjectRow, membership, achievements, collections, shares, prefs] =
  await Promise.all([
    getInventory(ctx, { limit: 12, favourite: true }),
    getInventory(ctx, { limit: 1 }),
    countInventory(ctx),
    first<{ subjects: number }>(
      ctx.db,
      `SELECT COUNT(DISTINCT card_id) AS subjects FROM fb_card_instances
        WHERE tenant_id = ? AND user_id = ? AND status IN ('owned','reserved')`,
      ctx.tenant.id,
      user.id,
    ),
    first<{ created_at: string }>(
      ctx.db,
      `SELECT created_at FROM fb_memberships
        WHERE tenant_id = ? AND user_id = ? ORDER BY created_at LIMIT 1`,
      ctx.tenant.id,
      user.id,
    ),
    listAchievements(ctx, user.id),
    listCollections(ctx),
    listShareLinks(ctx),
    getPreferences(ctx),
  ]);

const earned = achievements.filter((item) => item.state === "earned");
const featured = favourites[0] ?? recent[0] ?? null;
const featuredIsFavourite = Boolean(featured?.favourite);
const showcase = favourites.slice(1, 5);
const binderCards = [featured, ...showcase]
  .filter((card): card is NonNullable<typeof card> => Boolean(card))
  .slice(0, 4);
const displayedWorlds = collections.slice(0, 3);
const initials = (user.displayName || "Collector")
  .split(/\s+/)
  .filter(Boolean)
  .map((part) => part[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();
const memberSince = membership?.created_at
  ? new Date(membership.created_at).toLocaleDateString("en-AU", {
      year: "numeric",
      month: "short",
      day: "numeric",
      timeZone: "Australia/Melbourne",
    })
  : null;
const starterLooks = [
  {
    key: "quiet",
    name: "Quiet archive",
    note: "One specimen, generous space, quiet labels.",
  },
  {
    key: "signal",
    name: "Signal room",
    note: "A centred card with a periwinkle signal band.",
  },
  {
    key: "binder",
    name: "Binder desk",
    note: "Four copies on a working grid.",
  },
  {
    key: "night",
    name: "Night shelf",
    note: "A low row of cards on a dark shelf.",
  },
];
---

<PlayerLayout title="Collector profile · Foilbury">
  <div class="profile-page" data-profile-look={prefs.profile_look}>
  <section class="profile-hero">
    <div class="profile-hero__identity">
      <span class="profile-avatar" aria-hidden="true">{initials}</span>
      <div class="min-w-0">
        <h1 class="page-title mt-1">{user.displayName}</h1>
        <p class="profile-hero__meta">
          Foilbury collector{memberSince ? ` · member since ${memberSince}` : ""}
        </p>
        <p class="profile-hero__lede">
          A curated view of what you keep. Favourites, collection progress and the badges you
          actually earned. Your wallet, email and account ID are not part of this page.
        </p>
        <p class="profile-hero__bio" data-profile-bio>{prefs.profile_bio}</p>
      </div>
    </div>
    <div class="profile-hero__actions">
      <ShareLinkButton client:load kind="profile" label="Share profile" />
      <a class="btn btn-secondary btn-sm" href="#customise">Customise</a>
    </div>
    <dl class="profile-stats">
      <div>
        <dt>Subjects</dt>
        <dd>{subjectRow?.subjects ?? 0}</dd>
      </div>
      <div>
        <dt>Copies</dt>
        <dd>{totalCopies}</dd>
      </div>
      <div>
        <dt>Favourites</dt>
        <dd>{favourites.length}</dd>
      </div>
      <div>
        <dt>Badges</dt>
        <dd>{earned.length}</dd>
      </div>
    </dl>
  </section>

  <section class="profile-feature">
    {
      featured ? (
        <>
          <div class="profile-feature__art">
            {featured.render_url ? (
              <img
                src={featured.render_url}
                alt={`${featured.card_name} — ${printTitle(featured.edition_name) ?? featured.variant_name}`}
                width="750"
                height="1050"
                loading="eager"
              />
            ) : (
              <div class="card-face-fallback">{featured.card_name.charAt(0)}</div>
            )}
          </div>
          <div class="profile-feature__copy">
            <h2 class="profile-feature__name">{featured.card_name}</h2>
            <p class="profile-feature__meta">
              {printTitle(featured.edition_name) ? `${printTitle(featured.edition_name)} · ` : ""}
              {featured.variant_name}
            </p>
            <p class="profile-feature__serial">{featured.serial}</p>
            <p class="profile-feature__note">
              {featuredIsFavourite
                ? "Pinned from your favourites."
                : "Featured from your library. Favourite a card to pin it here."}
              The card object is shown as saved; the controls sit outside it.
            </p>
            <div class="profile-feature__actions">
              <a class="btn btn-primary btn-sm" href={`/play/card/${featured.id}`}>
                Inspect this copy
              </a>
              <a class="btn btn-secondary btn-sm" href="/play/collection">
                Manage favourites
              </a>
            </div>
          </div>
        </>
      ) : (
        <div class="profile-feature__empty">
          <div>
            <p class="display-sm text-2xl">No favourite pinned yet.</p>
            <p class="mt-2 text-sm">
              Favourite a card in your collection and it becomes the featured specimen here.
            </p>
            <a class="btn btn-primary btn-sm mt-4" href="/play/collection">
              Choose a card
            </a>
          </div>
        </div>
      )
    }
  </section>

  <section class="profile-section">
    <div class="profile-section__head">
      <div>
        <h2 class="profile-section__title">Your shelf</h2>
      </div>
      <a class="profile-section__link" href="/play/collection">Manage favourites →</a>
    </div>
    {
      binderCards.length ? (
        <>
          {showcase.length ? (
            <div class="profile-showcase profile-showcase--rest">
              {showcase.map((card) => (
                <ProfileCard card={card} />
              ))}
            </div>
          ) : (
            <p class="profile-section__lede profile-showcase-note">
              Pin more favourites to fill this shelf.
            </p>
          )}
          <div class="profile-showcase profile-showcase--binder">
            {binderCards.map((card) => (
              <ProfileCard card={card} />
            ))}
          </div>
        </>
      ) : (
        <div class="empty mt-5">
          <div>
            <p class="display-sm text-2xl">Your shelf is waiting.</p>
            <p class="mt-2 text-sm">
              Favourite more cards to arrange a small public-safe showcase.
            </p>
          </div>
        </div>
      )
    }
  </section>

  <ProfileCustomiser
    client:load
    initialLook={prefs.profile_look}
    initialBio={prefs.profile_bio}
    looks={starterLooks}
    cards={binderCards.map((card) => ({
      id: card.id,
      card_name: card.card_name,
      render_url: card.render_url,
      thumbnail_url: card.thumbnail_url,
    }))}
  />

  <section class="profile-section">
    <div class="profile-section__head">
      <div>
        <h2 class="profile-section__title">What you have unlocked</h2>
      </div>
      <a class="profile-section__link" href="/play/achievements">All achievements →</a>
    </div>
    {
      earned.length ? (
        <div class="profile-badges">
          {earned.slice(0, 6).map((item) => (
            <div class="profile-badge">
              <AchievementBadge
                artKey={item.art_key}
                name={item.name}
                category={item.category}
                earned
                size={48}
                emblemUrl={item.collection_logo_url}
              />
              <div class="min-w-0">
                <p class="profile-badge__name">{item.name}</p>
                <p class="profile-badge__meta">{item.category} · earned</p>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="empty mt-5">
          <div>
            <p class="display-sm text-2xl">Your first badge is one capsule away.</p>
            <p class="mt-2 text-sm">Open a capsule or complete a daily mission to begin.</p>
            <a class="btn btn-primary btn-sm mt-4" href="/play/draw">Open a capsule</a>
          </div>
        </div>
      )
    }
  </section>

  <section class="profile-section">
    <div class="profile-section__head">
      <div>
        <h2 class="profile-section__title">Worlds in your library</h2>
      </div>
      <a class="profile-section__link" href="/play/collections">All collections →</a>
    </div>
    <div class="profile-worlds">
      {displayedWorlds.map((collection) => (
        <a class="profile-world" href={`/play/collection?collection=${collection.slug}`}>
          {collection.logo_url ? (
            <img src={collection.logo_url} alt="" width="40" height="40" loading="lazy" />
          ) : (
            <span class="profile-world__mark" aria-hidden="true">
              {collection.name.charAt(0)}
            </span>
          )}
          <span class="min-w-0">{collection.name}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="profile-section">
    <div class="profile-section__head">
      <div>
        <h2 class="profile-section__title">Shared links</h2>
      </div>
      <a class="profile-section__link" href="/play/preferences">Sharing settings →</a>
    </div>
    <ShareManager client:load initial={shares} />
  </section>
  </div>
</PlayerLayout>
