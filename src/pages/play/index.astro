---
import PlayerLayout from "../../layouts/PlayerLayout.astro";
import ClaimButton from "../../components/player/ClaimButton";
import LayeredCard from "../../components/player/LayeredCard";
import { pageContext } from "../../server/page";
import { getWalletSummary } from "../../server/modules/wallet";
import { getInventory } from "../../server/modules/collection";
import { listSets } from "../../server/modules/catalogue";
import { getEconomy, getPreferences } from "../../server/modules/economy";
import { getPoolPreview, listPools } from "../../server/modules/pools";
import { listCollections } from "../../server/modules/collections";
import { listTrades } from "../../server/modules/trades";
import { first } from "../../server/db";
import { listAchievements } from "../../server/modules/achievements";
import AchievementBadge from "../../components/player/AchievementBadge.astro";
import { formatDateTime, formatDual } from "../../lib/utils";

const ctx = await pageContext(Astro.request);
const user = ctx.user!;
const [wallet, inventory, sets, economy, prefs, pools, trades, lastClaim, cabinetPool, collections, achievements] = await Promise.all([
  getWalletSummary(ctx.db, ctx.tenant.id, user.id, 8),
  getInventory(ctx, { limit: 12 }),
  listSets(ctx, user.id),
  getEconomy(ctx),
  getPreferences(ctx),
  listPools(ctx),
  listTrades(ctx),
  first<{ created_at: string }>(ctx.db, "SELECT created_at FROM fb_reward_claims WHERE tenant_id = ? AND user_id = ? AND rule_key = 'daily-allowance' ORDER BY created_at DESC LIMIT 1", ctx.tenant.id, user.id),
  getPoolPreview(ctx, "cabinet-draw").catch(() => null),
  listCollections(ctx),
  listAchievements(ctx, user.id),
]);
const nextEligible = lastClaim ? new Date(new Date(lastClaim.created_at).getTime() + economy.daily_cooldown_seconds * 1000).toISOString() : null;
const canClaim = !nextEligible || new Date(nextEligible) <= new Date();
const completed = sets.filter((set) => set.progress?.complete && !set.progress.claimed);
const activeTrades = trades.filter((trade) => trade.status === "open");
const featured = inventory[0];
const recent = inventory.slice(0, 8);
const enabledCollections = collections.filter((collection) => collection.enabled);
const publishedSets = sets.filter((set) => set.status === "published");
const earnedAchievements = achievements.filter((item) => item.state === "earned");
const nextAchievements = achievements
  .filter((item) => item.state !== "earned")
  .sort((a, b) => b.progress / Math.max(1, b.target) - a.progress / Math.max(1, a.target))
  .slice(0, 2);
---
<PlayerLayout title="Your cabinet · Foilbury">
  <section class="grid gap-10 lg:grid-cols-[1.08fr_0.92fr] lg:items-center">
    <div>
      <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-[var(--brass)]">Private cabinet · {ctx.tenant.name}</p>
      <h2 class="display mt-4 text-[clamp(3.4rem,7vw,6.6rem)]">Your cabinet,<br />{user.displayName.split(" ")[0]}.</h2>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-[var(--muted)]">Every card here is a real copy with a serial and a history. Open the drawer, keep the ones that matter, and let the duplicates find a new home.</p>
      <div class="mt-7 flex flex-wrap items-end gap-6 border-y border-[var(--line)] py-5">
        <div>
          <p class="font-mono text-[0.6rem] uppercase tracking-[0.14em] text-[var(--muted)]">Foil balance</p>
          <p class="display-sm mt-1 text-5xl text-[var(--brass)]">✦ {wallet.balance}</p>
        </div>
        <div class="max-w-xs flex-1">
          <p class="font-mono text-[0.6rem] uppercase tracking-[0.14em] text-[var(--muted)]">Daily allowance</p>
          <div class="mt-1"><ClaimButton client:load amount={economy.daily_reward} canClaim={canClaim} nextEligible={nextEligible ? formatDual(nextEligible) : null} /></div>
        </div>
      </div>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="btn btn-primary" href="/play/draw">Open a capsule</a>
        <a class="btn btn-secondary" href="/play/collection">Open the collection</a>
        <a class="btn btn-ghost" href="/create-bot">Create a Bot</a>
      </div>
      <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-3 text-sm">
        <div><dt class="font-mono text-[0.58rem] uppercase tracking-[0.12em] text-[var(--muted)]">Cards kept</dt><dd class="mt-0.5 font-semibold">{inventory.length}</dd></div>
        <div><dt class="font-mono text-[0.58rem] uppercase tracking-[0.12em] text-[var(--muted)]">Open offers</dt><dd class="mt-0.5 font-semibold">{activeTrades.length}</dd></div>
        <div><dt class="font-mono text-[0.58rem] uppercase tracking-[0.12em] text-[var(--muted)]">Completions ready</dt><dd class="mt-0.5 font-semibold">{completed.length}</dd></div>
        <div><dt class="font-mono text-[0.58rem] uppercase tracking-[0.12em] text-[var(--muted)]">Collections on</dt><dd class="mt-0.5 font-semibold">{enabledCollections.length}</dd></div>
      </dl>
    </div>

    <div class="relative mx-auto w-full max-w-[410px]">
      <div class="absolute inset-2 rounded-full border border-[var(--line)]" aria-hidden="true"></div>
      <div class="relative">
        {featured ? (
          <a href={`/play/card/${featured.id}`} class="block no-underline">
            <LayeredCard
              client:load
              subjectUrl={`/media/asset/${featured.subject_asset_id}`}
              backgroundUrl={featured.background_asset_id ? `/media/asset/${featured.background_asset_id}` : null}
              material={featured.material_key}
              effect={featured.effect_key}
              name={featured.card_name}
              subtitle={featured.subtitle}
              setName={featured.collection_name ?? featured.category_name ?? "Cabinet"}
              characterClass={featured.class_name}
              rarity={featured.rarity_name}
              serial={featured.serial}
              subjectWidth={featured.subject_width}
              subjectHeight={featured.subject_height}
              collectionName={featured.collection_name}
              collectionLogo={featured.collection_logo}
              collectionDescription={featured.collection_description}
            />
          </a>
        ) : (
          <div class="layered-card grid place-items-center p-10 text-center text-[#f4f0e6]">
            <div><p class="font-display text-3xl">The first card is waiting.</p><p class="mt-2 text-sm text-[#cfc8b9]">Claim the allowance, then open the cabinet pool.</p></div>
          </div>
        )}
      </div>
      <div class="mt-4 flex items-center justify-between gap-3">
        <p class="font-mono text-[0.58rem] uppercase tracking-[0.12em] text-[var(--muted)]">{featured ? `Latest · ${featured.serial}` : "No cards yet"}</p>
        {featured ? <a class="font-mono text-[0.58rem] uppercase tracking-[0.12em] text-[var(--green)]" href={`/play/card/${featured.id}`}>Inspect the card →</a> : null}
      </div>
    </div>
  </section>

  <section class="mt-14">
    <div class="flex flex-wrap items-end justify-between gap-4 border-b border-[var(--line)] pb-4">
      <div><h3 class="display-sm text-3xl">The drawers</h3><p class="mt-1 text-sm text-[var(--muted)]">Recent acquisitions. Card artwork leads; the interface stays out of the way.</p></div>
      <a class="btn btn-secondary btn-sm" href="/play/collection">All {inventory.length} cards</a>
    </div>
    {recent.length ? (
      <div class="card-grid mt-5">
        {recent.map((item) => (
          <a href={`/play/card/${item.id}`} class="group no-underline">
            <div class="card-face">
              {item.render_url ? <img src={item.thumbnail_url ?? item.render_url} alt={`${item.card_name} — ${item.variant_name}`} loading="lazy" /> : <div class="card-face-fallback">{item.card_name.charAt(0)}</div>}
            </div>
            <div class="mt-2 flex items-start justify-between gap-2"><div><p class="display-sm text-sm leading-tight">{item.card_name}</p><p class="mt-0.5 text-[0.7rem] text-[var(--muted)]">{item.variant_name} · {item.collection_name ?? item.category_name ?? "Cabinet"}</p></div>{item.favourite ? <span class="text-[var(--brass)]" title="Favourite">♥</span> : null}</div>
          </a>
        ))}
      </div>
    ) : (
      <div class="empty mt-5"><div><p class="display-sm text-2xl">The drawers are empty.</p><p class="mt-2 text-sm">Claim the daily allowance, then open the draw room.</p></div></div>
    )}
  </section>

  <section class="mt-14 grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
    <div class="border border-[var(--line)] p-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div><h3 class="display-sm text-3xl">The draw room</h3><p class="mt-1 text-sm text-[var(--muted)]">A capsule machine with visible odds. One charge, one card, one atomic receipt.</p></div>
        <a class="btn btn-primary btn-sm" href="/play/draw">Inspect odds</a>
      </div>
      {cabinetPool ? (
        <div class="mt-6 grid gap-5 sm:grid-cols-[1fr_auto] sm:items-end">
          <div>
            <p class="font-display text-2xl">{cabinetPool.pool.name}</p>
            <p class="mt-2 max-w-lg text-sm text-[var(--muted)]">{cabinetPool.eligible_count} eligible finishes from {new Set(cabinetPool.entries.map((entry) => entry.card_name)).size} identities. Revision {cabinetPool.revision}; the price is shown before any Foil leaves your wallet.</p>
            <div class="mt-4 flex flex-wrap gap-2">{enabledCollections.slice(0, 4).map((collection) => <span class="chip" data-active="true">{collection.name}</span>)}</div>
          </div>
          <div class="text-right"><p class="font-mono text-[0.58rem] uppercase tracking-[0.12em] text-[var(--muted)]">Capsule price</p><p class="font-display text-4xl text-[var(--brass)]">✦ {cabinetPool.price}</p></div>
        </div>
      ) : <p class="mt-5 text-sm text-[var(--muted)]">No active pool has a published render yet. The Bot Owner can finish the render queue in Administration.</p>}
    </div>

    <div class="grid gap-4">
      <div class="border border-[var(--line)] p-5">
        <div class="flex items-start justify-between gap-3"><h3 class="display-sm text-2xl">Collections</h3><a class="font-mono text-[0.58rem] uppercase tracking-[0.12em] text-[var(--green)]" href="/admin/collections">Manage</a></div>
        <div class="mt-4 grid gap-2">
          {enabledCollections.slice(0, 4).map((collection) => (
            <a href={`/play/collection?collection=${collection.slug}`} class="flex items-center gap-3 border border-[var(--line)] p-3 no-underline hover:border-[var(--brass)]">
              {collection.logo_url ? <img src={collection.logo_url} alt="" class="h-10 w-10 object-contain" /> : <span class="grid h-10 w-10 place-items-center border border-[var(--line)] font-display text-lg">{collection.name.charAt(0)}</span>}
              <span class="min-w-0 flex-1"><span class="block font-semibold">{collection.name}</span><span class="block truncate text-xs text-[var(--muted)]">{collection.scope === "global" ? "Global collection" : "Your Bot"} · {collection.card_count} cards</span></span>
            </a>
          ))}
          {enabledCollections.length === 0 ? <p class="text-sm text-[var(--muted)]">No collections are enabled for this Bot.</p> : null}
        </div>
      </div>
      <div class="border border-[var(--line)] p-5">
        <h3 class="display-sm text-2xl">Set progress</h3>
        <div class="mt-4 grid gap-4">
          {publishedSets.slice(0, 3).map((set) => (
            <div>
              <div class="flex items-baseline justify-between gap-2"><p class="text-sm font-semibold">{set.name}</p><span class="font-mono text-[0.6rem] text-[var(--muted)]">{set.progress?.owned ?? 0}/{set.progress?.total ?? set.cards.length}</span></div>
              <div class="mt-1.5 h-1.5 bg-[var(--paper-3)]"><div class="h-full bg-[var(--brass)]" style={`width:${set.progress?.total ? Math.round(((set.progress.owned ?? 0) / set.progress.total) * 100) : 0}%`}></div></div>
              <p class="mt-1 font-mono text-[0.54rem] uppercase tracking-[0.08em] text-[var(--muted)]">v{set.version} · {set.progress?.claimed ? "Reward claimed" : set.progress?.complete ? "Completion ready" : `✦ ${set.reward_amount} on completion`}</p>
            </div>
          ))}
          {publishedSets.length === 0 ? <p class="text-sm text-[var(--muted)]">No published sets yet.</p> : null}
        </div>
        <a class="mt-4 inline-block font-mono text-[0.58rem] uppercase tracking-[0.12em] text-[var(--green)]" href="/play/rewards">Rewards & completions →</a>
      </div>
      <div class="border border-[var(--line)] p-5">
        <div class="flex items-start justify-between gap-3">
          <div><h3 class="display-sm text-2xl">Achievements</h3><p class="mt-1 text-sm text-[var(--muted)]">Badges for the things you actually did.</p></div>
          <a class="font-mono text-[0.58rem] uppercase tracking-[0.12em] text-[var(--green)]" href="/play/achievements">All {achievements.length}</a>
        </div>
        <div class="mt-4 grid gap-2">
          {earnedAchievements.slice(0, 2).map((item) => (
            <div class="flex items-center gap-3 border border-[var(--line)] p-2.5">
              <AchievementBadge artKey={item.art_key} name={item.name} category={item.category} earned size={38} />
              <div class="min-w-0"><p class="truncate text-sm font-semibold">{item.name}</p><p class="font-mono text-[0.52rem] uppercase tracking-[0.08em] text-[var(--green)]">Earned{item.reward_amount ? ` · +${item.reward_amount} Foil` : ""}</p></div>
            </div>
          ))}
          {nextAchievements.map((item) => (
            <div class="flex items-center gap-3 border border-[var(--line)] p-2.5">
              <AchievementBadge artKey={item.art_key} name={item.name} category={item.category} size={38} />
              <div class="min-w-0 flex-1"><p class="truncate text-sm font-semibold">{item.name}</p><div class="mt-1 h-1 bg-[var(--paper-3)]"><div class="h-full bg-[var(--brass)]" style={`width:${Math.min(100, Math.round((item.progress / Math.max(1, item.target)) * 100))}%`}></div></div><p class="mt-1 font-mono text-[0.52rem] uppercase tracking-[0.08em] text-[var(--muted)]">{item.progress}/{item.target}</p></div>
            </div>
          ))}
          {achievements.length === 0 ? <p class="text-sm text-[var(--muted)]">No achievements are configured yet.</p> : null}
        </div>
        <p class="mt-4 border-t border-[var(--line)] pt-3 text-xs text-[var(--muted)]">Motion is {prefs.reduced_motion ? "reduced" : "on"}; sound is {prefs.sound_enabled ? "on" : "off"}; sharing is {prefs.sharing_enabled ? "enabled" : "off"}. <a class="text-[var(--green)]" href="/play/preferences">Adjust preferences</a></p>
      </div>
    </div>
  </section>
</PlayerLayout>
