---
import PlayerLayout from "../../layouts/PlayerLayout.astro";
import ClaimButton from "../../components/player/ClaimButton";
import PublishedCard from "../../components/player/PublishedCard";
import AchievementBadge from "../../components/player/AchievementBadge.astro";
import { pageContext } from "../../server/page";
import { getWalletSummary } from "../../server/modules/wallet";
import { countInventory, getInventory } from "../../server/modules/collection";
import { listSets } from "../../server/modules/catalogue";
import { getEconomy, getPreferences } from "../../server/modules/economy";
import { getPoolPreview } from "../../server/modules/pools";
import { listCollections } from "../../server/modules/collections";
import { listAchievements } from "../../server/modules/achievements";
import { first } from "../../server/db";
import { formatDual, printTitle as editionPrintTitle } from "../../lib/utils";
import { cabinetNextStep } from "../../lib/cabinet-next-step";

const ctx = await pageContext(Astro.request);
const user = ctx.user!;
let poolError = false;
const [
  wallet,
  inventory,
  totalCards,
  sets,
  economy,
  prefs,
  lastClaim,
  cabinetPool,
  collections,
  achievements,
] = await Promise.all([
  getWalletSummary(ctx.db, ctx.tenant.id, user.id, 8),
  getInventory(ctx, { limit: 8 }),
  countInventory(ctx),
  listSets(ctx, user.id),
  getEconomy(ctx),
  getPreferences(ctx),
  first<{ created_at: string }>(
    ctx.db,
    "SELECT created_at FROM fb_reward_claims WHERE tenant_id = ? AND user_id = ? AND rule_key = 'daily-allowance' ORDER BY created_at DESC LIMIT 1",
    ctx.tenant.id,
    user.id,
  ),
  getPoolPreview(ctx, "cabinet-draw").catch(() => {
    poolError = true;
    return null;
  }),
  listCollections(ctx),
  listAchievements(ctx, user.id),
]);
const nextEligible = lastClaim
  ? new Date(
      new Date(lastClaim.created_at).getTime() + economy.daily_cooldown_seconds * 1000,
    ).toISOString()
  : null;
const canClaim = !nextEligible || new Date(nextEligible) <= new Date();
const completed = sets.filter((set) => set.progress?.complete && !set.progress.claimed);
const featured = inventory[0] ?? null;
const recent = inventory.slice(1, 7);
const printTitleOf = (item: (typeof inventory)[number] | null) =>
  editionPrintTitle(item?.edition_name);
const featuredPrint = printTitleOf(featured);
const enabledCollections = collections.filter((collection) => collection.enabled);
const publishedSets = sets.filter((set) => set.status === "published");
const activeSet =
  [...publishedSets]
    .filter((set) => (set.progress?.owned ?? 0) > 0 && !set.progress?.complete)
    .sort(
      (a, b) =>
        (b.progress?.owned ?? 0) / Math.max(1, b.progress?.total ?? 1) -
        (a.progress?.owned ?? 0) / Math.max(1, a.progress?.total ?? 1),
    )[0] ??
  publishedSets[0] ??
  null;
const earnedAchievements = achievements.filter((item) => item.state === "earned");
const nextAchievement =
  achievements
    .filter((item) => item.state !== "earned")
    .sort((a, b) => b.progress / Math.max(1, b.target) - a.progress / Math.max(1, a.target))[0] ??
  null;
const nextMove = cabinetNextStep({
  canClaim,
  dailyReward: economy.daily_reward,
  nextEligible: nextEligible ? formatDual(nextEligible) : null,
  balance: wallet.balance,
  pool: cabinetPool,
});
---

<PlayerLayout title="Your cabinet · Foilbury">
  <section class="grid gap-6 border-b border-[var(--line)] pb-7 lg:grid-cols-[minmax(0,1fr)_340px] lg:items-end">
    <div>
      <p class="studio-kicker">Private cabinet · {ctx.tenant.name}</p>
      <h1 class="page-title mt-3">Your cabinet, {user.displayName.split(" ")[0]}.</h1>
      <p class="mt-3 max-w-xl text-[var(--muted)]">
        Every card here is a real copy with a serial and a history. Keep what matters; duplicates
        can be gifted, traded or recycled.
      </p>
      <div class="mt-5 flex flex-wrap gap-2">
        <a class="btn btn-primary" href="/play/draw">
          Open a capsule
        </a>
        <a class="btn btn-secondary" href="/play/collection">
          My cards
        </a>
        <a class="btn btn-ghost" href="/play/collections">
          Browse worlds
        </a>
      </div>
    </div>
    <div class="action-card">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="studio-stat__label">Foil balance</p>
          <p class="display-sm mt-0.5 text-4xl text-[var(--signal)]" data-foil-balance>
            ✦ {wallet.balance}
          </p>
        </div>
        <div class="text-right">
          <p class="studio-stat__label">Cards kept</p>
          <p class="display-sm mt-0.5 text-2xl">{totalCards}</p>
        </div>
      </div>
      <div class="border-t border-[var(--line)] pt-3">
        <p class="studio-stat__label">Daily allowance</p>
        <div class="mt-1.5">
          <ClaimButton
            client:load
            amount={economy.daily_reward}
            canClaim={canClaim}
            nextEligible={nextEligible ? formatDual(nextEligible) : null}
          />
        </div>
      </div>
    </div>
  </section>

  <section class="mt-7 grid gap-5 lg:grid-cols-[minmax(0,1.08fr)_minmax(0,0.92fr)] lg:items-start">
    <div class="surface p-4 sm:p-5">
      <div class="flex items-center justify-between gap-3 pb-3">
        <div>
          <p class="studio-stat__label">Latest acquisition</p>
          <p class="mt-0.5 text-sm text-[var(--muted)]">
            {featured
              ? `${featured.serial} · ${featuredPrint ? `${featuredPrint} · ` : ""}${featured.variant_name}`
              : "Nothing drawn yet"}
          </p>
        </div>
        {featured ? (
          <a
            class="font-mono text-[0.6rem] uppercase tracking-[0.1em] underline underline-offset-4"
            href={`/play/card/${featured.id}`}
          >
            Open record ↗
          </a>
        ) : null}
      </div>
      <div class="grid items-start gap-4 sm:grid-cols-[minmax(0,300px)_minmax(0,1fr)]">
        <div>
          {featured?.render_url ? (
            <PublishedCard
              client:load
              href={`/play/card/${featured.id}`}
              inspectHref={`/play/card/${featured.id}`}
              frontUrl={featured.render_url}
              backUrl={featured.back_render_url}
              name={featured.card_name}
              serial={featured.serial}
            />
          ) : (
            <div class="empty min-h-[280px]">
              <div>
                <p class="display-sm text-2xl">The first card is waiting.</p>
                <p class="mt-2 text-sm">Your first card will appear here after you open a capsule.</p>
              </div>
            </div>
          )}
        </div>
        <div class="grid gap-3">
          <div class="action-card action-card--quiet">
            <p class="studio-stat__label">Next best move</p>
            <p class="panel-title">{nextMove.title}</p>
            <p class="text-sm leading-relaxed text-[var(--muted)]">{nextMove.body}</p>
            {nextMove.kind === "claim" ? (
              <p class="font-mono text-[0.58rem] uppercase tracking-[0.1em] text-[var(--signal)]">
                Use the allowance control above
              </p>
            ) : (
              <a class="btn btn-primary btn-sm w-fit" href={nextMove.href ?? "/play/draw"}>
                {nextMove.action}
              </a>
            )}
          </div>
          <div class="kpi-grid">
            <div class="kpi">
              <p class="kpi__label">Worlds on</p>
              <p class="kpi__value">{enabledCollections.length}</p>
              <p class="kpi__hint">{publishedSets.length} releases</p>
            </div>
            <div class="kpi">
              <p class="kpi__label">Badges</p>
              <p class="kpi__value">{earnedAchievements.length}</p>
              <p class="kpi__hint">of {achievements.length}</p>
            </div>
            <div class="kpi">
              <p class="kpi__label">Completions</p>
              <p class="kpi__value">{completed.length}</p>
              <p class="kpi__hint">ready to claim</p>
            </div>
            <div class="kpi">
              <p class="kpi__label">Capsule</p>
              <p class="kpi__value">{cabinetPool ? `✦ ${cabinetPool.price}` : "—"}</p>
              <p class="kpi__hint">
                {cabinetPool ? `${cabinetPool.eligible_count} eligible` : "unavailable"}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="grid gap-4">
      {publishedSets.length ? (
        <div class="panel">
          <div class="panel-head px-4 pt-4">
            <div>
              <p class="studio-stat__label">Continue a release</p>
              <p class="panel-title mt-0.5">{activeSet?.name ?? "Sets"}</p>
            </div>
            <a class="text-xs underline underline-offset-4" href="/play/rewards">
              All rewards
            </a>
          </div>
          <div class="panel-body grid gap-3">
            {publishedSets.slice(0, 3).map((set) => {
              const owned = set.progress?.owned ?? 0;
              const total = set.progress?.total ?? set.cards.length;
              const pct = total ? Math.round((owned / total) * 100) : 0;
              return (
                <div>
                  <div class="flex items-baseline justify-between gap-2">
                    <p class="text-sm font-semibold">{set.name}</p>
                    <span class="font-mono text-[0.6rem] text-[var(--muted)]">
                      {owned}/{total}
                    </span>
                  </div>
                  <div class="mt-1.5 h-1.5 bg-[var(--paper-3)]">
                    <div class="h-full bg-[var(--signal)]" style={`width:${pct}%`}></div>
                  </div>
                  <p class="mt-1 font-mono text-[0.54rem] uppercase tracking-[0.08em] text-[var(--muted)]">
                    v{set.version} ·{" "}
                    {set.progress?.claimed
                      ? "reward claimed"
                      : set.progress?.complete
                        ? "completion ready"
                        : `✦ ${set.reward_amount} on completion`}
                  </p>
                </div>
              );
            })}
          </div>
        </div>
      ) : null}

      {nextAchievement ? (
        <div class="panel">
          <div class="panel-head px-4 pt-4">
            <div>
              <p class="studio-stat__label">Closest badge</p>
              <p class="panel-title mt-0.5">{nextAchievement.name}</p>
            </div>
            <a class="text-xs underline underline-offset-4" href="/play/achievements">
              All {achievements.length}
            </a>
          </div>
          <div class="panel-body flex items-start gap-3">
            <AchievementBadge
              artKey={nextAchievement.art_key}
              name={nextAchievement.name}
              category={nextAchievement.category}
              size={44}
            />
            <div class="min-w-0 flex-1">
              <p class="text-sm text-[var(--muted)]">{nextAchievement.description}</p>
              <p class="mt-2 font-mono text-[0.56rem] uppercase tracking-[0.08em] text-[var(--muted)]">
                {nextAchievement.progress}/{nextAchievement.target}
                {nextAchievement.reward_amount ? ` · ✦ ${nextAchievement.reward_amount}` : ""}
              </p>
              <div class="mt-1 h-1.5 bg-[var(--paper-3)]">
                <div
                  class="h-full bg-[var(--lime)]"
                  style={`width:${Math.min(100, Math.round((nextAchievement.progress / Math.max(1, nextAchievement.target)) * 100))}%`}
                ></div>
              </div>
            </div>
          </div>
        </div>
      ) : null}

      <div class="panel">
        <div class="panel-head px-4 pt-4">
          <div>
            <p class="studio-stat__label">The cabinet</p>
            <p class="panel-title mt-0.5">Your shortcuts</p>
          </div>
        </div>
        <div class="panel-body grid grid-cols-2 gap-2">
          <a class="card-toolbar__button justify-start" href="/play/missions">
            Daily missions
          </a>
          <a class="card-toolbar__button justify-start" href="/play/wishlist">
            Wishlist
          </a>
          <a class="card-toolbar__button justify-start" href="/play/gifts">
            Gifts
          </a>
          <a class="card-toolbar__button justify-start" href="/play/trades">
            Trades
          </a>
          <a class="card-toolbar__button justify-start" href="/play/profile">
            Showcase
          </a>
          <a class="card-toolbar__button justify-start" href="/play/preferences">
            Preferences
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="mt-8">
    <div class="panel-head">
      <div>
        <h2 class="panel-title">Recent acquisitions</h2>
        <p class="mt-1 text-sm text-[var(--muted)]">
          {totalCards
            ? `Showing the newest ${Math.min(recent.length, totalCards)} of ${totalCards} cards.`
            : "Your newest cards appear here."}
        </p>
      </div>
      <a class="btn btn-secondary btn-sm" href="/play/collection">
        All {totalCards} cards
      </a>
    </div>
    {recent.length ? (
      <div class="card-grid mt-4">
        {recent.map((item) => (
          <a href={`/play/card/${item.id}`} class="group block no-underline">
            <div class="card-face">
              {item.render_url ? (
                <img
                  src={item.thumbnail_url ?? item.render_url}
                  alt={`${item.card_name} — ${printTitleOf(item) ?? item.variant_name}`}
                  loading="lazy"
                  width="300"
                  height="420"
                />
              ) : (
                <div class="card-face-fallback">{item.card_name.charAt(0)}</div>
              )}
            </div>
            <p class="display-sm mt-2 text-sm leading-tight">{item.card_name}</p>
            <p class="mt-0.5 truncate text-[0.7rem] text-[var(--muted)]">
              {printTitleOf(item) ? `${printTitleOf(item)} · ` : ""}
              {item.variant_name} · {item.serial}
            </p>
          </a>
        ))}
      </div>
    ) : (
      <div class="empty mt-4">
        <div>
          <p class="display-sm text-2xl">The drawers are empty.</p>
          <p class="mt-2 text-sm">Your recent cards will appear here after your first opening.</p>
        </div>
      </div>
    )}
  </section>

  {poolError ? (
    <div class="notice mt-6 text-sm" role="status">
      The capsule preview could not be loaded just now. Your balance and cards are unaffected.{" "}
      <a class="underline underline-offset-4" href="/play/draw">
        Retry in the draw room
      </a>
      .
    </div>
  ) : null}

  <p class="mt-6 text-xs text-[var(--muted)]">
    Motion is {prefs.reduced_motion ? "reduced" : "on"}; sound is{" "}
    {prefs.sound_enabled ? "on" : "off"}; sharing is {prefs.sharing_enabled ? "enabled" : "off"}.{" "}
    <a class="underline underline-offset-4" href="/play/preferences">
      Adjust preferences
    </a>
    .
  </p>
</PlayerLayout>
