---
import PlayerLayout from "../../layouts/PlayerLayout.astro";
import DrawStudio from "../../components/player/DrawStudio";
import { pageContext } from "../../server/page";
import { listEligiblePools } from "../../server/modules/pools";
import { getWalletSummary } from "../../server/modules/wallet";
import { getEconomy, getPreferences } from "../../server/modules/economy";
import { getCabinet } from "../../server/modules/cabinet";
import { first } from "../../server/db";

const ctx = await pageContext(Astro.request);
const user = ctx.user!;
const requestedPool = Astro.url.searchParams.get("pool") ?? "";
const [eligiblePools, wallet, economy, prefs, cabinet, duplicateRow] = await Promise.all([
  listEligiblePools(ctx),
  getWalletSummary(ctx.db, ctx.tenant.id, user.id, 1),
  getEconomy(ctx),
  getPreferences(ctx),
  getCabinet(ctx).catch(() => null),
  first<{ duplicates: number }>(
    ctx.db,
    `SELECT MAX(0, COUNT(*) - COUNT(DISTINCT card_id)) AS duplicates
       FROM fb_card_instances
      WHERE tenant_id = ? AND user_id = ? AND status IN ('owned','reserved')`,
    ctx.tenant.id,
    user.id,
  ),
]);
const cheapest = eligiblePools
  .filter((preview) => preview.pool.price > 0)
  .reduce(
    (lowest, preview) => (lowest === null || preview.pool.price < lowest.price ? preview : lowest),
    null as (typeof eligiblePools)[number] | null,
  );
const closest = cabinet?.close[0] ?? null;
const duplicates = duplicateRow?.duplicates ?? 0;
const shortfall = cheapest ? Math.max(0, cheapest.pool.price - wallet.balance) : 0;
const nextAction = cheapest
  ? shortfall > 0
    ? {
        kicker: "Your next step",
        title: `Claim ${shortfall} more Foil`,
        copy: `You have ${wallet.balance} Foil. The cheapest capsule is ${cheapest.pool.name} at ${cheapest.pool.price} Foil, so the daily allowance is the next step.`,
        href: "/play/rewards",
        cta: "Claim your daily Foil",
      }
    : closest
      ? {
          kicker: "Closest shelf",
          title: `Finish ${closest.collection.name}`,
          copy: `${closest.ownedSubjects}/${closest.totalSubjects} subjects found — ${closest.missingSubjects} to go. ${closest.collection.name} is the nearest complete shelf in your cabinet.`,
          href: `/play/collection?collection=${closest.collection.slug}`,
          cta: "Open the binder",
        }
      : duplicates > 0
        ? {
            kicker: "Your next step",
            title: "Put duplicates to work",
            copy: `You hold ${duplicates} duplicate ${duplicates === 1 ? "copy" : "copies"}. Trade them with another collector or keep them for finish mastery.`,
            href: "/play/trades",
            cta: "Open trades",
          }
        : {
            kicker: "Your next step",
            title: "Open a capsule",
            copy: `${cheapest.pool.name} is ${cheapest.pool.price} Foil and has ${cheapest.eligible_count} eligible cards. The exact odds are below.`,
            href: `/play/draw?pool=${cheapest.pool.slug}`,
            cta: "Open this capsule",
          }
  : null;
---

<PlayerLayout title="Open a capsule · Foilbury">
  <header class="draw-page-head">
    <h1 class="page-title mt-2">Choose an opening</h1>
    <p class="mt-3 max-w-2xl text-[var(--muted)]">
      You get {economy.daily_reward} Foil free every day. Each capsule shows its own price
      {cheapest ? `; the cheapest open capsule is ${cheapest.pool.price} Foil` : ""}. Foil is
      earned through daily allowances, missions and achievements, never bought.
    </p>
    <p class="mt-2 max-w-2xl text-sm text-[var(--muted)]">
      Spend Foil to open one random collectible card from an eligible release pool. The exact cost,
      every eligible copy and the actual odds are shown before you commit.
    </p>
  </header>

  {nextAction ? (
    <section class="draw-next" aria-labelledby="draw-next-title">
      <div>
        <p class="eyebrow">{nextAction.kicker}</p>
        <h2 id="draw-next-title" class="draw-next__title">{nextAction.title}</h2>
        <p class="draw-next__copy">{nextAction.copy}</p>
      </div>
      <a class="btn btn-secondary btn-sm" href={nextAction.href}>{nextAction.cta}</a>
    </section>
  ) : null}

  <noscript>
    <style is:inline>
      .draw-js-only {
        display: none;
      }
    </style>
    <p class="notice mt-6">Turn on JavaScript to load capsule odds and open a card.</p>
  </noscript>

  <div class="draw-js-only mt-6">
    <DrawStudio
      client:load
      pools={eligiblePools.map((preview) => ({
        id: preview.pool.id,
        slug: preview.pool.slug,
        name: preview.pool.name,
        description: preview.pool.description,
        revision: preview.pool.revision,
        price: preview.pool.price,
        status: preview.pool.status,
        eligibleCount: preview.eligible_count,
      }))}
      initialBalance={wallet.balance}
      initialPool={requestedPool}
      dailyReward={economy.daily_reward}
      environment={ctx.config.environment}
      accountId={user.id}
      botId={ctx.tenant.id}
    />
  </div>

  <p class="draw-page-footnote mt-6">
    Foil is earned through daily allowances, missions and achievements. It is never purchased or
    cashed out. Reduced motion is {prefs.reduced_motion ? "on" : "off"} and the reveal is always
    skippable.
  </p>
</PlayerLayout>
