---
import PlayerLayout from "../../layouts/PlayerLayout.astro";
import PreferenceForm from "../../components/player/PreferenceForm";
import MemberHeader from "../../components/player/MemberHeader.astro";
import { pageContext } from "../../server/page";
import { getPreferences } from "../../server/modules/economy";
import { getTaxonomy } from "../../server/modules/catalogue";
import { listCollections } from "../../server/modules/collections";

const ctx = await pageContext(Astro.request);
const [prefs, taxonomy, collections] = await Promise.all([
  getPreferences(ctx),
  getTaxonomy(ctx),
  listCollections(ctx),
]);
const tags = (taxonomy.tags as Array<{ slug: string; name: string }>).map(({ slug, name }) => ({ slug, name }));
const choices = collections
  .filter((collection) => collection.status === "published")
  .map((collection) => ({
    id: collection.id,
    name: collection.name,
    logo_url: collection.logo_url,
    banner_url: collection.banner_url,
    audience_label: collection.audience_label,
    enabled: collection.enabled,
  }));
---

<PlayerLayout title="Preferences · Foilbury">
  <MemberHeader
    title="Preferences"
    lede="Choose what can drop for you. These choices change future eligibility only; cards, serials and earned badges stay exactly where they are."
  >
    <p class="member-head__note">
      Sharing is explicit and revocable. Turning off a collection never deletes a card you own.
    </p>
    <div slot="aside" class="flex flex-wrap gap-2">
      <a class="btn btn-secondary btn-sm" href="/account/security">Account security</a>
    </div>
  </MemberHeader>

  <div class="mt-6">
    <PreferenceForm client:load initial={prefs} tags={tags} collections={choices} />
  </div>
</PlayerLayout>
