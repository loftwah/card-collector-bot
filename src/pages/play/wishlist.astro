---
import PlayerLayout from "../../layouts/PlayerLayout.astro";
import WishlistRemoveButton from "../../components/player/WishlistRemoveButton";
import { pageContext } from "../../server/page";
import { getWishlist } from "../../server/modules/collection";
import { getCard } from "../../server/modules/catalogue";
import { first } from "../../server/db";
import { wishlistAcquisitionPaths } from "../../server/modules/wishlist-paths";
import { displayFinish } from "../../lib/utils";

const ctx = await pageContext(Astro.request);
const user = ctx.user!;
const wishes = await getWishlist(ctx);
let pathsByCard: Awaited<ReturnType<typeof wishlistAcquisitionPaths>> | null = null;
try {
  pathsByCard = await wishlistAcquisitionPaths(ctx, wishes);
} catch {
  pathsByCard = null;
}
const rows = (
  await Promise.all(
    wishes.map(async (wish) => {
      let card = null;
      try {
        card = await getCard(ctx, wish.card_id);
      } catch {
        card = null;
      }
      const targetVariant = wish.target_variant_id
        ? (card?.editions
            .flatMap((edition) => edition.variants)
            .find((variant) => variant.id === wish.target_variant_id) ?? null)
        : null;
      const renderUrl =
        targetVariant?.render_url ??
        card?.editions.flatMap((edition) => edition.variants).find((variant) => variant.render_url)
          ?.render_url ??
        null;
      const owned = await first<{ subjects: number; target: number }>(
        ctx.db,
        `SELECT COUNT(*) AS subjects,
                SUM(CASE WHEN ci.variant_id = ? THEN 1 ELSE 0 END) AS target
           FROM fb_card_instances ci
          WHERE ci.tenant_id = ? AND ci.user_id = ? AND ci.card_id = ? AND ci.status IN ('owned','reserved')`,
        wish.target_variant_id,
        ctx.tenant.id,
        user.id,
        wish.card_id,
      );
      const paths = card ? (pathsByCard?.get(wish.card_id) ?? []) : [];
      return { wish, card, targetVariant, renderUrl, owned, paths };
    }),
  )
).filter((row) => row.card !== null);
const targetLabel = (row: (typeof rows)[number]) =>
  row.targetVariant
    ? `${row.targetVariant.name}`
    : row.wish.target_material_key
      ? displayFinish(
          row.wish.target_material_key,
          row.wish.target_material_key,
          row.wish.target_effect_key,
        )
      : "Any finish";
---

<PlayerLayout title="Wishlist · Foilbury">
  <div class="border-b border-[var(--line)] pb-5">
    <p class="eyebrow">Wishlist</p>
    <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="display-sm text-4xl">What you are still looking for.</h2>
        <p class="mt-2 max-w-3xl text-sm text-[var(--muted)]">
          A wish keeps a card and finish in mind. It does not reserve a card or change your odds.
          Review eligible capsules and live odds in the draw room.
        </p>
      </div>
      <span class="badge">{rows.length} wanted</span>
    </div>
  </div>

  {rows.length === 0 ? (
    <div class="empty mt-6">
      <div>
        <p class="display-sm text-2xl">Nothing on the wishlist yet.</p>
        <p class="mt-2 text-sm">
          Open a card you own and choose a finish, or browse your collection to add a subject.
        </p>
        <div class="mt-4 flex flex-wrap justify-center gap-2">
          <a class="btn btn-primary btn-sm" href="/play/collection">
            Browse my cards
          </a>
          <a class="btn btn-secondary btn-sm" href="/play/draw">
            Open a capsule
          </a>
        </div>
      </div>
    </div>
  ) : (
    <ul class="mt-6 grid gap-3">
      {rows.map((row) => (
        <li class="grid grid-cols-[72px_minmax(0,1fr)] items-start gap-4 border border-[var(--line)] bg-[var(--paper)] p-4 sm:grid-cols-[110px_minmax(0,1fr)_auto]">
          <figure class="m-0">
            {row.renderUrl ? (
              <img
                class="aspect-[5/7] w-full border border-[var(--line)] object-contain"
                src={row.renderUrl}
                alt={row.wish.name}
                width="750"
                height="1050"
                loading="lazy"
              />
            ) : (
              <div class="grid aspect-[5/7] place-items-center bg-[var(--ink)] px-1 text-center text-xs text-[var(--brass)]">
                No published render
              </div>
            )}
          </figure>
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="display-sm text-xl uppercase [overflow-wrap:anywhere] sm:text-2xl">
                {row.wish.name}
              </h3>
              {row.owned?.subjects ? (
                <span class="badge badge-signal">Subject owned</span>
              ) : (
                <span class="badge">Not owned</span>
              )}
              {row.wish.target_variant_id && row.owned?.target ? (
                <span class="badge badge-rare">Exact finish owned</span>
              ) : null}
            </div>
            <p class="mt-1 text-sm text-[var(--muted)]">
              Wanted: <strong>{targetLabel(row)}</strong>
              {row.card?.collections.length
                ? ` · ${row.card.collections.map((collection) => collection.name).join(" · ")}`
                : ""}
            </p>
            {pathsByCard === null ? (
              <p class="mt-3 text-sm text-[var(--muted)]">
                Capsule availability could not be checked. Try the draw room again.
              </p>
            ) : row.paths.length ? (
              <div class="mt-3">
                <p class="eyebrow">Available in</p>
                <div class="mt-1 flex flex-wrap gap-2">
                  {row.paths.map((path) => (
                    <a
                      class="badge min-h-11 max-w-full whitespace-normal [overflow-wrap:anywhere] hover:border-[var(--ink)]"
                      href={`/play/draw?pool=${encodeURIComponent(path.slug)}`}
                    >
                      {path.name} · ✦ {path.price}
                    </a>
                  ))}
                </div>
                <p class="mt-1 text-xs text-[var(--muted)]">
                  Availability can change; review the current odds in the draw room.
                </p>
              </div>
            ) : (
              <p class="mt-3 text-sm text-[var(--muted)]">
                No eligible capsule is shown for this target right now. Check the draw room for
                current availability.
              </p>
            )}
          </div>
          <div class="col-start-2 sm:col-start-auto">
            <WishlistRemoveButton client:load cardId={row.wish.card_id} name={row.wish.name} />
          </div>
        </li>
      ))}
    </ul>
  )}
</PlayerLayout>
