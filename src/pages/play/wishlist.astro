---
import PlayerLayout from "../../layouts/PlayerLayout.astro";
import WishlistRemoveButton from "../../components/player/WishlistRemoveButton";
import MemberHeader from "../../components/player/MemberHeader.astro";
import { pageContext } from "../../server/page";
import { getWishlist } from "../../server/modules/collection";
import { getCard } from "../../server/modules/catalogue";
import { all, first } from "../../server/db";
import { displayFinish } from "../../lib/utils";

const ctx = await pageContext(Astro.request);
const user = ctx.user!;
const wishes = await getWishlist(ctx);
const rows = await Promise.all(
  wishes.map(async (wish) => {
    let card = null;
    try {
      card = await getCard(ctx, wish.card_id);
    } catch {
      card = null;
    }
    const targetVariant = wish.target_variant_id
      ? card?.editions.flatMap((edition) => edition.variants).find((variant) => variant.id === wish.target_variant_id) ?? null
      : null;
    const renderVariant = targetVariant?.render_url
      ? targetVariant
      : card?.editions.flatMap((edition) => edition.variants).find((variant) => variant.render_url) ?? null;
    const renderUrl = renderVariant?.render_url ?? null;
    const [owned, paths] = await Promise.all([
      first<{ subjects: number; target: number }>(
        ctx.db,
        `SELECT COUNT(*) AS subjects,
                SUM(CASE WHEN ci.variant_id = ? THEN 1 ELSE 0 END) AS target
           FROM fb_card_instances ci
          WHERE ci.tenant_id = ? AND ci.user_id = ? AND ci.card_id = ? AND ci.status IN ('owned','reserved')`,
        wish.target_variant_id,
        ctx.tenant.id,
        user.id,
        wish.card_id,
      ),
      card
        ? all<{ slug: string; name: string; price: number; variants: number }>(
            ctx.db,
            `SELECT p.slug, p.name, p.price, COUNT(DISTINCT pe.variant_id) AS variants
               FROM fb_pool_entries pe
               JOIN fb_pools p ON p.id = pe.pool_id AND p.revision = pe.pool_revision
               JOIN fb_variants v ON v.id = pe.variant_id
              WHERE pe.tenant_id = ? AND p.status = 'active' AND pe.enabled = 1 AND v.status = 'published' AND v.card_id = ?
                AND (? IS NULL OR v.id = ?)
              GROUP BY p.id ORDER BY p.price, p.name`,
            ctx.tenant.id,
            wish.card_id,
            wish.target_variant_id,
            wish.target_variant_id,
          )
        : Promise.resolve([]),
    ]);
    return { wish, card, targetVariant, renderVariant, renderUrl, owned, paths };
  }),
);
const targetLabel = (row: (typeof rows)[number]) =>
  row.targetVariant
    ? `${row.targetVariant.name}`
    : row.wish.target_material_key
      ? displayFinish(row.wish.target_material_key, row.wish.target_material_key, row.wish.target_effect_key)
      : "Any finish";
const exactOwned = rows.filter((row) => row.wish.target_variant_id && row.owned?.target).length;
const subjectOwned = rows.filter((row) => row.owned?.subjects).length;
---

<PlayerLayout title="Wishlist · Foilbury">
  <MemberHeader
    title="Wishlist"
    lede="A personal list of subjects and exact finishes you want. It does not reserve a card, hold inventory or change another member's odds."
  >
    <p class="member-head__note">
      {rows.length
        ? `${subjectOwned} of ${rows.length} wanted subject${rows.length === 1 ? "" : "s"} already in your library.`
        : "Add a subject from a card or collection."}
    </p>
    <dl slot="aside" class="member-stats">
      <div class="member-stat">
        <dt>Wanted</dt>
        <dd>{rows.length}</dd>
      </div>
      <div class="member-stat">
        <dt>Exact finish owned</dt>
        <dd>{exactOwned}</dd>
      </div>
    </dl>
  </MemberHeader>

  {rows.length === 0 ? (
    <section class="member-section">
      <div class="member-empty">
        <div>
          <h2>Nothing on the wishlist yet.</h2>
          <p>
            Open a card you own and choose a finish, or browse your collection to add a subject.
            A wish is a personal goal; it never changes the draw distribution.
          </p>
          <div class="member-empty__actions">
            <a class="btn btn-primary" href="/play/collection">Browse my cards</a>
            <a class="btn btn-secondary" href="/play/draw">Open a capsule</a>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section class="member-section">
      <ul class:list={["wishlist-list", rows.length === 1 && "wishlist-list--single"]}>
        {rows.map((row) => (
          <li class="wishlist-item">
            <figure class="wishlist-item__object m-0">
              {row.renderUrl ? (
                <img
                  src={row.renderUrl}
                  alt={`${row.wish.name} — ${row.renderVariant?.name ?? targetLabel(row)}`}
                  width="750"
                  height="1050"
                  loading="eager"
                  decoding="async"
                />
              ) : (
                <span class="wishlist-item__fallback">No published render</span>
              )}
            </figure>

            <div class="min-w-0">
              <h2 class="wishlist-item__name">{row.wish.name}</h2>
              <p class="wishlist-item__want">
                Wanted: <strong>{targetLabel(row)}</strong>
                {row.card?.collections.length
                  ? ` · ${row.card.collections.map((collection) => collection.name).join(" · ")}`
                  : ""}
              </p>

              <div class="wishlist-item__badges">
                {row.owned?.subjects ? (
                  <span class="badge badge-signal">Subject owned</span>
                ) : (
                  <span class="badge">Not owned</span>
                )}
                {row.wish.target_variant_id && row.owned?.target ? (
                  <span class="badge badge-rare">Exact finish owned</span>
                ) : null}
              </div>

              {row.paths.length ? (
                <div class="mt-3">
                  <p class="text-xs font-semibold text-[var(--muted)]">Capsules that currently list it</p>
                  <div class="wishlist-item__paths">
                    {row.paths.map((path) => (
                      <a
                        class="wishlist-item__path"
                        href={`/play/draw?pool=${encodeURIComponent(path.slug)}`}
                      >
                        {path.name} · ✦ {path.price}
                      </a>
                    ))}
                  </div>
                  <p class="wishlist-item__note mt-2">
                    Listed does not always mean eligible. Your collection preferences, channel policy
                    and Bot availability are applied in the draw room.
                  </p>
                </div>
              ) : (
                <p class="wishlist-item__note mt-3">
                  No active capsule currently lists this target. Owning or trading for it remains a
                  legitimate path.
                </p>
              )}

              <div class="wishlist-item__foot">
                <p class="wishlist-item__note">The exact finish is saved with this wish.</p>
                <WishlistRemoveButton client:load cardId={row.wish.card_id} name={row.wish.name} />
              </div>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}
</PlayerLayout>
