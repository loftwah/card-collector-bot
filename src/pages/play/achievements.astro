---
import PlayerLayout from "../../layouts/PlayerLayout.astro";
import AchievementBadge from "../../components/player/AchievementBadge.astro";
import ShareLinkButton from "../../components/player/ShareLinkButton";
import MemberHeader from "../../components/player/MemberHeader.astro";
import { pageContext } from "../../server/page";
import { listAchievements } from "../../server/modules/achievements";
import { formatDate } from "../../lib/utils";

const ctx = await pageContext(Astro.request);
const user = ctx.user!;
const items = await listAchievements(ctx, user.id);

const labels: Record<string, string> = {
  milestone: "Milestone",
  finish: "Finish craft",
  explore: "Exploration",
  collection: "Collection badge",
  community: "Community",
};
const labelFor = (category: string) => labels[category] ?? category;

const earnedAll = items
  .filter((item) => item.state === "earned")
  .sort((a, b) => (b.earned_at ?? "").localeCompare(a.earned_at ?? ""));
const earnedPreview = earnedAll.slice(0, 6);
const inProgressAll = items
  .filter((item) => item.state !== "earned" && item.progress > 0)
  .sort(
    (a, b) =>
      b.progress / Math.max(1, b.target) - a.progress / Math.max(1, a.target) ||
      a.name.localeCompare(b.name),
  );
const inProgress = inProgressAll.slice(0, 6);

const requestedFamily = Astro.url.searchParams.get("family") ?? "all";
const requestedState = Astro.url.searchParams.get("state") ?? "all";
const q = (Astro.url.searchParams.get("q") ?? "").trim();
const requestedPage = Math.max(1, Math.floor(Number(Astro.url.searchParams.get("page") ?? 1) || 1));

const families = ["all", ...new Set(items.map((item) => item.category))];
const familyCounts = new Map(
  families.map((family) => [
    family,
    family === "all" ? items.length : items.filter((item) => item.category === family).length,
  ]),
);

const matchesState = (item: (typeof items)[number]) => {
  if (requestedState === "earned") return item.state === "earned";
  if (requestedState === "progress") return item.state !== "earned" && item.progress > 0;
  if (requestedState === "not-started") return item.state !== "earned" && item.progress === 0;
  return true;
};
const searchable = (item: (typeof items)[number]) =>
  `${item.name} ${item.description} ${item.collection_name ?? ""} ${labelFor(item.category)}`.toLowerCase();

const filtered = items
  .filter((item) => requestedFamily === "all" || item.category === requestedFamily)
  .filter(matchesState)
  .filter((item) => (q ? searchable(item).includes(q.toLowerCase()) : true));

const sorted = [...filtered].sort((a, b) => {
  const earnedOrder = Number(b.state === "earned") - Number(a.state === "earned");
  if (earnedOrder !== 0) return earnedOrder;
  return (
    b.progress / Math.max(1, b.target) - a.progress / Math.max(1, a.target) ||
    a.name.localeCompare(b.name)
  );
});

const PAGE_SIZE = 20;
const pageCount = Math.max(1, Math.ceil(sorted.length / PAGE_SIZE));
const currentPage = Math.min(requestedPage, pageCount);
const pageItems = sorted.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);

function pageHref(page: number) {
  const params = new URLSearchParams();
  if (q) params.set("q", q);
  if (requestedFamily !== "all") params.set("family", requestedFamily);
  if (requestedState !== "all") params.set("state", requestedState);
  if (page > 1) params.set("page", String(page));
  const query = params.toString();
  return `/play/achievements${query ? `?${query}` : ""}`;
}

const earnedHref = "/play/achievements?state=earned";
---

<PlayerLayout title="Achievements · Foilbury">
  <MemberHeader
    title="Achievements"
    lede="Badges you earned by collecting. Each reward is credited once, and a badge is never taken away."
  >
    <p class="member-head__note">
      {inProgressAll.length
        ? `${inProgressAll.length} badge${inProgressAll.length === 1 ? "" : "s"} partly earned.`
        : "No badge is partly earned yet."}
    </p>
    <dl slot="aside" class="member-stats">
      <div class="member-stat">
        <dt>Earned</dt>
        <dd>{earnedAll.length} <span>/ {items.length}</span></dd>
      </div>
      <div class="member-stat">
        <dt>Still to earn</dt>
        <dd>{items.length - earnedAll.length}</dd>
      </div>
    </dl>
  </MemberHeader>

  <section class="member-section">
    <div class="member-section__head">
      <div>
        <h2 class="member-section__title">Earned badges</h2>
        <p class="member-section__lede">Most recent first. The source names the collection where a badge came from.</p>
      </div>
      {earnedAll.length > earnedPreview.length ? (
        <a class="btn btn-secondary btn-sm" href={earnedHref}>All earned</a>
      ) : null}
    </div>

    {earnedPreview.length ? (
      <div class="achievement-grid">
        {earnedPreview.map((item) => (
          <article class="achievement-item">
            <AchievementBadge
              artKey={item.art_key}
              name={item.name}
              category={item.category}
              earned
              size={52}
              emblemUrl={item.collection_logo_url}
            />
            <div class="achievement-item__body">
              <h3 class="achievement-item__name">{item.name}</h3>
              <p class="achievement-item__meta">{item.collection_name ?? labelFor(item.category)}</p>
              <p class="achievement-item__meta">
                Earned {item.earned_at ? formatDate(item.earned_at) : "today"}
                {item.reward_amount ? ` · +${item.reward_amount} Foil` : ""}
              </p>
              {item.unlock_id ? (
                <div class="achievement-item__footer">
                  <ShareLinkButton
                    client:load
                    kind="achievement"
                    targetId={item.unlock_id}
                    label="Share badge"
                  />
                </div>
              ) : null}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="member-empty">
        <div>
          <h2>Your first badge is one capsule away.</h2>
          <p>Open a capsule, inspect a card or complete a daily mission to begin.</p>
          <div class="member-empty__actions">
            <a class="btn btn-primary" href="/play/draw">Open a capsule</a>
            <a class="btn btn-secondary" href="/play/missions">See missions</a>
          </div>
        </div>
      </div>
    )}
  </section>

  <section class="member-section">
    <div class="member-section__head">
      <div>
        <h2 class="member-section__title">Closest next</h2>
        <p class="member-section__lede">The six badges nearest completion across every collection in this Bot.</p>
      </div>
      <a class="btn btn-secondary btn-sm" href="/play/draw">Open a capsule</a>
    </div>

    {inProgress.length ? (
      <div class="achievement-grid">
        {inProgress.map((item) => {
          const pct = Math.min(100, Math.round((item.progress / Math.max(1, item.target)) * 100));
          return (
            <article class="achievement-item">
              <AchievementBadge
                artKey={item.art_key}
                name={item.name}
                category={item.category}
                earned={false}
                size={52}
              />
              <div class="achievement-item__body">
                <h3 class="achievement-item__name">{item.name}</h3>
                <p class="achievement-item__meta">{item.collection_name ?? labelFor(item.category)}</p>
                <p class="achievement-item__meta">{item.description}</p>
                <div class="mt-2 flex items-center gap-2">
                  <div
                    class="member-progress w-full"
                    role="progressbar"
                    aria-valuemin={0}
                    aria-valuemax={item.target}
                    aria-valuenow={item.progress}
                    aria-label={`${item.name} progress`}
                  >
                    <span style={`width:${pct}%`}></span>
                  </div>
                  <span class="achievement-item__meta whitespace-nowrap">
                    {Math.min(item.progress, item.target)}/{item.target}
                  </span>
                </div>
                <div class="achievement-item__footer">
                  <span class="achievement-item__reward">
                    {item.reward_amount ? `✦ ${item.reward_amount}` : "Commemorative"}
                  </span>
                  {item.collection_slug ? (
                    <a
                      class="btn btn-secondary btn-sm"
                      href={`/play/collection?collection=${item.collection_slug}`}
                    >
                      Open collection
                    </a>
                  ) : null}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <p class="member-section__lede">No badge is partly earned yet. Open a capsule to start the next one.</p>
    )}
  </section>

  <section class="member-section">
    <div class="member-section__head">
      <div>
        <h2 class="member-section__title">The full cabinet</h2>
        <p class="member-section__lede">
          Filter by family or state, or search by badge, collection or description.
        </p>
      </div>
      <p class="member-count">
        {filtered.length} {filtered.length === 1 ? "badge" : "badges"} in this view
      </p>
    </div>

    <form method="get" action="/play/achievements" class="member-toolbar">
      <label class="field">
        <span class="label">Search badges</span>
        <input
          class="input"
          type="search"
          name="q"
          value={q}
          placeholder="Badge, collection or description"
        />
      </label>
      <label class="field">
        <span class="label">Family</span>
        <select class="select" name="family">
          {families.map((family) => (
            <option value={family} selected={requestedFamily === family}>
              {family === "all" ? `All families (${familyCounts.get("all") ?? 0})` : `${labelFor(family)} (${familyCounts.get(family) ?? 0})`}
            </option>
          ))}
        </select>
      </label>
      <label class="field">
        <span class="label">State</span>
        <select class="select" name="state">
          <option value="all" selected={requestedState === "all"}>All states</option>
          <option value="earned" selected={requestedState === "earned"}>Earned</option>
          <option value="progress" selected={requestedState === "progress"}>In progress</option>
          <option value="not-started" selected={requestedState === "not-started"}>Not started</option>
        </select>
      </label>
      <div class="flex items-end gap-2">
        <button class="btn btn-primary btn-sm" type="submit">Apply</button>
        <a class="btn btn-ghost btn-sm" href="/play/achievements">Reset</a>
      </div>
    </form>

    {pageItems.length ? (
      <div class="member-panel mt-4">
        <ul class="member-list">
          {pageItems.map((item) => (
            <li class="member-row member-row--top">
              <div class="achievement-line">
                <AchievementBadge
                  artKey={item.art_key}
                  name={item.name}
                  category={item.category}
                  earned={item.state === "earned"}
                  size={40}
                  emblemUrl={item.collection_logo_url}
                />
                <div class="achievement-line__body">
                  <p class="achievement-line__name">{item.name}</p>
                  <p class="achievement-line__description">{item.description}</p>
                  <p class="achievement-line__meta">
                    {item.collection_name ?? labelFor(item.category)}
                    {item.state === "earned"
                      ? ` · earned ${item.earned_at ? formatDate(item.earned_at) : ""}`
                      : ` · ${Math.min(item.progress, item.target)}/${item.target}`}
                    {item.reward_amount ? ` · ✦ ${item.reward_amount}` : ""}
                  </p>
                </div>
              </div>
              <div class="member-row__actions">
                {item.state === "earned" && item.unlock_id ? (
                  <ShareLinkButton
                    client:load
                    kind="achievement"
                    targetId={item.unlock_id}
                    label="Share"
                  />
                ) : item.collection_slug ? (
                  <a
                    class="btn btn-secondary btn-sm"
                    href={`/play/collection?collection=${item.collection_slug}`}
                  >
                    Open collection
                  </a>
                ) : null}
              </div>
            </li>
          ))}
        </ul>
      </div>
    ) : (
      <div class="member-empty mt-4">
        <div>
          <h2>No badges match.</h2>
          <p>Try a different family or state, or clear the search.</p>
          <div class="member-empty__actions">
            <a class="btn btn-secondary" href="/play/achievements">Clear filters</a>
          </div>
        </div>
      </div>
    )}

    {pageCount > 1 ? (
      <nav class="member-pager mt-4 border-t border-[var(--line)]" aria-label="Achievement pages">
        <a
          class:list={["btn btn-secondary btn-sm", currentPage === 1 && "pointer-events-none opacity-40"]}
          href={pageHref(currentPage - 1)}
          aria-disabled={currentPage === 1}
        >
          Previous
        </a>
        <p class="member-pager__label">Page {currentPage} of {pageCount}</p>
        <a
          class:list={["btn btn-secondary btn-sm", currentPage === pageCount && "pointer-events-none opacity-40"]}
          href={pageHref(currentPage + 1)}
          aria-disabled={currentPage === pageCount}
        >
          Next
        </a>
      </nav>
    ) : null}
  </section>
</PlayerLayout>
