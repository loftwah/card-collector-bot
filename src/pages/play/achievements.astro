---
import PlayerLayout from "../../layouts/PlayerLayout.astro";
import AchievementBadge from "../../components/player/AchievementBadge.astro";
import { pageContext } from "../../server/page";
import { listAchievements } from "../../server/modules/achievements";
import { getWalletSummary } from "../../server/modules/wallet";
import { formatDual } from "../../lib/utils";

const ctx = await pageContext(Astro.request);
const user = ctx.user!;
const [items, wallet] = await Promise.all([listAchievements(ctx, user.id), getWalletSummary(ctx.db, ctx.tenant.id, user.id, 1)]);
const earned = items.filter((item) => item.state === "earned");
const inProgress = items
  .filter((item) => item.state !== "earned")
  .sort((a, b) => b.progress / Math.max(1, b.target) - a.progress / Math.max(1, a.target))
  .slice(0, 6);
const byCategory = new Map<string, typeof items>();
for (const item of items) {
  if (!byCategory.has(item.category)) byCategory.set(item.category, []);
  byCategory.get(item.category)!.push(item);
}
const labels: Record<string, string> = {
  milestone: "Milestones",
  finish: "Finish craft",
  explore: "Exploration",
  collection: "Collection badges",
  community: "Community",
};
---
<PlayerLayout title="Achievements · Foilbury">
  <section class="border-b border-[var(--line)] pb-7">
    <p class="eyebrow">Your badges</p>
    <div class="mt-3 flex flex-wrap items-end justify-between gap-5">
      <div>
        <h2 class="display text-[clamp(2.8rem,7vw,5.4rem)]">Little proofs of time well spent.</h2>
        <p class="mt-4 max-w-2xl text-[var(--muted)]">Each badge is tied to something you actually did: a first card, a finish you hunted down, a world you explored. Rewards are credited once and stay yours even when a collection grows.</p>
      </div>
      <div class="text-right">
        <p class="eyebrow">Earned</p>
        <p class="display-sm mt-1 text-5xl">{earned.length}<span class="text-2xl text-[var(--muted)]">/{items.length}</span></p>
        <p class="mt-1 font-mono text-[0.58rem] uppercase tracking-[0.1em] text-[var(--muted)]">✦ {wallet.balance} Foil balance</p>
      </div>
    </div>
  </section>

  <section class="mt-9">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <h3 class="display-sm text-3xl">Earned badges</h3>
      <p class="font-mono text-[0.6rem] uppercase tracking-[0.1em] text-[var(--muted)]">{earned.length ? "Your cabinet remembers" : "Your first badge is one capsule away"}</p>
    </div>
    {earned.length ? (
      <div class="mt-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {earned.map((item) => (
          <article class="achievement-card is-earned">
            <AchievementBadge artKey={item.art_key} name={item.name} category={item.category} earned />
            <div class="min-w-0">
              <p class="font-mono text-[0.54rem] uppercase tracking-[0.16em] text-[var(--brass)]">{labels[item.category] ?? item.category}</p>
              <h4 class="display-sm mt-1 text-2xl leading-tight">{item.name}</h4>
              <p class="mt-1 text-sm text-[var(--muted)]">{item.description}</p>
              <p class="mt-3 font-mono text-[0.56rem] uppercase tracking-[0.08em] text-[var(--green)]">
                Earned {item.earned_at ? formatDual(item.earned_at) : ""}{item.reward_amount ? ` · +${item.reward_amount} Foil` : ""}
              </p>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty mt-5"><div><p class="display-sm text-2xl">Nothing pinned yet.</p><p class="mt-2 text-sm">Open your first capsule, then come back. The first badge is called <strong>The first one is always special</strong>.</p></div></div>
    )}
  </section>

  <section class="mt-12">
    <div class="flex flex-wrap items-end justify-between gap-3 border-b border-[var(--line)] pb-4">
      <div>
        <h3 class="display-sm text-3xl">Closest next</h3>
        <p class="mt-1 text-sm text-[var(--muted)]">Six nearest milestones. The full library is grouped below; a badge once earned is never taken away.</p>
      </div>
      <a class="btn btn-secondary btn-sm" href="/play/draw">Open a capsule</a>
    </div>
    <div class="mt-5 grid gap-4 md:grid-cols-2">
      {inProgress.map((item) => {
        const pct = Math.min(100, Math.round((item.progress / Math.max(1, item.target)) * 100));
        return (
          <article class="achievement-card">
            <AchievementBadge artKey={item.art_key} name={item.name} category={item.category} earned={false} />
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h4 class="display-sm text-2xl leading-tight">{item.name}</h4>
                <span class="font-mono text-[0.58rem] uppercase tracking-[0.1em] text-[var(--muted)]">{Math.min(item.progress, item.target)}/{item.target}</span>
              </div>
              <p class="mt-1 text-sm text-[var(--muted)]">{item.description}</p>
              <div class="mt-3 h-1.5 bg-[var(--paper-3)]" role="progressbar" aria-valuenow={item.progress} aria-valuemin="0" aria-valuemax={item.target} aria-label={`${item.name} progress`}>
                <div class="h-full bg-[var(--brass)]" style={`width:${pct}%`}></div>
              </div>
              <p class="mt-2 font-mono text-[0.54rem] uppercase tracking-[0.08em] text-[var(--muted)]">{item.reward_amount ? `Reward ✦ ${item.reward_amount}` : "Commemorative badge"}{item.visibility === "member" ? " · member album" : ""}</p>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  {[...byCategory.entries()].map(([category, grouped]) => (
    <details class="mt-8 border-t border-[var(--line)] pt-5" open={category === "milestone" || category === "finish"}>
      <summary class="flex cursor-pointer list-none items-baseline justify-between gap-3">
        <h3 class="display-sm text-2xl">{labels[category] ?? category}</h3>
        <p class="font-mono text-[0.56rem] uppercase tracking-[0.1em] text-[var(--muted)]">{grouped.filter((item) => item.state === "earned").length}/{grouped.length} · show</p>
      </summary>
      <div class="mt-4 flex flex-wrap gap-3">
        {grouped.map((item) => (
          <div class="flex items-center gap-2 border border-[var(--line)] px-3 py-2">
            <AchievementBadge artKey={item.art_key} name={item.name} category={item.category} earned={item.state === "earned"} size={34} />
            <div>
              <p class="text-sm font-semibold">{item.name}</p>
              <p class="font-mono text-[0.52rem] uppercase tracking-[0.08em] text-[var(--muted)]">{item.state === "earned" ? "Earned" : `${item.progress}/${item.target}`}</p>
            </div>
          </div>
        ))}
      </div>
    </details>
  ))}
</PlayerLayout>
