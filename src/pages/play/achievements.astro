---
import PlayerLayout from "../../layouts/PlayerLayout.astro";
import AchievementBadge from "../../components/player/AchievementBadge.astro";
import ShareLinkButton from "../../components/player/ShareLinkButton";
import { pageContext } from "../../server/page";
import { listAchievements } from "../../server/modules/achievements";
import { getWalletSummary } from "../../server/modules/wallet";
import { formatDual } from "../../lib/utils";

const ctx = await pageContext(Astro.request);
const user = ctx.user!;
const [items, wallet] = await Promise.all([
  listAchievements(ctx, user.id),
  getWalletSummary(ctx.db, ctx.tenant.id, user.id, 1),
]);
const earned = items.filter((item) => item.state === "earned");
const inProgress = items
  .filter((item) => item.state !== "earned")
  .sort((a, b) => b.progress / Math.max(1, b.target) - a.progress / Math.max(1, a.target))
  .slice(0, 6);
const requestedFamily = Astro.url.searchParams.get("family") ?? "all";
const requestedPage = Math.max(1, Math.floor(Number(Astro.url.searchParams.get("page") ?? 1) || 1));
const families = ["all", ...new Set(items.map((item) => item.category))];
const familyItems =
  requestedFamily === "all" ? items : items.filter((item) => item.category === requestedFamily);
const PAGE_SIZE = 24;
const pageCount = Math.max(1, Math.ceil(familyItems.length / PAGE_SIZE));
const currentPage = Math.min(requestedPage, pageCount);
const pageItems = [...familyItems]
  .sort((a, b) => {
    const earnedOrder = Number(b.state === "earned") - Number(a.state === "earned");
    if (earnedOrder !== 0) return earnedOrder;
    return b.progress / Math.max(1, b.target) - a.progress / Math.max(1, a.target);
  })
  .slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);
const familyHref = (family: string) =>
  `/play/achievements${family === "all" ? "" : `?family=${family}`}`;
const pageHref = (page: number) => {
  const params = new URLSearchParams();
  if (requestedFamily !== "all") params.set("family", requestedFamily);
  if (page > 1) params.set("page", String(page));
  return `/play/achievements${params.size ? `?${params.toString()}` : ""}`;
};
const labels: Record<string, string> = {
  milestone: "Milestones",
  finish: "Finish craft",
  explore: "Exploration",
  collection: "Collection badges",
  community: "Community",
};
---

<PlayerLayout title="Achievements · Foilbury">
  <section class="border-b border-[var(--line)] pb-7">
    <p class="eyebrow">Your badges</p>
    <div class="mt-3 flex flex-wrap items-end justify-between gap-5">
      <div>
        <h2 class="page-title">Little proofs of time well spent.</h2>
        <p class="mt-4 max-w-2xl text-[var(--muted)]">
          Each badge is tied to something you actually did: a first card, a finish you hunted down,
          a world you explored. Rewards are credited once and stay yours even when a collection
          grows.
        </p>
      </div>
      <div class="text-right">
        <p class="eyebrow">Earned</p>
        <p class="display-sm mt-1 text-5xl">
          {earned.length}
          <span class="text-2xl text-[var(--muted)]">/{items.length}</span>
        </p>
        <p class="mt-1 font-mono text-[0.58rem] uppercase tracking-[0.1em] text-[var(--muted)]">
          ✦ {wallet.balance} Foil balance
        </p>
      </div>
    </div>
  </section>

  <section class="mt-9">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <h3 class="display-sm text-3xl">Earned badges</h3>
      <p class="font-mono text-[0.6rem] uppercase tracking-[0.1em] text-[var(--muted)]">
        {earned.length ? "Your cabinet remembers" : "Your first badge is one capsule away"}
      </p>
    </div>
    {earned.length ? (
      <div class="mt-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {earned.map((item) => (
          <article class="achievement-card is-earned">
            <AchievementBadge
              artKey={item.art_key}
              name={item.name}
              category={item.category}
              earned
              emblemUrl={item.collection_logo_url}
            />
            <div class="min-w-0">
              <p class="font-mono text-[0.54rem] uppercase tracking-[0.16em] text-[var(--brass)]">
                {labels[item.category] ?? item.category}
              </p>
              <h4 class="display-sm mt-1 text-2xl leading-tight">{item.name}</h4>
              <p class="mt-1 text-sm text-[var(--muted)]">{item.description}</p>
              <p class="mt-3 font-mono text-[0.56rem] uppercase tracking-[0.08em] text-[var(--green)]">
                Earned {item.earned_at ? formatDual(item.earned_at) : ""}
                {item.reward_amount ? ` · +${item.reward_amount} Foil` : ""}
              </p>
              {item.unlock_id ? (
                <div class="mt-2">
                  <ShareLinkButton
                    client:load
                    kind="achievement"
                    targetId={item.unlock_id}
                    label="Share badge"
                  />
                </div>
              ) : null}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty mt-5">
        <div>
          <p class="display-sm text-2xl">Nothing pinned yet.</p>
          <p class="mt-2 text-sm">
            Open your first capsule, then come back. The first badge is called{" "}
            <strong>The first one is always special</strong>.
          </p>
        </div>
      </div>
    )}
  </section>

  <section class="mt-12">
    <div class="flex flex-wrap items-end justify-between gap-3 border-b border-[var(--line)] pb-4">
      <div>
        <h3 class="display-sm text-3xl">Closest next</h3>
        <p class="mt-1 text-sm text-[var(--muted)]">
          Six nearest milestones. The full library is grouped below; a badge once earned is never
          taken away.
        </p>
      </div>
      <a class="btn btn-secondary btn-sm" href="/play/draw">
        Open a capsule
      </a>
    </div>
    <div class="mt-5 grid gap-4 md:grid-cols-2">
      {inProgress.map((item) => {
        const pct = Math.min(100, Math.round((item.progress / Math.max(1, item.target)) * 100));
        return (
          <article class="achievement-card">
            <AchievementBadge
              artKey={item.art_key}
              name={item.name}
              category={item.category}
              earned={false}
            />
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h4 class="display-sm text-2xl leading-tight">{item.name}</h4>
                <span class="font-mono text-[0.58rem] uppercase tracking-[0.1em] text-[var(--muted)]">
                  {Math.min(item.progress, item.target)}/{item.target}
                </span>
              </div>
              <p class="mt-1 text-sm text-[var(--muted)]">{item.description}</p>
              <div
                class="mt-3 h-1.5 bg-[var(--paper-3)]"
                role="progressbar"
                aria-valuenow={item.progress}
                aria-valuemin="0"
                aria-valuemax={item.target}
                aria-label={`${item.name} progress`}
              >
                <div class="h-full bg-[var(--brass)]" style={`width:${pct}%`}></div>
              </div>
              <p class="mt-2 font-mono text-[0.54rem] uppercase tracking-[0.08em] text-[var(--muted)]">
                {item.reward_amount ? `Reward ✦ ${item.reward_amount}` : "Commemorative badge"}
                {item.visibility === "member" ? " · member album" : ""}
              </p>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="mt-8">
    <div class="panel-head">
      <div>
        <h3 class="panel-title">The full cabinet</h3>
        <p class="mt-1 text-sm text-[var(--muted)]">
          Every badge, grouped into a deliberate page rather than one endless wall.
        </p>
      </div>
      <p class="font-mono text-[0.58rem] uppercase tracking-[0.1em] text-[var(--muted)]">
        {familyItems.length} in this view
      </p>
    </div>
    <div class="mt-4 flex flex-wrap gap-1.5">
      {families.map((family) => (
        <a
          href={familyHref(family)}
          class:list={[
            "chip",
            requestedFamily === family && "!border-[var(--signal)] !text-[var(--signal)]",
          ]}
          aria-current={requestedFamily === family ? "page" : undefined}
        >
          {family === "all" ? "All families" : (labels[family] ?? family)}
        </a>
      ))}
    </div>

    <div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
      {pageItems.map((item) => {
        const pct = Math.min(100, Math.round((item.progress / Math.max(1, item.target)) * 100));
        return (
          <article class="achievement-card">
            <AchievementBadge
              artKey={item.art_key}
              name={item.name}
              category={item.category}
              earned={item.state === "earned"}
              size={38}
              emblemUrl={item.collection_logo_url}
            />
            <div class="min-w-0 flex-1">
              <p class="font-mono text-[0.5rem] uppercase tracking-[0.14em] text-[var(--muted)]">
                {labels[item.category] ?? item.category}
              </p>
              <p class="text-sm font-semibold leading-tight">{item.name}</p>
              <p class="mt-0.5 text-xs text-[var(--muted)]">{item.description}</p>
              {item.state === "earned" ? (
                <p class="mt-1.5 font-mono text-[0.52rem] uppercase tracking-[0.08em] text-[var(--green)]">
                  Earned{item.earned_at ? ` ${formatDual(item.earned_at)}` : ""}
                </p>
              ) : (
                <div class="mt-1.5">
                  <div class="h-1 bg-[var(--paper-3)]">
                    <div class="h-full bg-[var(--signal)]" style={`width:${pct}%`}></div>
                  </div>
                  <p class="mt-1 font-mono text-[0.5rem] uppercase tracking-[0.08em] text-[var(--muted)]">
                    {item.progress}/{item.target}
                    {item.reward_amount ? ` · ✦ ${item.reward_amount}` : ""}
                  </p>
                </div>
              )}
            </div>
          </article>
        );
      })}
    </div>

    {pageCount > 1 ? (
      <nav
        class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-[var(--line)] pt-4"
        aria-label="Achievement pages"
      >
        <a
          class:list={[
            "btn btn-secondary btn-sm",
            currentPage === 1 && "pointer-events-none opacity-40",
          ]}
          href={pageHref(currentPage - 1)}
          aria-disabled={currentPage === 1}
        >
          Previous
        </a>
        <p class="font-mono text-[0.58rem] uppercase tracking-[0.1em] text-[var(--muted)]">
          Page {currentPage} of {pageCount}
        </p>
        <a
          class:list={[
            "btn btn-secondary btn-sm",
            currentPage === pageCount && "pointer-events-none opacity-40",
          ]}
          href={pageHref(currentPage + 1)}
          aria-disabled={currentPage === pageCount}
        >
          Next
        </a>
      </nav>
    ) : null}
  </section>
</PlayerLayout>
