---
import PlayerLayout from "../../layouts/PlayerLayout.astro";
import CollectionBrowser from "../../components/player/CollectionBrowser";
import SharePanel from "../../components/player/SharePanel";
import { pageContext } from "../../server/page";
import { countInventory, getInventory } from "../../server/modules/collection";
import { listSets } from "../../server/modules/catalogue";
import { getWalletSummary } from "../../server/modules/wallet";
import {
  collectionBinder,
  collectionProgress,
  listCollections,
} from "../../server/modules/collections";

const ctx = await pageContext(Astro.request);
const user = ctx.user!;
const initialCollection = Astro.url.searchParams.get("collection") ?? "";
const initialSearch = (Astro.url.searchParams.get("search") ?? "").trim();
const initialFavourite = Astro.url.searchParams.get("favourite") === "true";
const initialSet = Astro.url.searchParams.get("set") ?? "";
const inventoryFilter = {
  search: initialSearch || undefined,
  favourite: initialFavourite || undefined,
  setSlug: initialSet || undefined,
  collection: initialCollection || undefined,
};
const [items, totalItems, sets, wallet, collections] = await Promise.all([
  getInventory(ctx, { ...inventoryFilter, limit: 24 }),
  countInventory(ctx, inventoryFilter),
  listSets(ctx, user.id),
  getWalletSummary(ctx.db, ctx.tenant.id, user.id, 1),
  listCollections(ctx),
]);
const publishedSets = sets.filter((set) => set.status === "published");
const selected = initialCollection
  ? (collections.find((collection) => collection.slug === initialCollection) ?? null)
  : null;
const [progress, binder] = selected
  ? await Promise.all([collectionProgress(ctx, selected.id), collectionBinder(ctx, selected.id)])
  : [null, null];
const finishLabels: Record<string, string> = {
  plain: "Plain",
  silver: "Silver",
  gold: "Gold",
  holographic: "Holographic",
};
const finishOrder = ["plain", "silver", "gold", "holographic"];
const finishStats = progress?.finishes ?? {};
const nextFinish =
  [...finishOrder]
    .map((key) => ({ key, ...(finishStats[key] ?? { owned: 0, total: 0 }) }))
    .filter((entry) => entry.total > 0 && entry.owned < entry.total)
    .sort((a, b) => b.owned / Math.max(1, b.total) - a.owned / Math.max(1, a.total))[0] ?? null;
---

<PlayerLayout title="Collection · Foilbury">
  <div class="member-collection">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="eyebrow">Private collection</p>
      <h2 class="display-sm mt-1 text-4xl">Your drawers.</h2>
      <p class="mt-2 max-w-xl text-sm text-[var(--muted)]">
        Search, filter and favourite the cards you have drawn. Reserved cards are held for an open
        trade and cannot be spent twice.
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <div class="text-right">
        <p class="eyebrow">Foil</p>
        <p class="font-mono text-2xl text-[var(--brass)]">✦ {wallet.balance}</p>
      </div>
      <a class="btn btn-primary btn-sm" href="/play/draw">
        Draw a card
      </a>
    </div>
  </div>
  <div class="mt-7">
    {selected && progress && binder ? (
      <section class="member-collection__section mb-8 border border-[var(--line)] bg-[var(--paper-2)]/35">
        <div class="member-collection__details grid gap-5 border-b border-[var(--line)] p-5 lg:grid-cols-[1fr_auto] lg:items-start">
          <div class="flex flex-wrap items-start gap-4">
            {selected.logo_url ? (
              <img
                src={selected.logo_url}
                alt=""
                class="h-16 w-16 object-contain"
                width="64"
                height="64"
              />
            ) : (
              <span class="grid h-16 w-16 place-items-center bg-[var(--ink)] font-display text-2xl text-[var(--paper)]">
                {selected.name.charAt(0)}
              </span>
            )}
            <div class="min-w-0">
              <h3 class="display-sm text-3xl uppercase">{selected.name}</h3>
              <p class="mt-1 max-w-xl text-sm text-[var(--muted)]">{selected.description}</p>
              {ctx.csrfToken ? <form method="post" action={`/play/world/${encodeURIComponent(selected.id)}/explore`} class="mt-3">
                <input type="hidden" name="csrf" value={ctx.csrfToken} />
                <button type="submit" class="btn btn-secondary btn-sm">Record world visit</button>
                <p class="mt-1 text-xs text-[var(--muted)]">After looking around, record this visit for today's mission.</p>
              </form> : null}
              <p class="mt-2 font-mono text-[0.6rem] uppercase tracking-[0.1em] text-[var(--muted)]">
                {selected.view_audience === "public"
                  ? "Public showcase"
                  : selected.view_audience === "private"
                    ? "Private album"
                    : "Member album"}{" "}
                · {progress.total_cards} subjects · {progress.total_variants} core variants
              </p>
            </div>
          </div>
          <div class="member-collection__stats grid grid-cols-3 gap-3 text-center">
            <div>
              <p class="studio-stat__label">Subjects</p>
              <p class="display-sm text-2xl">
                {progress.owned_cards}/{progress.total_cards}
              </p>
            </div>
            <div>
              <p class="studio-stat__label">Copies</p>
              <p class="display-sm text-2xl">{progress.owned_copies}</p>
            </div>
            <div>
              <p class="studio-stat__label">Duplicates</p>
              <p class="display-sm text-2xl">{progress.duplicates}</p>
            </div>
          </div>
        </div>
        <div class="member-collection__details grid gap-5 p-5 lg:grid-cols-[1fr_1fr]">
          <div>
            <div class="flex items-end justify-between gap-3">
              <p class="studio-stat__label">Core finish progress</p>
              <span class="font-mono text-[0.58rem] uppercase tracking-[0.1em] text-[var(--muted)]">
                current ownership
              </span>
            </div>
            <div class="mt-3 grid gap-2">
              {finishOrder.map((key) => {
                const stat = finishStats[key] ?? { owned: 0, total: 0 };
                const pct = stat.total ? Math.round((stat.owned / stat.total) * 100) : 0;
                return (
                  <div>
                    <div class="flex items-baseline justify-between gap-3 text-sm">
                      <span class="font-medium">{finishLabels[key]}</span>
                      <span class="font-mono text-[0.62rem] text-[var(--muted)]">
                        {stat.owned}/{stat.total}{" "}
                        {stat.total && stat.owned >= stat.total ? "· mastered" : ""}
                      </span>
                    </div>
                    <div
                      class="mt-1 h-2 bg-[var(--paper-3)]"
                      role="progressbar"
                      aria-valuemin="0"
                      aria-valuemax={stat.total}
                      aria-valuenow={stat.owned}
                      aria-label={`${finishLabels[key]} progress`}
                    >
                      <div class="h-full bg-[var(--signal)]" style={`width:${pct}%`}></div>
                    </div>
                  </div>
                );
              })}
            </div>
            {nextFinish ? (
              <p class="mt-3 text-xs text-[var(--muted)]">
                Next target:{" "}
                <strong>
                  {finishLabels[nextFinish.key]} {nextFinish.owned}/{nextFinish.total}
                </strong>{" "}
                — {nextFinish.total - nextFinish.owned} missing in this world.
              </p>
            ) : (
              <p class="mt-3 text-xs green">
                Every published core finish is held. Finish mastery is complete for this world.
              </p>
            )}
          </div>
          <div>
            <div class="flex items-end justify-between gap-3">
              <p class="studio-stat__label">
                Binder · {binder.cards.filter((card) => card.owned).length}/{binder.total} filled
              </p>
              <a
                class="font-mono text-[0.58rem] uppercase tracking-[0.1em] underline underline-offset-4"
                href="/play/collections"
              >
                Change world
              </a>
            </div>
            <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4">
              {binder.cards.map((card) => (
                <a
                  href={
                    card.owned && card.instance_id
                      ? `/play/card/${card.instance_id}`
                      : `/play/draw?collection=${selected.slug}`
                  }
                  class:list={[
                    "group relative block border p-1 no-underline",
                    card.owned
                      ? "border-[var(--line-strong)] bg-[var(--paper)]"
                      : "border-dashed border-[var(--line)] bg-[var(--paper-3)]/40",
                  ]}
                  aria-label={
                    card.owned
                      ? `${card.name}, owned`
                      : `${card.name}, missing. Find an eligible capsule.`
                  }
                >
                  {card.owned && card.render_url ? (
                    <img
                      src={card.render_url}
                      alt=""
                      class="aspect-[5/7] w-full object-cover"
                      loading="lazy"
                      width="150"
                      height="210"
                    />
                  ) : (
                    <div class="grid aspect-[5/7] w-full place-items-center bg-[var(--ink)]/5">
                      <span class="px-1 text-center font-mono text-[0.5rem] uppercase tracking-[0.08em] text-[var(--muted)]">
                        {card.name}
                      </span>
                    </div>
                  )}
                  <p class="mt-1 truncate text-[0.62rem] font-semibold">{card.name}</p>
                  <p class="font-mono text-[0.48rem] uppercase tracking-[0.06em] text-[var(--muted)]">
                    {card.owned
                      ? `${card.copies} cop${card.copies === 1 ? "y" : "ies"}${card.finishes.length ? ` · ${card.finishes.length}/4 finishes` : ""}`
                      : "Missing"}
                  </p>
                </a>
              ))}
            </div>
          </div>
        </div>
        <div class="member-collection__details border-t border-[var(--line)] p-5">
          <SharePanel
            client:load
            kind="collection"
            targetId={selected.id}
            title={selected.name}
            description={`${progress.owned_cards}/${progress.total_cards} subjects · ${progress.owned_variants}/${progress.total_variants} core variants. The share is a labelled snapshot, not live inventory.`}
            frontUrl={selected.cover_url}
          />
        </div>
      </section>
    ) : null}
    <CollectionBrowser
      scopeKey={JSON.stringify([ctx.tenant.id, user.id])}
      client:load
      initialItems={items}
      initialTotal={totalItems}
      initialSearch={initialSearch}
      initialFavourite={initialFavourite}
      initialSet={initialSet}
      sets={publishedSets.map((set) => ({ slug: set.slug, name: set.name }))}
      collections={collections
        .filter((collection) => collection.enabled)
        .map((collection) => ({
          slug: collection.slug,
          name: collection.name,
          logo_url: collection.logo_url,
        }))}
      initialCollection={initialCollection}
    />
  </div>
  </div>
</PlayerLayout>
