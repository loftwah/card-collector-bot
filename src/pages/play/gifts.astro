---
import PlayerLayout from "../../layouts/PlayerLayout.astro";
import MemberHeader from "../../components/player/MemberHeader.astro";
import { pageContext } from "../../server/page";
import { listMyGiftReceipts } from "../../server/modules/admin-gifts";
import { formatDate } from "../../lib/utils";

const ctx = await pageContext(Astro.request);
const receipts = await listMyGiftReceipts(ctx);

const kindLabel = (kind: string) =>
  kind === "opening" ? "Opening gift" : kind === "card" ? "Card gift" : "Foil gift";
const foilReceived = receipts
  .filter((receipt) => receipt.kind === "foil")
  .reduce((sum, receipt) => sum + Number(receipt.amount || 0), 0);

const PAGE_SIZE = 12;
const requestedPage = Math.max(1, Math.floor(Number(Astro.url.searchParams.get("page") ?? 1) || 1));
const pageCount = Math.max(1, Math.ceil(receipts.length / PAGE_SIZE));
const currentPage = Math.min(requestedPage, pageCount);
const pageItems = receipts.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);

function pageHref(page: number) {
  return page > 1 ? `/play/gifts?page=${page}` : "/play/gifts";
}
---

<PlayerLayout title="Gifts · Foilbury">
  <MemberHeader
    title="Gifts"
    lede="Occasional thank-yous from the people who run this cabinet. Every gift is free and recorded once."
  >
    <p class="member-head__note">Gifts are occasional, not a grind.</p>
    <dl slot="aside" class="member-stats">
      <div class="member-stat">
        <dt>Received</dt>
        <dd>{receipts.length}</dd>
      </div>
      <div class="member-stat">
        <dt>Foil received</dt>
        <dd>✦ {foilReceived.toLocaleString("en-AU")}</dd>
      </div>
    </dl>
  </MemberHeader>

  <section class="member-section">
    {receipts.length === 0 ? (
      <div class="member-empty">
        <div>
          <h2>No gifts yet.</h2>
          <p>
            Gifts are occasional, not a grind. You can still earn Foil from the daily allowance,
            achievements and set completions.
          </p>
          <div class="member-empty__actions">
            <a class="btn btn-secondary" href="/play/achievements">See achievements</a>
            <a class="btn btn-primary" href="/play/draw">Open a capsule</a>
          </div>
        </div>
      </div>
    ) : (
      <>
        <div class="member-panel">
          <div class="member-panel__head">
            <div>
              <h2 class="member-panel__title">Gift receipts</h2>
              <p class="member-panel__note">Newest first. Each delivery is credited once.</p>
            </div>
            <p class="member-count">
              {receipts.length} {receipts.length === 1 ? "gift" : "gifts"}
            </p>
          </div>
          <ul class="member-list">
            {pageItems.map((receipt) => (
              <li class="member-row member-row--top">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="badge">{kindLabel(receipt.kind)}</span>
                    <h3 class="member-row__title">{receipt.description}</h3>
                  </div>
                  {receipt.message ? (
                    <blockquote class="mt-2 max-w-2xl text-sm italic text-[var(--ink)]">
                      “{receipt.message}”
                    </blockquote>
                  ) : null}
                  <p class="member-row__meta">
                    <time datetime={receipt.delivered_at} title={receipt.delivered_at}>
                      Delivered {formatDate(receipt.delivered_at)}
                    </time>
                  </p>
                </div>
                <div class="member-row__actions">
                  <span class="achievement-item__reward">
                    {receipt.amount ? `✦ ${receipt.amount}` : "Commemorative"}
                  </span>
                  <span class="badge">Delivered</span>
                </div>
              </li>
            ))}
          </ul>
        </div>

        {pageCount > 1 ? (
          <nav class="member-pager mt-4 border-t border-[var(--line)]" aria-label="Gift receipt pages">
            <a
              class:list={["btn btn-secondary btn-sm", currentPage === 1 && "pointer-events-none opacity-40"]}
              href={pageHref(currentPage - 1)}
              aria-disabled={currentPage === 1}
            >
              Previous
            </a>
            <p class="member-pager__label">Page {currentPage} of {pageCount}</p>
            <a
              class:list={["btn btn-secondary btn-sm", currentPage === pageCount && "pointer-events-none opacity-40"]}
              href={pageHref(currentPage + 1)}
              aria-disabled={currentPage === pageCount}
            >
              Next
            </a>
          </nav>
        ) : null}
      </>
    )}
  </section>
</PlayerLayout>
