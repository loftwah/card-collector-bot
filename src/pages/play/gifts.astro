---
import PlayerLayout from "../../layouts/PlayerLayout.astro";
import { pageContext } from "../../server/page";
import { listMyGiftReceipts } from "../../server/modules/admin-gifts";
import { getWalletSummary } from "../../server/modules/wallet";
import { formatDual } from "../../lib/utils";

const ctx = await pageContext(Astro.request);
const user = ctx.user!;
const [receipts, wallet] = await Promise.all([listMyGiftReceipts(ctx), getWalletSummary(ctx.db, ctx.tenant.id, user.id, 1)]);
---
<PlayerLayout title="Gifts · Foilbury">
  <section class="border-b border-[var(--line)] pb-7">
    <p class="eyebrow">From the cabinet</p>
    <div class="mt-3 flex flex-wrap items-end justify-between gap-5">
      <div>
        <h2 class="display text-[clamp(2.8rem,7vw,5.4rem)]">A note in the post.</h2>
        <p class="mt-4 max-w-2xl text-[var(--muted)]">Occasional thank-yous from the people who run this album. Every gift is free and recorded once. Notes appear when available.</p>
      </div>
      <div class="text-right">
        <p class="eyebrow">Foil balance</p>
        <p class="display-sm mt-1 text-4xl text-[var(--brass)]">✦ {wallet.balance}</p>
      </div>
    </div>
  </section>

  <section class="mt-8">
    {receipts.length ? (
      <div class="grid gap-4 md:grid-cols-2">
        {receipts.map((receipt) => (
          <article class="surface p-5">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="font-mono text-[0.56rem] uppercase tracking-[0.14em] text-[var(--brass)]">{receipt.kind === "opening" ? "Opening gift" : receipt.kind === "card" ? "Card gift" : "Foil gift"}</p>
                <h3 class="display-sm mt-1 text-2xl">{receipt.description}</h3>
              </div>
              <span class="badge">Delivered</span>
            </div>
            {receipt.message ? <p class="mt-3 border-l-2 border-[var(--brass)] pl-3 text-sm italic text-[var(--ink)]">“{receipt.message}”</p> : null}
            <dl class="mt-4 grid grid-cols-1 gap-3 border-t border-[var(--line)] pt-3 text-sm min-[480px]:grid-cols-2">
              <div><dt class="eyebrow">Delivered</dt><dd class="mt-1">{formatDual(receipt.delivered_at)}</dd></div>
              <div><dt class="eyebrow">Value</dt><dd class="mt-1 font-mono">{receipt.amount ? `✦ ${receipt.amount}` : "Commemorative"}</dd></div>
            </dl>
            {receipt.reason ? <p class="mt-3 text-xs text-[var(--muted)]">Reason recorded for administrators: {receipt.reason}.</p> : null}
            {receipt.kind === "card" && receipt.description === "Card gift" ? <p class="mt-3 text-sm"><a class="underline" href="/play/collection">View your collection</a></p> : null}
          </article>
        ))}
      </div>
    ) : (
      <div class="empty">
        <div>
          <p class="display-sm text-2xl">No gifts yet.</p>
          <p class="mt-2 max-w-md text-sm">Gifts are occasional, not a grind. You can still earn Foil from the daily allowance, achievements and set completions.</p>
          <div class="mt-4 flex justify-center gap-2"><a class="btn btn-secondary btn-sm" href="/play/achievements">See achievements</a><a class="btn btn-primary btn-sm" href="/play/draw">Open a capsule</a></div>
        </div>
      </div>
    )}
  </section>
</PlayerLayout>
