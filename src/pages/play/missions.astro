---
import PlayerLayout from "../../layouts/PlayerLayout.astro";
import DailyMissions from "../../components/player/DailyMissions";
import MemberHeader from "../../components/player/MemberHeader.astro";
import { pageContext } from "../../server/page";
import { getDailyMissions } from "../../server/modules/missions";

const ctx = await pageContext(Astro.request);
const state = await getDailyMissions(ctx);
---

<PlayerLayout title="Missions · Foilbury">
  <MemberHeader
    title="Missions"
    lede="Optional daily goals. They use the same wallet and ledger as everything else and never ask you to post, invite or spend."
  >
    <p class="member-head__note">Resets {state.reset_local}.</p>
  </MemberHeader>

  <div class="mt-6">
    <DailyMissions client:load initial={state} />
  </div>
</PlayerLayout>
