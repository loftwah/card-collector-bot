---
import PlayerLayout from "../../layouts/PlayerLayout.astro";
import SecurityPanel from "../../components/account/SecurityPanel";
import MemberHeader from "../../components/player/MemberHeader.astro";
import { pageContext } from "../../server/page";

const ctx = await pageContext(Astro.request);
if (!ctx.user) return Astro.redirect(`/login?next=${encodeURIComponent("/account/security")}`);
---

<PlayerLayout title="Account security · Foilbury">
  <MemberHeader
    title="Account security"
    lede="One Foilbury identity, several ways in. Discord and email get you to your collection; passkeys and an authenticator protect the actions that touch a Bot, its catalogue or its economy."
  >
    <p class="member-head__note">
      Sensitive mutations require a recent passkey, authenticator or Cloudflare Access proof, not just
      a signed-in cookie.
    </p>
    <div slot="aside" class="flex flex-wrap gap-2">
      <a class="btn btn-secondary btn-sm" href="/play/preferences">Collecting preferences</a>
      <a class="btn btn-ghost btn-sm" href="/play">Back to my library</a>
    </div>
  </MemberHeader>

  <div class="mt-6">
    <SecurityPanel client:load />
  </div>
</PlayerLayout>
