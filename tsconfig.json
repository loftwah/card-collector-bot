{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["@cloudflare/workers-types", "emdash/locals"],
    "resolveJsonModule": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [".astro/types.d.ts", "src/**/*", "*.config.*", "scripts/**/*.mjs"],
  "exclude": ["dist", "node_modules", "tests", "mcp"]
}
